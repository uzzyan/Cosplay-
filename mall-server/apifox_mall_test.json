{
  "apifoxProject": "1.0",
  "info": {
    "name": "Cosplay Mall 接口测试集",
    "description": "包含登录、商品、订单等核心业务接口，已配置登录后自动提取 Token 并存入环境变量。"
  },
  "apiCollection": [
    {
      "name": "1. 用户认证",
      "items": [
        {
          "name": "登录 (提取 Token)",
          "api": {
            "method": "POST",
            "path": "/login",
            "parameters": {
              "body": {
                "type": "json",
                "json": "{\n  \"username\": \"admin\",\n  \"password\": \"admin\"\n}"
              }
            },
            "commonScripts": {
              "postAction": "var jsonData = pm.response.json();\nif (jsonData.code === '200' && jsonData.data && jsonData.data.token) {\n    pm.environment.set('token', jsonData.data.token);\n    pm.environment.set('currentUserId', jsonData.data.id);\n    console.log('✅ Token 提取成功: ' + jsonData.data.token);\n} else {\n    console.error('❌ 登录失败或未返回 Token');\n}"
            }
          }
        },
        {
          "name": "获取当前用户ID",
          "api": {
            "method": "GET",
            "path": "/userid",
            "parameters": {
              "header": [
                {
                  "name": "token",
                  "value": "{{token}}",
                  "required": true
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. 商品模块",
      "items": [
        {
          "name": "商品分页查询",
          "api": {
            "method": "GET",
            "path": "/api/good/page",
            "parameters": {
              "query": [
                { "name": "pageNum", "value": "1" },
                { "name": "pageSize", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "商品详情",
          "api": {
            "method": "GET",
            "path": "/api/good/detail/{id}",
            "parameters": {
              "path": [
                { "name": "id", "value": "1" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. 购物车与订单",
      "items": [
        {
          "name": "查询我的购物车",
          "api": {
            "method": "GET",
            "path": "/api/cart/userid/{{currentUserId}}",
            "parameters": {
              "header": [
                { "name": "token", "value": "{{token}}", "required": true }
              ]
            }
          }
        },
        {
          "name": "提交订单",
          "api": {
            "method": "POST",
            "path": "/api/order",
            "parameters": {
              "header": [
                { "name": "token", "value": "{{token}}", "required": true }
              ],
              "body": {
                "type": "json",
                "json": "{\n  \"userId\": {{currentUserId}},\n  \"addressId\": 1,\n  \"totalPrice\": 100\n}"
              }
            }
          }
        }
      ]
    }
  ]
}
