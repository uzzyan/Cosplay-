{
  "openapi": "3.0.1",
  "info": {
    "title": "Cosplay Mall 专项模块自动化测试集",
    "description": "包含用户管理、地址管理、售后流程、评论系统、文件上传的专项自动化场景。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:9191",
      "description": "本地开发环境"
    }
  ],
  "paths": {
    "/register": {
      "post": {
        "tags": [
          "user-controller"
        ],
        "summary": "用户注册场景",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "testuser_{{$timestamp}}"
                  },
                  "password": {
                    "type": "string",
                    "example": "ecd00aa1acd325ba7575cb0f638b04a5"
                  },
                  "nickname": {
                    "type": "string",
                    "example": "测试昵称"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "注册成功"
          }
        },
        "x-apifox-post-processors": [
          {
            "type": "json-extract",
            "jsonPath": "$.data.id",
            "variableName": "newUserId"
          }
        ]
      }
    },
    "/user/page": {
      "get": {
        "tags": [
          "user-controller"
        ],
        "summary": "管理员分页查询用户",
        "parameters": [
          {
            "name": "token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "default": "{{token}}"
            }
          },
          {
            "name": "pageNum",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功"
          }
        }
      }
    },
    "/api/address": {
      "post": {
        "tags": [
          "address-controller"
        ],
        "summary": "新增收货地址",
        "parameters": [
          {
            "name": "token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "default": "{{token}}"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "linkUser": {
                    "type": "string",
                    "example": "张三"
                  },
                  "linkPhone": {
                    "type": "string",
                    "example": "13812345678"
                  },
                  "address": {
                    "type": "string",
                    "example": "上海市浦东新区自动化测试路1号"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "保存成功"
          }
        }
      },
      "get": {
        "tags": [
          "address-controller"
        ],
        "summary": "获取我的所有地址 (管理员权限)",
        "parameters": [
          {
            "name": "token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "default": "{{token}}"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "获取成功"
          }
        }
      }
    },
    "/api/afterSale": {
      "post": {
        "tags": [
          "after-sale-controller"
        ],
        "summary": "申请售后流程",
        "parameters": [
          {
            "name": "token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "default": "{{token}}"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "orderNo": {
                    "type": "string",
                    "example": "{{temp_order_no}}"
                  },
                  "type": {
                    "type": "string",
                    "example": "仅退款"
                  },
                  "reason": {
                    "type": "string",
                    "example": "自动化测试申请"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "申请成功"
          }
        }
      }
    },
    "/api/afterSale/handle": {
      "put": {
        "tags": [
          "after-sale-controller"
        ],
        "summary": "管理员处理售后单",
        "parameters": [
          {
            "name": "token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "default": "{{token}}"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer",
                    "example": 1
                  },
                  "status": {
                    "type": "string",
                    "example": "已完成"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "处理成功"
          }
        }
      }
    },
    "/api/comment": {
      "post": {
        "tags": [
          "comment-controller"
        ],
        "summary": "发表商品评论",
        "parameters": [
          {
            "name": "token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "default": "{{token}}"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "goodId": {
                    "type": "integer",
                    "example": 1
                  },
                  "content": {
                    "type": "string",
                    "example": "自动测试好评！"
                  },
                  "star": {
                    "type": "integer",
                    "example": 5
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "评论成功"
          }
        }
      }
    },
    "/file/upload": {
      "post": {
        "tags": [
          "file-controller"
        ],
        "summary": "自动化上传文件",
        "parameters": [
          {
            "name": "token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "default": "{{token}}"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "上传成功"
          }
        },
        "x-apifox-post-processors": [
          {
            "type": "json-extract",
            "jsonPath": "$.data",
            "variableName": "lastUploadedUrl"
          }
        ]
      }
    }
  }
}
