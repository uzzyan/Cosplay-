{
  "apifoxProject": {
    "name": "Cosplay商城API",
    "description": "Cosplay服装电商系统API接口自动化测试",
    "version": "3.0",
    "baseUrl": "http://localhost:9191"
  },
  "environments": [
    {
      "name": "开发环境",
      "variables": [
        {
          "name": "baseUrl",
          "value": "http://localhost:9191",
          "description": "后端服务地址"
        },
        {
          "name": "token",
          "value": "",
          "description": "用户Token（登录后自动填充）"
        },
        {
          "name": "userId",
          "value": "",
          "description": "用户ID（登录后自动填充）"
        },
        {
          "name": "adminToken",
          "value": "",
          "description": "管理员Token（登录后自动填充）"
        },
        {
          "name": "orderNo",
          "value": "",
          "description": "订单号（创建订单后自动填充）"
        },
        {
          "name": "username",
          "value": "admin",
          "description": "测试用户名"
        },
        {
          "name": "password",
          "value": "e10adc3949ba59abbe56e057f20f883e",
          "description": "测试密码（MD5加密）"
        }
      ]
    }
  ],
  "apiGroups": [
    {
      "name": "01-用户认证",
      "description": "用户登录、注册相关接口",
      "apis": [
        {
          "name": "用户登录",
          "method": "POST",
          "path": "/login",
          "description": "用户登录获取Token",
          "request": {
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "type": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "expectedResponse": {
            "code": "200",
            "body": "{\n  \"code\": \"200\",\n  \"msg\": null,\n  \"data\": {\n    \"id\": 1,\n    \"username\": \"admin\",\n    \"nickname\": \"管理员\",\n    \"role\": \"admin\",\n    \"token\": \"eyJhbGci...\"\n  }\n}"
          },
          "postScript": "// 解析响应JSON\nconst response = pm.response.json();\n\n// 测试响应状态\npm.test(\"登录成功\", function () {\n    pm.expect(response.code).to.eql(\"200\");\n});\n\n// 保存Token到环境变量\nif (response.code === \"200\") {\n    pm.environment.set(\"token\", response.data.token);\n    pm.environment.set(\"userId\", response.data.id);\n    \n    if (response.data.role === \"admin\") {\n        pm.environment.set(\"adminToken\", response.data.token);\n    }\n    \n    console.log(\"✅ Token已保存:\", response.data.token);\n    console.log(\"✅ 用户ID:\", response.data.id);\n    console.log(\"✅ 用户角色:\", response.data.role);\n}"
        },
        {
          "name": "用户注册",
          "method": "POST",
          "path": "/register",
          "description": "新用户注册",
          "request": {
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "type": "raw",
              "raw": "{\n  \"username\": \"testuser_{{timestamp}}\",\n  \"password\": \"{{password}}\",\n  \"phone\": \"13800138000\"\n}"
            }
          },
          "expectedResponse": {
            "code": "200"
          },
          "postScript": "const response = pm.response.json();\npm.test(\"注册成功\", function () {\n    pm.expect(response.code).to.eql(\"200\");\n});\nconsole.log(\"✅ 用户注册成功\");"
        }
      ]
    },
    {
      "name": "02-商品管理",
      "description": "商品浏览、搜索、详情接口",
      "apis": [
        {
          "name": "商品列表（分页）",
          "method": "GET",
          "path": "/api/good/page",
          "description": "分页查询商品列表",
          "request": {
            "headers": {
              "token": "{{token}}"
            },
            "params": {
              "pageNum": "1",
              "pageSize": "10",
              "name": "",
              "categoryId": ""
            }
          },
          "postScript": "const response = pm.response.json();\n\npm.test(\"获取商品列表成功\", function () {\n    pm.expect(response.code).to.eql(\"200\");\n    pm.expect(response.data).to.have.property(\"records\");\n    pm.expect(response.data).to.have.property(\"total\");\n});\n\nconsole.log(\"✅ 商品总数:\", response.data.total);\nconsole.log(\"✅ 当前页商品数:\", response.data.records.length);"
        },
        {
          "name": "商品搜索",
          "method": "GET",
          "path": "/api/good/page",
          "description": "关键词搜索商品",
          "request": {
            "headers": {
              "token": "{{token}}"
            },
            "params": {
              "pageNum": "1",
              "pageSize": "10",
              "name": "初音",
              "categoryId": ""
            }
          },
          "postScript": "const response = pm.response.json();\npm.test(\"搜索成功\", function () {\n    pm.expect(response.code).to.eql(\"200\");\n});\nconsole.log(\"✅ 搜索结果:\", response.data.total, \"条\");"
        },
        {
          "name": "商品详情",
          "method": "GET",
          "path": "/api/good/detail/1",
          "description": "查看商品详细信息",
          "request": {
            "headers": {
              "token": "{{token}}"
            }
          },
          "postScript": "const response = pm.response.json();\npm.test(\"获取商品详情成功\", function () {\n    pm.expect(response.code).to.eql(\"200\");\n});\nconsole.log(\"✅ 商品名称:\", response.data.name);"
        },
        {
          "name": "推荐商品",
          "method": "GET",
          "path": "/api/good/recommend/{{userId}}",
          "description": "获取个性化推荐商品",
          "request": {
            "headers": {
              "token": "{{token}}"
            }
          },
          "postScript": "const response = pm.response.json();\npm.test(\"获取推荐商品成功\", function () {\n    pm.expect(response.code).to.eql(\"200\");\n});\nconsole.log(\"✅ 推荐商品数:\", response.data.length);"
        }
      ]
    },
    {
      "name": "03-购物车",
      "description": "购物车增删改查接口",
      "apis": [
        {
          "name": "添加商品到购物车",
          "method": "POST",
          "path": "/api/cart",
          "description": "添加商品到购物车",
          "request": {
            "headers": {
              "Content-Type": "application/json",
              "token": "{{token}}"
            },
            "body": {
              "type": "raw",
              "raw": "{\n  \"goodId\": 1,\n  \"count\": 2,\n  \"standard\": \"M码,蓝色\"\n}"
            }
          },
          "postScript": "const response = pm.response.json();\npm.test(\"添加到购物车成功\", function () {\n    pm.expect(response.code).to.eql(\"200\");\n});\nconsole.log(\"✅ 商品已添加到购物车\");"
        },
        {
          "name": "查看购物车",
          "method": "GET",
          "path": "/api/cart/userid/{{userId}}",
          "description": "查询用户购物车",
          "request": {
            "headers": {
              "token": "{{token}}"
            }
          },
          "postScript": "const response = pm.response.json();\npm.test(\"查看购物车成功\", function () {\n    pm.expect(response.code).to.eql(\"200\");\n});\nconsole.log(\"✅ 购物车商品数:\", response.data.length);"
        }
      ]
    },
    {
      "name": "04-订单管理",
      "description": "订单创建、支付、查询接口",
      "apis": [
        {
          "name": "创建订单",
          "method": "POST",
          "path": "/api/order",
          "description": "创建新订单",
          "request": {
            "headers": {
              "Content-Type": "application/json",
              "token": "{{token}}"
            },
            "body": {
              "type": "raw",
              "raw": "{\n  \"totalPrice\": 199.98,\n  \"linkUser\": \"张三\",\n  \"linkPhone\": \"13800138000\",\n  \"linkAddress\": \"北京市朝阳区XXX街道\"\n}"
            }
          },
          "postScript": "const response = pm.response.json();\npm.test(\"创建订单成功\", function () {\n    pm.expect(response.code).to.eql(\"200\");\n});\nif (response.code === \"200\") {\n    pm.environment.set(\"orderNo\", response.data);\n    console.log(\"✅ 订单号:\", response.data);\n}"
        },
        {
          "name": "查询我的订单",
          "method": "GET",
          "path": "/api/order/userid/{{userId}}",
          "description": "查看用户订单列表",
          "request": {
            "headers": {
              "token": "{{token}}"
            }
          },
          "postScript": "const response = pm.response.json();\npm.test(\"查询订单成功\", function () {\n    pm.expect(response.code).to.eql(\"200\");\n});\nconsole.log(\"✅ 订单总数:\", response.data.length);"
        },
        {
          "name": "支付订单",
          "method": "POST",
          "path": "/api/order/paid/{{orderNo}}",
          "description": "模拟支付订单",
          "request": {
            "headers": {
              "token": "{{token}}"
            }
          },
          "postScript": "const response = pm.response.json();\npm.test(\"支付成功\", function () {\n    pm.expect(response.code).to.eql(\"200\");\n});\nconsole.log(\"✅ 订单已支付\");"
        },
        {
          "name": "确认收货",
          "method": "POST",
          "path": "/api/order/receive/{{orderNo}}",
          "description": "确认收到商品",
          "request": {
            "headers": {
              "token": "{{token}}"
            }
          },
          "postScript": "const response = pm.response.json();\npm.test(\"确认收货成功\", function () {\n    pm.expect(response.code).to.eql(\"200\");\n});\nconsole.log(\"✅ 已确认收货\");"
        }
      ]
    },
    {
      "name": "05-个人中心",
      "description": "用户信息管理接口",
      "apis": [
        {
          "name": "获取用户信息",
          "method": "GET",
          "path": "/userinfo/{{username}}",
          "description": "查看用户详细信息",
          "request": {
            "headers": {
              "token": "{{token}}"
            }
          },
          "postScript": "const response = pm.response.json();\npm.test(\"获取用户信息成功\", function () {\n    pm.expect(response.code).to.eql(\"200\");\n});\nconsole.log(\"✅ 用户名:\", response.data.username);"
        },
        {
          "name": "更新用户信息",
          "method": "POST",
          "path": "/user",
          "description": "修改用户个人信息",
          "request": {
            "headers": {
              "Content-Type": "application/json",
              "token": "{{token}}"
            },
            "body": {
              "type": "raw",
              "raw": "{\n  \"id\": {{userId}},\n  \"nickname\": \"新昵称\",\n  \"phone\": \"13900139000\",\n  \"email\": \"test@example.com\"\n}"
            }
          },
          "postScript": "const response = pm.response.json();\npm.test(\"更新用户信息成功\", function () {\n    pm.expect(response.code).to.eql(\"200\");\n});\nconsole.log(\"✅ 用户信息已更新\");"
        }
      ]
    },
    {
      "name": "06-管理员功能",
      "description": "管理员专属接口",
      "apis": [
        {
          "name": "用户管理（分页）",
          "method": "GET",
          "path": "/user/page",
          "description": "分页查询所有用户",
          "request": {
            "headers": {
              "token": "{{adminToken}}"
            },
            "params": {
              "pageNum": "1",
              "pageSize": "10",
              "username": ""
            }
          },
          "postScript": "const response = pm.response.json();\npm.test(\"查询用户列表成功\", function () {\n    pm.expect(response.code).to.eql(\"200\");\n});\nconsole.log(\"✅ 用户总数:\", response.data.total);"
        },
        {
          "name": "新增商品",
          "method": "POST",
          "path": "/api/good",
          "description": "管理员新增商品",
          "request": {
            "headers": {
              "Content-Type": "application/json",
              "token": "{{adminToken}}"
            },
            "body": {
              "type": "raw",
              "raw": "{\n  \"name\": \"测试商品\",\n  \"description\": \"商品描述\",\n  \"discount\": 1.0,\n  \"categoryId\": 1,\n  \"recommend\": false,\n  \"status\": 1\n}"
            }
          },
          "postScript": "const response = pm.response.json();\npm.test(\"新增商品成功\", function () {\n    pm.expect(response.code).to.eql(\"200\");\n});\nconsole.log(\"✅ 商品已添加\");"
        },
        {
          "name": "订单发货",
          "method": "POST",
          "path": "/api/order/deliver/{{orderNo}}",
          "description": "管理员发货",
          "request": {
            "headers": {
              "token": "{{adminToken}}"
            }
          },
          "postScript": "const response = pm.response.json();\npm.test(\"发货成功\", function () {\n    pm.expect(response.code).to.eql(\"200\");\n});\nconsole.log(\"✅ 订单已发货\");"
        },
        {
          "name": "收入统计",
          "method": "GET",
          "path": "/api/income/chart",
          "description": "查看收入图表数据",
          "request": {
            "headers": {
              "token": "{{adminToken}}"
            }
          },
          "postScript": "const response = pm.response.json();\npm.test(\"获取收入统计成功\", function () {\n    pm.expect(response.code).to.eql(\"200\");\n});\nconsole.log(\"✅ 收入分类数:\", response.data.categoryIncomes.length);"
        },
        {
          "name": "商品销量排行",
          "method": "GET",
          "path": "/api/good/rank",
          "description": "查看商品销量排行",
          "request": {
            "headers": {
              "token": "{{adminToken}}"
            },
            "params": {
              "num": "10"
            }
          },
          "postScript": "const response = pm.response.json();\npm.test(\"获取商品排行成功\", function () {\n    pm.expect(response.code).to.eql(\"200\");\n});\nconsole.log(\"✅ Top10商品已获取\");"
        }
      ]
    }
  ],
  "testScenarios": [
    {
      "name": "完整购物流程",
      "description": "从登录到确认收货的完整流程",
      "steps": [
        {
          "order": 1,
          "apiName": "用户登录",
          "groupName": "01-用户认证",
          "description": "第一步：登录系统"
        },
        {
          "order": 2,
          "apiName": "商品列表（分页）",
          "groupName": "02-商品管理",
          "description": "第二步：浏览商品"
        },
        {
          "order": 3,
          "apiName": "商品详情",
          "groupName": "02-商品管理",
          "description": "第三步：查看商品详情"
        },
        {
          "order": 4,
          "apiName": "添加商品到购物车",
          "groupName": "03-购物车",
          "description": "第四步：添加到购物车"
        },
        {
          "order": 5,
          "apiName": "查看购物车",
          "groupName": "03-购物车",
          "description": "第五步：查看购物车"
        },
        {
          "order": 6,
          "apiName": "创建订单",
          "groupName": "04-订单管理",
          "description": "第六步：创建订单"
        },
        {
          "order": 7,
          "apiName": "支付订单",
          "groupName": "04-订单管理",
          "description": "第七步：支付订单"
        },
        {
          "order": 8,
          "apiName": "查询我的订单",
          "groupName": "04-订单管理",
          "description": "第八步：查看订单"
        },
        {
          "order": 9,
          "apiName": "确认收货",
          "groupName": "04-订单管理",
          "description": "第九步：确认收货"
        }
      ]
    },
    {
      "name": "管理员日常操作",
      "description": "管理员登录到查看统计的流程",
      "steps": [
        {
          "order": 1,
          "apiName": "用户登录",
          "groupName": "01-用户认证",
          "description": "管理员登录"
        },
        {
          "order": 2,
          "apiName": "用户管理（分页）",
          "groupName": "06-管理员功能",
          "description": "查看用户列表"
        },
        {
          "order": 3,
          "apiName": "新增商品",
          "groupName": "06-管理员功能",
          "description": "新增商品"
        },
        {
          "order": 4,
          "apiName": "收入统计",
          "groupName": "06-管理员功能",
          "description": "查看收入统计"
        },
        {
          "order": 5,
          "apiName": "商品销量排行",
          "groupName": "06-管理员功能",
          "description": "查看商品排行"
        }
      ]
    }
  ],
  "importInstructions": {
    "title": "Apifox导入说明",
    "steps": [
      {
        "step": 1,
        "title": "打开Apifox",
        "description": "启动Apifox桌面客户端或访问网页版"
      },
      {
        "step": 2,
        "title": "创建新项目",
        "description": "点击'新建项目'，选择'手动创建'，填写项目名称'Cosplay商城API'"
      },
      {
        "step": 3,
        "title": "导入数据",
        "description": "项目创建后，点击'导入'，选择'Apifox JSON格式'，上传此文件"
      },
      {
        "step": 4,
        "title": "选择导入模式",
        "description": "选择'普通导入'或'同步导入'，推荐'普通导入'"
      },
      {
        "step": 5,
        "title": "确认导入",
        "description": "检查导入预览，确认无误后点击'确定'"
      },
      {
        "step": 6,
        "title": "配置环境",
        "description": "切换到'开发环境'，检查baseUrl是否正确"
      },
      {
        "step": 7,
        "title": "开始测试",
        "description": "先运行'用户登录'接口获取Token，然后运行其他接口或测试场景"
      }
    ],
    "notes": [
      "导入后所有接口已配置好请求参数和后置脚本",
      "环境变量已预设，登录后自动保存Token",
      "包含2个测试场景，可一键运行完整流程",
      "每个接口都有断言验证，自动检查响应结果"
    ]
  }
}
