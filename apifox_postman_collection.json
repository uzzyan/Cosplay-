  "item": [
    {
      "name": "01-用户认证",
      "item": [
        {
          "name": "用户登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            },
            "description": "用户登录获取Token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "",
                  "pm.test(\"登录成功\", function () {",
                  "    pm.expect(response.code).to.eql(\"200\");",
                  "});",
                  "",
                  "if (response.code === \"200\") {",
                  "    pm.environment.set(\"token\", response.data.token);",
                  "    pm.environment.set(\"userId\", response.data.id);",
                  "    ",
                  "    if (response.data.role === \"admin\") {",
                  "        pm.environment.set(\"adminToken\", response.data.token);",
                  "    }",
                  "    ",
                  "    console.log(\"✅ Token已保存:\", response.data.token);",
                  "    console.log(\"✅ 用户ID:\", response.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "用户注册",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser_{{$timestamp}}\",\n  \"password\": \"{{password}}\",\n  \"phone\": \"13800138000\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": ["{{baseUrl}}"],
              "path": ["register"]
            },
            "description": "新用户注册"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "pm.test(\"注册成功\", function () {",
                  "    pm.expect(response.code).to.eql(\"200\");",
                  "});",
                  "console.log(\"✅ 用户注册成功\");"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
