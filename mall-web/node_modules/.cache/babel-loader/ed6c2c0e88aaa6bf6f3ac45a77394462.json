{"ast":null,"code":"import \"core-js/modules/es.json.stringify.js\";\nimport { ref, onMounted } from 'vue';\nimport { ElMessage } from 'element-plus';\nimport { useStore } from 'vuex';\nimport API from '@/utils/request';\nvar url = '/api/carousel/';\nexport default {\n  __name: 'Carousel',\n  setup: function setup(__props, _ref) {\n    var __expose = _ref.expose;\n\n    __expose();\n\n    var store = useStore();\n    var baseApi = store.state.baseApi;\n    var tableData = ref([]);\n    var entity = ref({});\n    var dialogFormVisible = ref(false);\n\n    var load = function load() {\n      API.get(url).then(function (res) {\n        tableData.value = res.data || [];\n      });\n    };\n\n    var add = function add() {\n      entity.value = {};\n      tableData.value.length++;\n      dialogFormVisible.value = true;\n    };\n\n    var edit = function edit(row) {\n      entity.value = JSON.parse(JSON.stringify(row));\n      dialogFormVisible.value = true;\n    };\n\n    var save = function save() {\n      if (entity.value.goodId == undefined || entity.value.goodId === '') {\n        ElMessage.error('商品id不能为空');\n        return;\n      }\n\n      if (entity.value.showOrder == undefined) {\n        ElMessage.error('轮播顺序不能为空');\n        return;\n      }\n\n      API.post(url, entity.value).then(function (res) {\n        if (res.code === '200') {\n          ElMessage.success('保存成功');\n          load();\n          dialogFormVisible.value = false;\n        } else {\n          ElMessage.error(res.msg);\n        }\n      });\n    };\n\n    var del = function del(id) {\n      API.delete(url + id).then(function (res) {\n        if (res.code === '200') {\n          ElMessage({\n            type: 'success',\n            message: '删除成功'\n          });\n          load();\n        } else {\n          ElMessage.error(res.msg);\n        }\n      });\n    };\n\n    onMounted(function () {\n      load();\n    });\n    var __returned__ = {\n      store: store,\n      baseApi: baseApi,\n  