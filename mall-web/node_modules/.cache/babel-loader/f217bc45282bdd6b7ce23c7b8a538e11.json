{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\nimport incomeItem from \"@/components/IncomeItem\";\nexport default {\n  name: \"IncomeRank\",\n\n  data() {\n    return {\n      num: 10,\n      good: [],\n      categories: []\n    };\n  },\n\n  components: {\n    'income-item': incomeItem\n  },\n\n  created() {\n    //先查询分类id和名称\n    this.request.get(\"/api/category\").then(res => {\n      if (res.code === '200') {\n        this.categories = res.data;\n      } //获取排行数据\n\n\n      this.request.get(\"/api/good/rank/\", {\n        params: {\n          num: this.num\n        }\n      }).then(res => {\n        if (res.code === '200') {\n          this.good = res.data;\n        }\n      });\n    });\n  }\n\n};","map":{"version":3,"mappings":";;;;;;;;;;;;;AAcA;AACA;AACAA,oBADA;;AAEAC;AACA;AACAC,aADA;AAEAC,cAFA;AAGAC;AAHA;AAKA,GARA;;AASAC;AACA;AADA,GATA;;AAYAC;AACA;AACA;AACA;AACA;AACA,OAHA,CAIA;;;AACA;AAAAC;AAAAL;AAAA;AAAA;AACA;AACA;AACA;AACA,OAJA;AAKA,KAVA;AAYA;;AA1BA","names":["name","data","num","good","categories","components","created","params"],"sourceRoot":"src/views/manage/income","sources":["IncomeRank.vue"],"sourcesContent":["<!--\r\n * @Description: \r\n * @Author: gzc\r\n * @Date: 2024-03-21 15:27:05\r\n-->\r\n<template >\r\n  <div style=\"width: 58%;height:100%;margin: 20px auto;\">\r\n    <span v-for=\"(good,index) in good\" :key=\"index\">\r\n      <income-item :index=\"index+1\" :good=\"good\" :categories=\"categories\" style=\"margin-bottom: 2px\"></income-item>\r\n    </span>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport incomeItem from \"@/components/IncomeItem\";\r\nexport default {\r\n  name: \"IncomeRank\",\r\n  data(){\r\n    return{\r\n      num: 10,\r\n      good: [],\r\n      categories: [],\r\n    }\r\n  },\r\n  components:{\r\n    'income-item': incomeItem,\r\n  },\r\n  created() {\r\n    //先查询分类id和名称\r\n    this.request.get(\"/api/category\").then(res=> {\r\n      if (res.code === '200') {\r\n        this.categories = res.data;\r\n      }\r\n      //获取排行数据\r\n      this.request.get(\"/api/good/rank/\",{params:{num: this.num}}).then(res=>{\r\n        if(res.code==='200'){\r\n          this.good = res.data;\r\n        }\r\n      })\r\n    })\r\n\r\n  },\r\n\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n\r\n</style>"]},"metadata":{},"sourceType":"module"}