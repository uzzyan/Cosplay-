tOrders: function exportOrders() {\n      API({\n        url: url + \"export\",\n        method: \"get\",\n        params: {\n          orderNo: this.searchText,\n          state: this.searchMode\n        },\n        responseType: \"blob\"\n      }).then(function (data) {\n        var blob = new Blob([data], {\n          type: \"text/csv;charset=utf-8;\"\n        });\n        var urlObject = window.URL.createObjectURL(blob);\n        var a = document.createElement(\"a\");\n        var now = new Date();\n\n        var pad = function pad(n) {\n          return n < 10 ? \"0\" + n : \"\" + n;\n        };\n\n        var fileName = \"orders_\" + now.getFullYear() + pad(now.getMonth() + 1) + pad(now.getDate()) + pad(now.getHours()) + pad(now.getMinutes()) + pad(now.getSeconds()) + \".csv\";\n        a.href = urlObject;\n        a.download = fileName;\n        document.body.appendChild(a);\n        a.click();\n        a.remove();\n        window.URL.revokeObjectURL(urlObject);\n      });\n    },\n    showDetail: function showDetail(row) {\n      var _this2 = this;\n\n      this.request.get(\"/api/order/orderNo/\" + row.orderNo).then(function (res) {\n        if (res.code === \"200\") {\n          _this2.detail = [];\n\n          _this2.detail.push(res.data);\n\n          _this2.dialogFormVisible = true;\n        }\n      });\n    },\n    //发货\n    delivery: function delivery(order) {\n      var _this3 = this;\n\n      this.request.post(\"/api/order/delivery/\" + order.orderNo).then(function (res) {\n        if (res.code === \"200\") {\n          _this3.$message.success(\"成功发货\");\n\n          order.state = \"已发货\";\n        }\n      });\n    }\n  }\n};","map":{"version":3,"mappings":";;;;;AAyKA,OAAOA,GAAP,MAAgB,qBAAhB;AACA,IAAMC,GAAE,GAAI,aAAZ;AAGA,eAAe;AACXC,MAAI,EAAE,OADK;AAEXC,MAFW,kBAEJ;AACH,WAAO;AACHC,aAAO,EAAE,EADN;AAEHC,gBAAU,EAAE,EAFT;AAGHC,gBAAU,EAAE,EAHT;AAIHC,UAAI,EAAE,EAJH;AAKHC,eAAS,EAAE,EALR;AAMHC,aAAO,EAAE,CANN;AAOHC,cAAQ,EAAE,CAPP;AAQHC,YAAM,EAAE,EARL;AASHC,