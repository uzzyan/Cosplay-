function saveAddress() {\n      address.value.userId = userId.value;\n      API.post('/api/address', address.value).then(function (res) {\n        if (res.code === '200') {\n          ElMessage.success('保存成功');\n          loadAddress();\n          dialogFormVisible.value = false;\n        } else {\n          ElMessage.error(res.msg);\n        }\n      });\n    };\n\n    var loadAddress = function loadAddress() {\n      API.get('/userid').then(function (res) {\n        userId.value = res;\n        API.get('/api/address/' + res).then(function (res) {\n          if (res.code === '200') {\n            addressData.value = res.data;\n          }\n        });\n      });\n    };\n\n    var sumPrice = computed(function () {\n      var sum = 0;\n      goods.value.forEach(function (good) {\n        sum += good.realPrice * good.num;\n      });\n      return sum.toFixed(2);\n    });\n    var sumDiscount = computed(function () {\n      var sum = 0;\n      goods.value.forEach(function (good) {\n        sum += (good.realPrice / good.discount - good.realPrice) * good.num;\n      });\n      return sum.toFixed(2);\n    });\n\n    var submitOrder = function submitOrder() {\n      var address = addressData.value[checkedIndex.value];\n\n      if (!address) {\n        ElMessage({\n          type: 'warning',\n          message: '请选择收货地址！'\n        });\n        return;\n      } // 提交订单\n\n\n      var totalPrice = sumPrice.value;\n      API.post('/api/order', {\n        totalPrice: totalPrice,\n        linkUser: address.linkUser,\n        linkPhone: address.linkPhone,\n        linkAddress: address.linkAddress,\n        state: '待付款',\n        goods: JSON.stringify(goods.value),\n        cartId: cartId.value\n      }).then(function (res) {\n        if (res.code === '200') {\n          var orderNo = res.data; //跳转到支付页面\n\n          router.replace({\n            path: 'pay',\n            query: {\n              money: totalPrice,\n              orderNo: orderNo\n            }\n          });\n        } else {\n          ElMessage({\n            type: 'error',\n            message: res.msg\n          });\n        }\n      });\n    };\n\n    onMounted(function () {\n      loadAddress();\n      good.value = JSON.parse(route.query.good);\n      good.value.realPrice = route.query.realPrice;\n      good.value.num = route.query.num;\n      good.value.standard = route.query.standard;\n      cartId.value = route.query.cartId;\n      goods.value.push(good.value);\n    });\n    var __returned__ = {\n      store: store,\n      route: route,\n      router: router,\n      baseApi: baseApi,\n      userId: userId,\n      addressData: addressData,\n      address: address,\n      checkedIndex: checkedIndex,\n      dialogFormVisible: dialogFormVisible,\n      good: good,\n      realPrice: realPrice,\n      goods: goods,\n      cartId: cartId,\n      select: select,\n      addAddress: addAddress,\n      editAddress: editAddress,\n      deleteAddress: deleteAddress,\n      saveAddress: saveAddress,\n      loadAddress: loadAddress,\n      sumPrice: sumPrice,\n      sumDiscount: sumDiscount,\n      submitOrder: submitOrder,\n      ref: ref,\n      computed: computed,\n      onMounted: onMounted,\n\n      get useRoute() {\n        return useRoute;\n      },\n\n      get useRouter() {\n        return useRouter;\n      },\n\n      get ElMessage() {\n        return ElMessage;\n      },\n\n      get ElMessageBox() {\n        return ElMessageBox;\n      },\n\n      get useStore() {\n        return useStore;\n      },\n\n      AddressBox: AddressBox,\n\n      get API() {\n        return API;\n      }\n\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"mappings":";;;;;;AAiHA,SAASA,GAAT,EAAcC,QAAd,EAAwBC,SAAxB,QAAyC,KAAzC;AACA,SAASC,QAAT,EAAmBC,SAAnB,QAAoC,YAApC;AACA,SAASC,SAAT,EAAoBC,YAApB,QAAwC,cAAxC;AACA,SAASC,QAAT,QAAyB,MAAzB;AACA,OAAOC,UAAP,MAAuB,6BAAvB;AA