{"ast":null,"code":"import \"core-js/modules/es.number.to-fixed.js\";\nimport \"core-js/modules/es.json.stringify.js\";\nexport default {\n  name: \"CartItem\",\n  props: {\n    cart: Object,\n    countChangeFlag: false\n  },\n  created: function created() {},\n  mounted: function mounted() {},\n  data: function data() {\n    return {\n      baseApi: this.$store.state.baseApi\n    };\n  },\n  computed: {\n    totalPrice: function totalPrice() {\n      return (this.realPrice * this.cart.count).toFixed(2);\n    },\n    realPrice: function realPrice() {\n      return this.cart.price * this.cart.discount;\n    }\n  },\n  methods: {\n    //从购物车移除\n    del: function del(id) {\n      var _this = this;\n\n      this.request.delete(\"/api/cart/\" + this.cart.id).then(function (res) {\n        if (res.code === '200') {\n          _this.$message.success(\"删除成功\");\n\n          _this.$emit('delete', _this.cart.id);\n        }\n      });\n    },\n    //跳转到支付页面\n    pay: function pay() {\n      var good = {\n        id: this.cart.goodId,\n        name: this.cart.goodName,\n        imgs: this.cart.img,\n        discount: this.cart.discount\n      };\n      this.$router.push({\n        name: 'preOrder',\n        query: {\n          good: JSON.stringify(good),\n          realPrice: this.realPrice,\n          num: this.cart.count,\n          standard: this.cart.standard,\n          cartId: this.cart.id\n        }\n      });\n    }\n  }\n};","map":{"version":3,"mappings":";;AAmGA,eAAe;AACbA,MAAI,EAAE,UADO;AAEbC,OAAK,EAAC;AACJC,QAAI,EAAEC,MADF;AAEJC,mBAAe,EAAE;AAFb,GAFO;AAMbC,SANa,qBAMH,CAET,CARY;AASbC,SATa,qBASH,CAET,CAXY;AAYbC,MAZa,kBAYP;AACJ,WAAM;AAEJC,aAAO,EAAE,KAAKC,MAAL,CAAYC,KAAZ,CAAkBF;AAFvB,KAAN;AAID,GAjBY;AAkBbG,UAAQ,EAAC;AACPC,cAAU,EAAC,sBAAY;AACrB,aAAO,CAAC,KAAKC,SAAL,GAAiB,KAAKX,IAAL,CAAUY,KAA5B,EAAmCC,OAAnC,CAA2C,CAA3C,CAAP;AACD,KAHM;AAIPF,aAAS,EAAE,qBAAW;AACpB,aAAQ,KAAKX,IAAL,CAAUc,KAAV,GAAkB,KAAKd,IAAL,CAAUe,QAApC;AACF;AANO,GAlBI;AA0BbC,SAAO,EAAC;AACN;AACAC,OAFM,eAEFC,EAFE,EAEC;AAAA;;AACL,WAAKC,OAAL,CAAaC,MAAb,CAAoB,eAAa,KAAKpB,IAAL,CAAUkB,EAA3C,EAA+CG,IAA/C,CAAoD,aAAG,EAAE;AACvD,YAAGC,GAAG,CAACC,IAAJ,KAAW,KAAd,EAAoB;AAClB,eAAI,CAACC,QAAL,CAAcC,OAAd,CAAsB,MAAtB;;AACA,eAAI,CAACC,KAAL,CAAW,QAAX,EAAoB,KAAI,CAAC1B,IAAL,CAAUkB,EAA9B;AACF;AACD,OALD;AAMD,KATK;AAUN;AACAS,OAXM,iBAWD;AACH,UAAIC,IAAG,GAAI;AAACV,UAAE,EAAE,KAAKlB,IAAL,CAAU6B,MAAf;AAAsB/B,YAAI,EAAE,KAAKE,IAAL,CAAU8B,QAAtC;AAA+CC,YAAI,EAAE,KAAK/B,IAAL,CAAUgC,GAA/D;AAAmEjB,gBAAQ,EAAE,KAAKf,IAAL,CAAUe;AAAvF,OAAX;AACA,WAAKkB,OAAL,CAAaC,IAAb,CAAkB;AAACpC,YAAI,EAAE,UAAP;AAAkBqC,aAAK,EAAE;AAACP,cAAI,EAAEQ,IAAI,CAACC,SAAL,CAAeT,IAAf,CAAP;AAA6BjB,mBAAS,EAAE,KAAKA,SAA7C;AAAwD2B,aAAG,EAAE,KAAKtC,IAAL,CAAUY,KAAvE;AAA8E2B,kBAAQ,EAAE,KAAKvC,IAAL,CAAUuC,QAAlG;AAA4GC,gBAAM,EAAE,KAAKxC,IAAL,CAAUkB;AAA9H;AAAzB,OAAlB;AACD;AAdK;AA1BK,CAAf","names":["name","props","cart","Object","countChangeFlag","created","mounted","data","baseApi","$store","state","computed","totalPrice","realPrice","count","toFixed","price","discount","methods","del","id","request","delete","then","res","code","$message","success","$emit","pay","good","goodId","goodName","imgs","img","$router","push","query","JSON","stringify","num","standard","cartId"],"sourceRoot":"","sources":["C:\\q_code4.12\\cosplay_mall(qoder)\\mall-web\\src\\components\\CartItem.vue"],"sourcesContent":["<template>\r\n  <div class=\"cart-item-card\">\r\n    <!-- 时间标签 -->\r\n    <div class=\"time-badge\">\r\n      <i class=\"el-icon-time\"></i>\r\n      <span>{{ cart.createTime }}</span>\r\n    </div>\r\n\r\n    <!-- 卡片内容 -->\r\n    <div class=\"card-content\">\r\n      <!-- 商品图片 -->\r\n      <div class=\"product-image\">\r\n        <router-link :to=\"'goodview/'+cart.goodId\">\r\n          <img :src=\"baseApi + cart.img\" alt=\"商品图片\">\r\n        </router-link>\r\n      </div>\r\n\r\n      <!-- 商品信息 -->\r\n      <div class=\"product-info\">\r\n        <router-link :to=\"'goodview/'+cart.goodId\" class=\"product-name\">\r\n          {{ cart.goodName }}\r\n        </router-link>\r\n        <div class=\"product-spec\">\r\n          <span class=\"spec-label\">规格：</span>\r\n          <span class=\"spec-value\">{{ cart.standard }}</span>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 单价 -->\r\n      <div class=\"price-section\">\r\n        <div class=\"label\">单价</div>\r\n        <div class=\"price\">¥{{ realPrice.toFixed(2) }}</div>\r\n      </div>\r\n\r\n      <!-- 数量 -->\r\n      <div class=\"quantity-section\">\r\n        <div class=\"label\">数量</div>\r\n        <div class=\"quantity-control\">\r\n          <el-button \r\n            v-if=\"!countChangeFlag\" \r\n            @click=\"countChangeFlag=true\"\r\n            class=\"quantity-btn\"\r\n            size=\"small\"\r\n          >\r\n            {{ cart.count }}\r\n          </el-button>\r\n          <el-input-number \r\n            v-else\r\n            v-model=\"cart.count\" \r\n            :min=\"1\" \r\n            :max=\"cart.store\"\r\n            size=\"small\"\r\n            class=\"quantity-input\"\r\n          ></el-input-number>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 总价 -->\r\n      <div class=\"total-section\">\r\n        <div class=\"label\">总价</div>\r\n        <div class=\"total-price\">¥{{ totalPrice }}</div>\r\n      </div>\r\n\r\n      <!-- 操作按钮 -->\r\n      <div class=\"actions\">\r\n        <el-button \r\n          type=\"success\" \r\n          @click=\"pay\"\r\n          size=\"medium\"\r\n          round\r\n        >\r\n          <el-icon><Wallet /></el-icon>\r\n          支付\r\n        </el-button>\r\n        <el-popconfirm\r\n          @confirm=\"del\"\r\n          title=\"确定删除？\"\r\n          confirm-button-text=\"确定\"\r\n          cancel-button-text=\"取消\"\r\n        >\r\n          <template #reference>\r\n            <el-button \r\n              type=\"danger\" \r\n              size=\"medium\"\r\n              plain\r\n              round\r\n            >\r\n              <el-icon><Delete /></el-icon>\r\n              移除\r\n            </el-button>\r\n          </template>\r\n        </el-popconfirm>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\n\r\nexport default {\r\n  name: \"CartItem\",\r\n  props:{\r\n    cart: Object,\r\n    countChangeFlag: false,\r\n  },\r\n  created() {\r\n    \r\n  },\r\n  mounted() {\r\n    \r\n  },\r\n  data(){\r\n    return{\r\n\r\n      baseApi: this.$store.state.baseApi,\r\n    }\r\n  },\r\n  computed:{\r\n    totalPrice:function () {\r\n      return (this.realPrice * this.cart.count).toFixed(2)\r\n    },\r\n    realPrice: function (){\r\n      return (this.cart.price * this.cart.discount)\r\n    }\r\n  },\r\n  methods:{\r\n    //从购物车移除\r\n    del(id){\r\n      this.request.delete(\"/api/cart/\"+this.cart.id).then(res=>{\r\n        if(res.code==='200'){\r\n          this.$message.success(\"删除成功\")\r\n          this.$emit('delete',this.cart.id)\r\n        }\r\n      })\r\n    },\r\n    //跳转到支付页面\r\n    pay(){\r\n      let good = {id: this.cart.goodId,name: this.cart.goodName,imgs: this.cart.img,discount: this.cart.discount}\r\n      this.$router.push({name: 'preOrder',query: {good: JSON.stringify(good), realPrice: this.realPrice, num: this.cart.count, standard: this.cart.standard, cartId: this.cart.id}})\r\n    },\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.cart-item-card {\r\n  background: #ffffff;\r\n  border-radius: 16px;\r\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\r\n  overflow: hidden;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.cart-item-card:hover {\r\n  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);\r\n  transform: translateY(-2px);\r\n}\r\n\r\n/* 时间标签 */\r\n.time-badge {\r\n  background: #e8f4ff;\r\n  padding: 12px 20px;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  font-size: 14px;\r\n  color: #606266;\r\n  font-weight: 500;\r\n}\r\n\r\n.time-badge i {\r\n  color: #409EFF;\r\n  font-size: 16px;\r\n}\r\n\r\n/* 卡片内容 */\r\n.card-content {\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 25px;\r\n  gap: 25px;\r\n}\r\n\r\n/* 商品图片 */\r\n.product-image {\r\n  flex-shrink: 0;\r\n}\r\n\r\n.product-image img {\r\n  width: 120px;\r\n  height: 120px;\r\n  border-radius: 12px;\r\n  object-fit: cover;\r\n  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1);\r\n  transition: transform 0.3s ease;\r\n}\r\n\r\n.product-image img:hover {\r\n  transform: scale(1.05);\r\n}\r\n\r\n/* 商品信息 */\r\n.product-info {\r\n  flex: 1;\r\n  min-width: 200px;\r\n}\r\n\r\n.product-name {\r\n  display: block;\r\n  font-size: 18px;\r\n  font-weight: 600;\r\n  color: #303133;\r\n  margin-bottom: 12px;\r\n  text-decoration: none;\r\n  transition: color 0.3s;\r\n  line-height: 1.4;\r\n}\r\n\r\n.product-name:hover {\r\n  color: #409EFF;\r\n}\r\n\r\n.product-spec {\r\n  font-size: 14px;\r\n  color: #909399;\r\n}\r\n\r\n.spec-label {\r\n  color: #606266;\r\n  font-weight: 500;\r\n}\r\n\r\n.spec-value {\r\n  color: #67C23A;\r\n  font-weight: 500;\r\n}\r\n\r\n/* 价格、数量、总价区域 */\r\n.price-section,\r\n.quantity-section,\r\n.total-section {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 10px;\r\n  min-width: 100px;\r\n}\r\n\r\n.label {\r\n  font-size: 13px;\r\n  color: #909399;\r\n  font-weight: 500;\r\n}\r\n\r\n.price {\r\n  font-size: 18px;\r\n  color: #F56C6C;\r\n  font-weight: 600;\r\n}\r\n\r\n.quantity-control {\r\n  display: flex;\r\n  justify-content: center;\r\n}\r\n\r\n.quantity-btn {\r\n  min-width: 60px;\r\n  font-size: 15px;\r\n  font-weight: 600;\r\n}\r\n\r\n.quantity-input {\r\n  width: 120px;\r\n}\r\n\r\n.total-price {\r\n  font-size: 22px;\r\n  color: #E6A23C;\r\n  font-weight: 700;\r\n}\r\n\r\n/* 操作按钮 */\r\n.actions {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n  min-width: 100px;\r\n}\r\n\r\n.actions .el-button {\r\n  width: 100%;\r\n  font-weight: 500;\r\n}\r\n\r\n/* 响应式 */\r\n@media (max-width: 1024px) {\r\n  .card-content {\r\n    flex-wrap: wrap;\r\n    gap: 20px;\r\n  }\r\n  \r\n  .product-info {\r\n    flex-basis: 100%;\r\n  }\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .card-content {\r\n    flex-direction: column;\r\n    padding: 20px;\r\n  }\r\n  \r\n  .product-image img {\r\n    width: 100px;\r\n    height: 100px;\r\n  }\r\n  \r\n  .price-section,\r\n  .quantity-section,\r\n  .total-section {\r\n    flex-direction: row;\r\n    justify-content: space-between;\r\n    width: 100%;\r\n  }\r\n  \r\n  .actions {\r\n    width: 100%;\r\n  }\r\n}\r\n</style>"]},"metadata":{},"sourceType":"module"}