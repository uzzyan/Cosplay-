{"ast":null,"code":"import \"core-js/modules/es.string.trim.js\";\nimport \"core-js/modules/es.regexp.exec.js\";\nimport \"core-js/modules/es.regexp.test.js\";\nimport { ref } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { ElMessage } from 'element-plus';\nimport md5 from 'js-md5';\nimport request from '@/utils/request';\nexport default {\n  __name: 'Register',\n  setup: function setup(__props, _ref) {\n    var __expose = _ref.expose;\n\n    __expose();\n\n    var router = useRouter();\n    var user = ref({\n      username: '',\n      phone: '',\n      password: '',\n      confirmPassword: ''\n    });\n    var passwordRule = /^(?=.*[A-Za-z])(?=.*\\d)(?=.*[!@#$%^&*()_+\\-=\\[\\]{}|;:,.<>?])[A-Za-z\\d!@#$%^&*()_+\\-=\\[\\]{}|;:,.<>?]{6,12}$/;\n\n    var onSubmit = function onSubmit() {\n      var username = (user.value.username || '').trim();\n      var password = (user.value.password || '').trim();\n      var confirmPassword = (user.value.confirmPassword || '').trim();\n      var phone = (user.value.phone || '').trim();\n\n      if (!username || !password || !confirmPassword) {\n        ElMessage.error('用户名或密码不能为空');\n        return;\n      }\n\n      if (!passwordRule.test(password)) {\n        ElMessage.error('密码必须为6-12位，且同时包含字母、数字和特殊符号');\n        return;\n      }\n\n      if (!phone) {\n        ElMessage.error('联系方式不能为空');\n        return;\n      }\n\n      if (!/^[0-9\\-+() ]{7,20}$/.test(phone)) {\n        ElMessage.error('联系方式格式不正确');\n        return;\n      }\n\n      if (user.value.password !== user.value.confirmPassword) {\n        ElMessage.error('两次密码不一致');\n        return;\n      }\n\n      var form = {};\n      Object.assign(form, user.value);\n      form.password = md5(user.value.password);\n      request.post('/register', form).then(function (res) {\n        if (res.code === '200') {\n          ElMessage.success('注册成功');\n          router.push('/login');\n        } else {\n          ElMessage.error(res.msg);\n        }\n      });\n    };\n\n    var __returned__ = {\n      router: router,\n      user: user,\n      passwordRule: passwordRule,\n      onSubmit: onSubmit,\n      ref: ref,\n\n      get useRouter() {\n        return useRouter;\n      },\n\n      get ElMessage() {\n        return ElMessage;\n      },\n\n      get md5() {\n        return md5;\n      },\n\n      get request() {\n        return request;\n      }\n\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"mappings":";;;AA6DA,SAASA,GAAT,QAAoB,KAApB;AACA,SAASC,SAAT,QAA0B,YAA1B;AACA,SAASC,SAAT,QAA0B,cAA1B;AACA,OAAOC,GAAP,MAAgB,QAAhB;AACA,OAAOC,OAAP,MAAoB,iBAApB;;;;;;;;AAEA,QAAMC,MAAM,GAAGJ,SAAS,EAAxB;AAEA,QAAMK,IAAI,GAAGN,GAAG,CAAC;AACfO,cAAQ,EAAE,EADK;AAEfC,WAAK,EAAE,EAFQ;AAGfC,cAAQ,EAAE,EAHK;AAIfC,qBAAe,EAAE;AAJF,KAAD,CAAhB;AAOA,QAAMC,YAAY,GAAG,4GAArB;;AAEA,QAAMC,QAAQ,GAAG,SAAXA,QAAW,GAAM;AACrB,UAAML,QAAQ,GAAG,CAACD,IAAI,CAACO,KAAL,CAAWN,QAAX,IAAuB,EAAxB,EAA4BO,IAA5B,EAAjB;AACA,UAAML,QAAQ,GAAG,CAACH,IAAI,CAACO,KAAL,CAAWJ,QAAX,IAAuB,EAAxB,EAA4BK,IAA5B,EAAjB;AACA,UAAMJ,eAAe,GAAG,CAACJ,IAAI,CAACO,KAAL,CAAWH,eAAX,IAA8B,EAA/B,EAAmCI,IAAnC,EAAxB;AACA,UAAMN,KAAK,GAAG,CAACF,IAAI,CAACO,KAAL,CAAWL,KAAX,IAAoB,EAArB,EAAyBM,IAAzB,EAAd;;AAEA,UAAI,CAACP,QAAD,IAAa,CAACE,QAAd,IAA0B,CAACC,eAA/B,EAAgD;AAC9CR,iBAAS,CAACa,KAAV,CAAgB,YAAhB;AACA;AACD;;AACD,UAAI,CAACJ,YAAY,CAACK,IAAb,CAAkBP,QAAlB,CAAL,EAAkC;AAChCP,iBAAS,CAACa,KAAV,CAAgB,4BAAhB;AACA;AACD;;AACD,UAAI,CAACP,KAAL,EAAY;AACVN,iBAAS,CAACa,KAAV,CAAgB,UAAhB;AACA;AACD;;AACD,UAAI,CAAC,sBAAsBC,IAAtB,CAA2BR,KAA3B,CAAL,EAAwC;AACtCN,iBAAS,CAACa,KAAV,CAAgB,WAAhB;AACA;AACD;;AACD,UAAIT,IAAI,CAACO,KAAL,CAAWJ,QAAX,KAAwBH,IAAI,CAACO,KAAL,CAAWH,eAAvC,EAAwD;AACtDR,iBAAS,CAACa,KAAV,CAAgB,SAAhB;AACA;AACD;;AAED,UAAIE,IAAI,GAAG,EAAX;AACAC,YAAM,CAACC,MAAP,CAAcF,IAAd,EAAoBX,IAAI,CAACO,KAAzB;AACAI,UAAI,CAACR,QAAL,GAAgBN,GAAG,CAACG,IAAI,CAACO,KAAL,CAAWJ,QAAZ,CAAnB;AAEAL,aAAO,CAACgB,IAAR,CAAa,WA