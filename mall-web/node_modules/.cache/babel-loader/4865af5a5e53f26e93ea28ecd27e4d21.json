;\n        } else {\n          _this2.$message.error(res.msg || \"加载失败\");\n        }\n      });\n    },\n    handlePageChange: function handlePageChange(page) {\n      this.pageNum = page;\n      this.load();\n    },\n    openDetail: function openDetail(id) {\n      var _this3 = this;\n\n      this.request.get(\"/api/afterSale/\" + id).then(function (res) {\n        if (res.code === \"200\") {\n          _this3.detail = res.data;\n          _this3.detailVisible = true;\n        } else {\n          _this3.$message.error(res.msg || \"加载失败\");\n        }\n      });\n    }\n  }\n};","map":{"version":3,"mappings":";AAgFA,eAAe;AACbA,MAAI,EAAE,WADO;AAEbC,MAFa,kBAEN;AACL,WAAO;AACLC,UAAI,EAAE;AACJC,eAAO,EAAE,EADL;AAEJC,YAAI,EAAE,EAFF;AAGJC,cAAM,EAAE;AAHJ,OADD;AAMLC,eAAS,EAAE,EANN;AAOLC,aAAO,EAAE,CAPJ;AAQLC,cAAQ,EAAE,EARL;AASLC,WAAK,EAAE,CATF;AAULC,mBAAa,EAAE,KAVV;AAWLC,YAAM,EAAE;AAXH,KAAP;AAaD,GAhBY;AAiBbC,SAjBa,qBAiBH;AACR,SAAKV,IAAL,CAAUC,OAAV,GAAoB,KAAKU,MAAL,CAAYC,KAAZ,CAAkBX,OAAlB,IAA6B,EAAjD;AACA,SAAKY,IAAL;AACD,GApBY;AAqBbC,SAAO,EAAE;AACPC,aADO,uBACK;AACV,WAAKf,IAAL,GAAY;AAAEC,eAAO,EAAE,KAAKU,MAAL,CAAYC,KAAZ,CAAkBX,OAAlB,IAA6B,EAAxC;AAA4CC,YAAI,EAAE,EAAlD;AAAsDC,cAAM,EAAE;AAA9D,OAAZ;AACD,KAHM;AAIPa,UAJO,oBAIE;AAAA;;AACP,UAAMf,OAAM,GAAI,CAAC,KAAKD,IAAL,CAAUC,OAAV,IAAqB,EAAtB,EAA0BgB,IAA1B,EAAhB;AACA,UAAMf,IAAG,GAAI,CAAC,KAAKF,IAAL,CAAUE,IAAV,IAAkB,EAAnB,EAAuBe,IAAvB,EAAb;AACA,UAAMd,MAAK,GAAI,CAAC,KAAKH,IAAL,CAAUG,MAAV,IAAoB,EAArB,EAAyBc,IAAzB,EAAf;;AACA,UAAI,CAAChB,OAAL,EAAc;AACZ,aAAKiB,QAAL,CAAcC,KAAd,CAAoB,UAApB;AACA;AACF;;AACA,UAAI,CAACjB,IAAL,EAAW;AACT,aAAKgB,QAAL,CAAcC,KAAd,CAAoB,UAApB;AACA;AACF;;AACA,UAAI,CAAChB,MAAL,EAAa;AACX,aAAKe,QAAL,CAAcC,KAAd,CAAoB,UAApB;AACA;AACF;;AACA,WAAKC,OAAL,CAAaC,IAAb,CAAkB,gBAAlB,EAAoC;AAAEpB,eAAO,EAAPA,OAAF;AAAWC,YAAI,EAAJA,IAAX;AAAiBC,cAAK,EAALA;AAAjB,OAApC,EAA+DmB,IAA/D,CAAoE,UAACC,GAAD,EAAS;AAC3E,YAAIA,GAAG,CAACC,IAAJ,KAAa,KAAjB,EAAwB;AACtB,eAAI,CAACN,QAAL,CAAcO,OAAd,CAAsB,MAAtB;;AACA,eAAI,CAACV,SAAL;;AACA,eAAI,CAACV,OAAL,GAAe,