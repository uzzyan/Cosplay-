{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\nimport API from \"@/utils/request\";\nimport addressBox from \"@/components/AddressBox\";\nexport default {\n  name: \"AddressManage\",\n\n  data() {\n    return {\n      userId: 0,\n      addressData: [],\n      // 临时存储地址信息\n      address: {},\n      dialogFormVisible: false,\n      dialogTitle: \"新增地址\"\n    };\n  },\n\n  components: {\n    \"address-box\": addressBox\n  },\n\n  created() {\n    this.loadAddress();\n  },\n\n  methods: {\n    addAddress() {\n      this.address = {};\n      this.dialogTitle = \"新增地址\";\n      this.dialogFormVisible = true;\n    },\n\n    editAddress(item) {\n      // 深拷贝\n      this.address = JSON.parse(JSON.stringify(item));\n      this.dialogTitle = \"编辑地址\";\n      this.dialogFormVisible = true;\n    },\n\n    deleteAddress(item) {\n      this.$confirm(\"您确认删除该地址吗?\", \"提示\", {\n        confirmButtonText: \"确定\",\n        cancelButtonText: \"取消\",\n        type: \"warning\"\n      }).then(() => {\n        API.delete(\"api/address/\" + item.id).then(res => {\n          if (res.code === \"200\") {\n            this.$message.success(\"删除地址成功\");\n            this.loadAddress();\n          } else {\n            this.$message.error(res.msg || \"删除失败\");\n          }\n        });\n      }).catch(() => {// 用户取消删除\n      });\n    },\n\n    saveAddress() {\n      // 表单验证\n      if (!this.address.linkUser || !this.address.linkUser.trim()) {\n        this.$message.warning(\"请输入收货人姓名\");\n        return;\n      }\n\n      if (!this.address.linkPhone || !this.address.linkPhone.trim()) {\n        this.$message.warning(\"请输入联系电话\");\n        return;\n      }\n\n      if (!/^\\d{11}$/.test(this.address.linkPhone)) {\n        this.$message.warning(\"联系电话必须为11位数字\");\n        return;\n      }\n\n      if (!this.address.linkAddress || !this.address.linkAddress.trim()) {\n        this.$message.warning(\"请输入收货地址\");\n        return;\n      }\n\n      this.address.userId = this.userId;\n      API.post(\"/api/address\", this.address).then(res => {\n        if (res.code === \"200\") {\n          this.$message.success(\"保存成功\");\n          this.loadAddress();\n          this.dialogFormVisible = false;\n        } else {\n          this.$message.error(res.msg || \"保存失败\");\n        }\n      });\n    },\n\n    loadAddress() {\n      API.get(\"/userid\").then(res => {\n        this.userId = res;\n        API.get(\"/api/address/\" + res).then(res => {\n          if (res.code === \"200\") {\n            this.addressData = res.data;\n          }\n        });\n      });\n    }\n\n  }\n};","map":{"version":3,"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA6GA;AACA;AAEA;AACAA,uBADA;;AAEAC;AACA;AACAC,eADA;AAEAC,qBAFA;AAGA;AACAC,iBAJA;AAKAC,8BALA;AAMAC;AANA;AAQA,GAXA;;AAYAC;AACA;AADA,GAZA;;AAeAC;AACA;AACA,GAjBA;;AAkBAC;AACAC;AACA;AACA;AACA;AACA,KALA;;AAMAC;AACA;AACA;AACA;AACA;AACA,KAXA;;AAYAC;AACA;AACAC,+BADA;AAEAC,8BAFA;AAGAC;AAHA,SAIAC,IAJA,CAIA;AACAC;AACA;AACA;AACA;AACA,WAHA,MAGA;AACA;AACA;AACA,SAPA;AAQA,OAbA,EAaAC,KAbA,CAaA,OACA;AACA,OAfA;AAgBA,KA7BA;;AA8BAC;AACA;AACA;AACA;AACA;AACA;;AACA;AACA;AACA;AACA;;AACA;AACA;AACA;AACA;;AACA;AACA;AACA;AACA;;AAEA;AACAF;AACA;AACA;AACA;AACA;AACA,SAJA,MAIA;AACA;AACA;AACA,OARA;AASA,KA3DA;;AA4DAG;AACAH;AACA;AACAA;AACA;AACA;AACA;AACA,SAJA;AAKA,OAPA;AAQA;;AArEA;AAlBA","names":["name","data","userId","addressData","address","dialogFormVisible","dialogTitle","components","created","methods","addAddress","editAddress","deleteAddress","confirmButtonText","cancelButtonText","type","then","API","catch","saveAddress","loadAddress"],"sourceRoot":"src/views/front","sources":["AddressManage.vue"],"sourcesContent":["<template>\n  <div class=\"address-manage-container\">\n    <div class=\"content-wrapper\">\n      <!-- 页面标题栏 -->\n      <div class=\"page-header\">\n        <div class=\"header-left\">\n          <i class=\"el-icon-location header-icon\"></i>\n          <h2 class=\"page-title\">我的收货地址</h2>\n          <span class=\"address-count\">共 {{ addressData.length }} 个地址</span>\n        </div>\n        <el-button \n          type=\"primary\" \n          size=\"medium\"\n          icon=\"el-icon-plus\"\n          @click=\"addAddress\"\n          class=\"add-btn\"\n        >\n          新增地址\n        </el-button>\n      </div>\n      \n      <!-- 地址列表 -->\n      <div v-if=\"addressData.length > 0\">\n        <span v-for=\"(item, index) in addressData\" :key=\"index\">\n          <address-box\n            :address=\"item\"\n            :selected=\"false\"\n            style=\"margin-right: 20px; margin-bottom: 20px;\"\n            @edit=\"editAddress(item)\"\n            @delete=\"deleteAddress(item)\"\n          ></address-box>\n        </span>\n      </div>\n      \n      <!-- 无地址提示 -->\n      <div v-else class=\"empty-state\">\n        <div class=\"empty-icon\">\n          <i class=\"el-icon-map-location\"></i>\n        </div>\n        <p class=\"empty-title\">暂无收货地址</p>\n        <p class=\"empty-desc\">添加收货地址，让购物更便捷</p>\n        <el-button \n          type=\"primary\" \n          size=\"medium\"\n          icon=\"el-icon-plus\"\n          @click=\"addAddress\"\n          class=\"empty-add-btn\"\n        >\n          添加收货地址\n        </el-button>\n      </div>\n\n      <!-- 地址弹窗 -->\n      <el-dialog \n        :title=\"dialogTitle\" \n        :visible.sync=\"dialogFormVisible\" \n        width=\"540px\"\n        :close-on-click-modal=\"false\"\n        class=\"address-dialog\"\n      >\n        <el-form \n          :model=\"address\" \n          label-width=\"100px\" \n          label-position=\"right\"\n          class=\"address-form\"\n        >\n          <el-form-item label=\"收货人\" required>\n            <el-input \n              v-model=\"address.linkUser\" \n              autocomplete=\"off\"\n              placeholder=\"请输入收货人姓名\"\n              prefix-icon=\"el-icon-user\"\n            ></el-input>\n          </el-form-item>\n          <el-form-item label=\"联系电话\" required>\n            <el-input \n              v-model=\"address.linkPhone\" \n              autocomplete=\"off\"\n              placeholder=\"请输入11位联系电话\"\n              prefix-icon=\"el-icon-phone\"\n              maxlength=\"11\"\n              show-word-limit\n              @input=\"address.linkPhone = address.linkPhone.replace(/[^\\d]/g, '')\"\n            ></el-input>\n          </el-form-item>\n          <el-form-item label=\"收货地址\" required>\n            <el-input\n              type=\"textarea\"\n              :rows=\"4\"\n              v-model=\"address.linkAddress\"\n              autocomplete=\"off\"\n              placeholder=\"请输入详细地址，例如：XX省XX市XX区XX街道XX小区XX号楼XX单元XX室\"\n            ></el-input>\n          </el-form-item>\n        </el-form>\n        <div slot=\"footer\" class=\"dialog-footer\">\n          <el-button @click=\"dialogFormVisible = false\" size=\"medium\">\n            <i class=\"el-icon-close\"></i> 取消\n          </el-button>\n          <el-button type=\"primary\" @click=\"saveAddress\" size=\"medium\">\n            <i class=\"el-icon-check\"></i> 确定\n          </el-button>\n        </div>\n      </el-dialog>\n    </div>\n  </div>\n</template>\n\n<script>\nimport API from \"@/utils/request\";\nimport addressBox from \"@/components/AddressBox\";\n\nexport default {\n  name: \"AddressManage\",\n  data() {\n    return {\n      userId: 0,\n      addressData: [],\n      // 临时存储地址信息\n      address: {},\n      dialogFormVisible: false,\n      dialogTitle: \"新增地址\",\n    };\n  },\n  components: {\n    \"address-box\": addressBox,\n  },\n  created() {\n    this.loadAddress();\n  },\n  methods: {\n    addAddress() {\n      this.address = {};\n      this.dialogTitle = \"新增地址\";\n      this.dialogFormVisible = true;\n    },\n    editAddress(item) {\n      // 深拷贝\n      this.address = JSON.parse(JSON.stringify(item));\n      this.dialogTitle = \"编辑地址\";\n      this.dialogFormVisible = true;\n    },\n    deleteAddress(item) {\n      this.$confirm(\"您确认删除该地址吗?\", \"提示\", {\n        confirmButtonText: \"确定\",\n        cancelButtonText: \"取消\",\n        type: \"warning\",\n      }).then(() => {\n        API.delete(\"api/address/\" + item.id).then((res) => {\n          if (res.code === \"200\") {\n            this.$message.success(\"删除地址成功\");\n            this.loadAddress();\n          } else {\n            this.$message.error(res.msg || \"删除失败\");\n          }\n        });\n      }).catch(() => {\n        // 用户取消删除\n      });\n    },\n    saveAddress() {\n      // 表单验证\n      if (!this.address.linkUser || !this.address.linkUser.trim()) {\n        this.$message.warning(\"请输入收货人姓名\");\n        return;\n      }\n      if (!this.address.linkPhone || !this.address.linkPhone.trim()) {\n        this.$message.warning(\"请输入联系电话\");\n        return;\n      }\n      if (!/^\\d{11}$/.test(this.address.linkPhone)) {\n        this.$message.warning(\"联系电话必须为11位数字\");\n        return;\n      }\n      if (!this.address.linkAddress || !this.address.linkAddress.trim()) {\n        this.$message.warning(\"请输入收货地址\");\n        return;\n      }\n\n      this.address.userId = this.userId;\n      API.post(\"/api/address\", this.address).then((res) => {\n        if (res.code === \"200\") {\n          this.$message.success(\"保存成功\");\n          this.loadAddress();\n          this.dialogFormVisible = false;\n        } else {\n          this.$message.error(res.msg || \"保存失败\");\n        }\n      });\n    },\n    loadAddress() {\n      API.get(\"/userid\").then((res) => {\n        this.userId = res;\n        API.get(\"/api/address/\" + res).then((res) => {\n          if (res.code === \"200\") {\n            this.addressData = res.data;\n          }\n        });\n      });\n    },\n  },\n};\n</script>\n\n<style scoped>\n.address-manage-container {\n  min-height: calc(100vh - 80px);\n  padding: 30px 0;\n}\n\n.content-wrapper {\n  width: 90%;\n  max-width: 1400px;\n  margin: 0 auto;\n  background-color: white;\n  border-radius: 16px;\n  padding: 30px;\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\n}\n\n/* 页面标题栏 */\n.page-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 20px;\n  margin-bottom: 30px;\n  border-bottom: 3px solid #f0f0f0;\n  background: #f8f9fa;\n  border-radius: 8px;\n}\n\n.header-left {\n  display: flex;\n  align-items: center;\n  gap: 15px;\n}\n\n.header-icon {\n  font-size: 32px;\n  color: #409EFF;\n}\n\n.page-title {\n  margin: 0;\n  font-size: 26px;\n  font-weight: 600;\n  color: #303133;\n}\n\n.address-count {\n  background: #409EFF;\n  color: white;\n  padding: 5px 15px;\n  border-radius: 20px;\n  font-size: 14px;\n  font-weight: 500;\n}\n\n.add-btn {\n  font-size: 16px;\n  padding: 12px 28px;\n  border-radius: 8px;\n  font-weight: 500;\n}\n\n\n/* 空状态 */\n.empty-state {\n  text-align: center;\n  padding: 80px 20px;\n}\n\n.empty-icon {\n  margin-bottom: 20px;\n}\n\n.empty-icon i {\n  font-size: 120px;\n  color: #dcdfe6;\n  animation: float 3s ease-in-out infinite;\n}\n\n@keyframes float {\n  0%, 100% {\n    transform: translateY(0);\n  }\n  50% {\n    transform: translateY(-10px);\n  }\n}\n\n.empty-title {\n  font-size: 22px;\n  color: #909399;\n  margin: 20px 0 10px;\n  font-weight: 500;\n}\n\n.empty-desc {\n  font-size: 16px;\n  color: #c0c4cc;\n  margin-bottom: 30px;\n}\n\n.empty-add-btn {\n  padding: 12px 32px;\n  font-size: 16px;\n  border-radius: 8px;\n}\n\n/* 对话框样式 */\n.address-form {\n  padding: 20px 30px 10px;\n}\n\n.dialog-footer {\n  display: flex;\n  justify-content: flex-end;\n  gap: 10px;\n  padding: 20px 30px;\n}\n\n.dialog-footer .el-button {\n  padding: 10px 24px;\n  font-size: 15px;\n  border-radius: 6px;\n}\n\n/* 响应式设计 */\n@media (max-width: 768px) {\n  .address-grid {\n    grid-template-columns: 1fr;\n  }\n  \n  .page-header {\n    flex-direction: column;\n    gap: 15px;\n  }\n  \n  .header-left {\n    flex-direction: column;\n    text-align: center;\n  }\n  \n  .content-wrapper {\n    width: 95%;\n    padding: 20px;\n  }\n}\n</style>\n\n"]},"metadata":{},"sourceType":"module"}