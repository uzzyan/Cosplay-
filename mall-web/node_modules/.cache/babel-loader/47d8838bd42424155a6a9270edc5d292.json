{"ast":null,"code":"export default {\n  name: \"ManageAfterSale\",\n  data: function data() {\n    return {\n      tableData: [],\n      pageNum: 1,\n      pageSize: 10,\n      total: 0,\n      orderNo: \"\",\n      type: \"\",\n      status: \"\",\n      detailVisible: false,\n      detail: null\n    };\n  },\n  created: function created() {\n    this.load();\n  },\n  methods: {\n    load: function load() {\n      var _this = this;\n\n      this.request.get(\"/api/afterSale/page\", {\n        params: {\n          pageNum: this.pageNum,\n          pageSize: this.pageSize,\n          orderNo: this.orderNo,\n          type: this.type,\n          status: this.status\n        }\n      }).then(function (res) {\n        if (res.code === \"200\") {\n          _this.tableData = res.data.records || [];\n          _this.total = res.data.total || 0;\n        } else {\n          _this.$message.error(res.msg || \"加载失败\");\n        }\n      });\n    },\n    handlePageChange: function handlePageChange(page) {\n      this.pageNum = page;\n      this.load();\n    },\n    openDetail: function openDetail(id) {\n      var _this2 = this;\n\n      this.request.get(\"/api/afterSale/\" + id).then(function (res) {\n        if (res.code === \"200\") {\n          _this2.detail = res.data;\n          _this2.detailVisible = true;\n        } else {\n          _this2.$message.error(res.msg || \"加载失败\");\n        }\n      });\n    },\n    handle: function handle(row) {\n      var _this3 = this;\n\n      this.request.put(\"/api/afterSale/handle\", {\n        id: row.id,\n        status: row.status\n      }).then(function (res) {\n        if (res.code === \"200\") {\n          _this3.$message.success(\"处理成功\");\n\n          _this3.load();\n        } else {\n          _this3.$message.error(res.msg || \"处理失败\");\n        }\n      });\n    }\n  }\n};","map":{"version":3,"mappings":"AA4EA,eAAe;AACbA,MAAI,EAAE,iBADO;AAEbC,MAFa,kBAEN;AACL,WAAO;AACLC,eAAS,EAAE,EADN;AAELC,aAAO,EAAE,CAFJ;AAGLC,cAAQ,EAAE,EAHL