{"ast":null,"code":"import { ref, watch, onMounted } from 'vue';\nimport { useRoute, useRouter } from 'vue-router';\nimport { useStore } from 'vuex';\nimport { ElMessage } from 'element-plus';\nimport request from '@/utils/request';\nexport default {\n  __name: 'GoodList',\n  setup: function setup(__props, _ref) {\n    var __expose = _ref.expose;\n\n    __expose();\n\n    var store = useStore();\n    var route = useRoute();\n    var router = useRouter();\n    var icons = ref([]);\n    var total = ref(0);\n    var pageSize = ref(8);\n    var currentPage = ref(1);\n    var categoryId = ref(null); // 修复：使用null而不是Number\n\n    var searchText = ref('');\n    var good = ref([]);\n    var baseApi = store.state.baseApi;\n\n    var loadCategories = function loadCategories() {\n      request.get('/api/icon').then(function (res) {\n        if (res.code === '200') {\n          icons.value = res.data;\n        } else {\n          ElMessage.error(res.msg || '加载分类失败');\n        }\n      }).catch(function (err) {\n        console.error('加载分类失败:', err);\n        ElMessage.error('加载分类失败，请重试');\n      });\n    };\n\n    var loadAll = function loadAll() {\n      // 清除所有筛选条件，查看全部商品\n      searchText.value = '';\n      categoryId.value = null;\n      currentPage.value = 1;\n      router.push({\n        path: '/goodlist'\n      });\n      load();\n    };\n\n    var handleCurrentPage = function handleCurrentPage(currentPageVal) {\n      currentPage.value = currentPageVal;\n      load();\n    };\n\n    var load = function load(categoryIdVal) {\n      if (categoryIdVal != undefined) {\n        categoryId.value = categoryIdVal; // 选择分类时清空搜索，使搜索和分类独立\n\n        searchText.value = '';\n        currentPage.value = 1; // 重置到第一页\n\n        router.push({\n          path: '/goodlist',\n          query: {\n            categoryId: categoryId.value\n          }\n        });\n      }\n\n      request.get('/api/good/page', {\n        params: {\n          pageNum: currentPage.value,\n          pageSize: pageSize.value,\n          searchText: searchText.value,\n          categoryId: categoryId.value\n        }\n      }).then(function (res) {\n        if (res.code === '200') {\n          total.value = res.data.total;\n          good.value = res.data.records;\n        } else {\n          ElMessage.error(res.msg || '加载商品失败');\n        }\n      }).catch(function (err) {\n        console.error('加载商品失败:', err);\n        ElMessage.error('加载商品失败，请重试');\n      });\n    }; // 监听路由变化，当从导航栏搜索时更新数据\n\n\n    watch(function () {\n      return route.query;\n    }, function (to, from) {\n      if (to.searchText !== from.searchText || to.categoryId !== from.categoryId) {\n        searchText.value = to.searchText;\n        categoryId.value = to.categoryId;\n        currentPage.value = 1; // 重置到第一页\n\n        load();\n      }\n    });\n    onMounted(function () {\n      //二者一般不同时存在\n      searchText.value = route.query.searchText;\n      categoryId.value = route.query.categoryId;\n      loadCategories();\n      load();\n    });\n    var __returned__ = {\n      store: store,\n      route: route,\n      router: router,\n      icons: icons,\n      total: total,\n      pageSize: pageSize,\n      currentPage: currentPage,\n      categoryId: categoryId,\n      searchText: searchText,\n      good: good,\n      baseApi: baseApi,\n      loadCategories: loadCategories,\n      loadAll: loadAll,\n      handleCurrentPage: handleCurrentPage,\n      load: load,\n      ref: ref,\n      watch: watch,\n      onMounted: onMounted,\n\n      get useRoute() {\n        return useRoute;\n      },\n\n      get useRouter() {\n        return useRouter;\n      },\n\n      get useStore() {\n        return useStore;\n      },\n\n      get ElMessage() {\n        return ElMessage;\n      },\n\n      get request() {\n        return request;\n      }\n\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"ve