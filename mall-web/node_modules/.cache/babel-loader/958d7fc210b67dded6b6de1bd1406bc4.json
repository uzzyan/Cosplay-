{"ast":null,"code":"import incomeItem from \"@/components/IncomeItem\";\nexport default {\n  name: \"IncomeRank\",\n  data: function data() {\n    return {\n      num: 10,\n      good: [],\n      categories: []\n    };\n  },\n  components: {\n    'income-item': incomeItem\n  },\n  created: function created() {\n    var _this = this;\n\n    //先查询分类id和名称\n    this.request.get(\"/api/category\").then(function (res) {\n      if (res.code === '200') {\n        _this.categories = res.data;\n      } //获取排行数据\n\n\n      _this.request.get(\"/api/good/rank/\", {\n        params: {\n          num: _this.num\n        }\n      }).then(function (res) {\n        if (res.code === '200') {\n          _this.good = res.data;\n        }\n      });\n    });\n  }\n};","map":{"version":3,"mappings":"AAcA,OAAOA,UAAP,MAAuB,yBAAvB;AACA,eAAe;AACbC,MAAI,EAAE,YADO;AAEbC,MAFa,kBAEP;AACJ,WAAM;AACJC,SAAG,EAAE,EADD;AAEJC,UAAI,EAAE,EAFF;AAGJC,gBAAU,EAAE;AAHR,KAAN;AAKD,GARY;AASbC,YAAU,EAAC;AACT,mBAAeN;AADN,GATE;AAYbO,SAZa,qBAYH;AAAA;;AACR;AACA,SAAKC,OAAL,CAAaC,GAAb,CAAiB,eAAjB,EAAkCC,IAAlC,CAAuC,aAAG,EAAG;AAC3C,UAAIC,GAAG,CAACC,IAAJ,KAAa,KAAjB,EAAwB;AACtB,aAAI,CAACP,UAAL,GAAkBM,GAAG,CAACT,IAAtB;AACF,OAH2C,CAI3C;;;AACA,WAAI,CAACM,OAAL,CAAaC,GAAb,CAAiB,iBAAjB,EAAmC;AAACI,cAAM,EAAC;AAACV,aAAG,EAAE,KAAI,CAACA;AAAX;AAAR,OAAnC,EAA6DO,IAA7D,CAAkE,aAAG,EAAE;AACrE,YAAGC,GAAG,CAACC,IAAJ,KAAW,KAAd,EAAoB;AAClB,eAAI,CAACR,IAAL,GAAYO,GAAG,CAACT,IAAhB;AACF;AACD,OAJD;AAKD,KAVD;AAYD;AA1BY,CAAf","names":["incomeItem","name","data","num","good","categories","components","created","request","get","then","res","code","params"],"sourceRoot":"","sources":["C:\\q_code4.12\\cosplay_mall(qoder)\\mall-web\\src\\views\\manage\\income\\IncomeRank.vue"],"sourcesContent":["<!--\r\n * @Description: \r\n * @Author: gzc\r\n * @Date: 2024-03-21 15:27:05\r\n-->\r\n<template >\r\n  <div style=\"width: 58%;height:100%;margin: 20px auto;\">\r\n    <span v-for=\"(good,index) in good\" :key=\"index\">\r\n      <income-item :index=\"index+1\" :good=\"good\" :categories=\"categories\" style=\"margin-bottom: 2px\"></income-item>\r\n    </span>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport incomeItem from \"@/components/IncomeItem\";\r\nexport default {\r\n  name: \"IncomeRank\",\r\n  data(){\r\n    return{\r\n      num: 10,\r\n      good: [],\r\n      categories: [],\r\n    }\r\n  },\r\n  components:{\r\n    'income-item': incomeItem,\r\n  },\r\n  created() {\r\n    //先查询分类id和名称\r\n    this.request.get(\"/api/category\").then(res=> {\r\n      if (res.code === '200') {\r\n        this.categories = res.data;\r\n      }\r\n      //获取排行数据\r\n      this.request.get(\"/api/good/rank/\",{params:{num: this.num}}).then(res=>{\r\n        if(res.code==='200'){\r\n          this.good = res.data;\r\n        }\r\n      })\r\n    })\r\n\r\n  },\r\n\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n\r\n</style>"]},"metadata":{},"sourceType":"module"}