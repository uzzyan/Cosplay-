{"ast":null,"code":"import \"core-js/modules/es.string.trim.js\";\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\nexport default {\n  name: \"Navagation\",\n  props: {\n    user: Object,\n    loginStatus: Boolean,\n    role: String\n  },\n  data: function data() {\n    return {\n      activeIndex: \"1\",\n      activeIndex2: \"1\",\n      baseApi: this.$store.state.baseApi,\n      searchText: \"\"\n    };\n  },\n  methods: {\n    logout: function logout() {\n      localStorage.removeItem(\"user\");\n      this.$message.success(\"退出成功\");\n      window.location.href = '/';\n    },\n    handleSearch: function handleSearch() {\n      if (this.searchText && this.searchText.trim()) {\n        this.$router.push({\n          path: \"/goodList\",\n          query: {\n            searchText: this.searchText.trim()\n          }\n        });\n      }\n    }\n  }\n};","map":{"version":3,"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA0GA;AACAA,oBADA;AAEAC;AACAC,gBADA;AAEAC,wBAFA;AAGAC;AAHA,GAFA;AAOAC,MAPA,kBAOA;AACA;AACAC,sBADA;AAEAC,uBAFA;AAGAC,wCAHA;AAIAC;AAJA;AAMA,GAdA;AAeAC;AACAC,UADA,oBACA;AACAC;AACA;AACAC;AACA,KALA;AAMAC,gBANA,0BAMA;AACA;AACA;AACAC,2BADA;AAEAC;AAAAP;AAAA;AAFA;AAIA;AACA;AAbA;AAfA","names":["name","props","user","loginStatus","role","data","activeIndex","activeIndex2","baseApi","searchText","methods","logout","localStorage","window","handleSearch","path","query"],"sourceRoot":"src/components","sources":["Navagation.vue"],"sourcesContent":["\r\n<template>\r\n  <div class=\"navagation\">\r\n    <el-row>\r\n      <el-col :span=\"3\">\r\n        <div style=\"font-size: 20px; font-weight: bold; text-align: center\">\r\n          <a href=\"/\"><i class=\"iconfont icon-r-home\" style=\"font-size: 24px;\"></i> U次元 - Cosplay服装商城</a>\r\n        </div>\r\n      </el-col>\r\n      <el-col :span=\"13\">\r\n        <el-menu\r\n          :default-active=\"activeIndex\"\r\n          class=\"el-menu-demo\"\r\n          mode=\"horizontal\"\r\n          router\r\n        >\r\n          <el-menu-item index=\"/\" class=\"menu-item\">商城首页</el-menu-item>\r\n\r\n          <el-menu-item index=\"/goodList\" class=\"menu-item\"\r\n            >所有商品</el-menu-item\r\n          >\r\n          <el-menu-item index=\"/cart\" class=\"menu-item\"\r\n            >购物车</el-menu-item\r\n          >\r\n          <el-menu-item index=\"/orderlist\" class=\"menu-item\"\r\n            >我的订单</el-menu-item\r\n          >\r\n          <el-menu-item index=\"/addressManage\" class=\"menu-item\"\r\n            >地址管理</el-menu-item\r\n          >\r\n          <el-menu-item index=\"/message\" class=\"menu-item\" v-show=\"loginStatus\"\r\n            >在线留言</el-menu-item\r\n          >\r\n          <el-menu-item index=\"/afterSale\" class=\"menu-item\" v-show=\"loginStatus\"\r\n            >售后申请</el-menu-item\r\n          >\r\n          <el-menu-item\r\n            index=\"/manage\"\r\n            class=\"menu-item\"\r\n            v-show=\"role === 'admin'\"\r\n            >后台管理</el-menu-item\r\n          >\r\n        </el-menu>\r\n      </el-col>\r\n      <el-col :span=\"5\">\r\n        <!-- 搜索框 -->\r\n        <div class=\"nav-search\">\r\n          <el-input\r\n            v-model=\"searchText\"\r\n            placeholder=\"搜索商品\"\r\n            @keyup.enter.native=\"handleSearch\"\r\n            prefix-icon=\"el-icon-search\"\r\n            size=\"medium\"\r\n            clearable\r\n          >\r\n            <el-button\r\n              slot=\"append\"\r\n              icon=\"el-icon-search\"\r\n              @click=\"handleSearch\"\r\n            ></el-button>\r\n          </el-input>\r\n        </div>\r\n      </el-col>\r\n      <el-col :span=\"3\">\r\n        <!--         右上角个人信息-->\r\n        <el-dropdown style=\"cursor: pointer; float: right; margin-right: 20px\">\r\n          <span class=\"el-dropdown-link\">\r\n            <div style=\"display: inline-block\">\r\n              <img\r\n                v-if=\"user.avatarUrl != null\"\r\n                :src=\"baseApi + user.avatarUrl\"\r\n                class=\"avatar\"\r\n              />\r\n              {{ user.nickname }}\r\n              <i\r\n                class=\"el-icon-arrow-down el-icon--right\"\r\n                style=\"margin-right: 5px\"\r\n              ></i>\r\n            </div>\r\n          </span>\r\n          <!--          下拉菜单-->\r\n          <el-dropdown-menu slot=\"dropdown\" style=\"text-align: center\">\r\n            <el-dropdown-item>\r\n              <!--              传给前端，登录后跳转页面的path为 \"/\"-->\r\n              <div\r\n                @click=\"$router.push({ path: '/login', query: { to: '/' } })\"\r\n                v-show=\"!loginStatus\"\r\n              >\r\n                登录\r\n              </div>\r\n            </el-dropdown-item>\r\n            <el-dropdown-item v-show=\"loginStatus\">\r\n              <div @click=\"$router.push('/person')\">个人信息</div>\r\n            </el-dropdown-item>\r\n            <el-dropdown-item v-show=\"loginStatus\">\r\n              <div @click=\"logout\">退出</div>\r\n            </el-dropdown-item>\r\n          </el-dropdown-menu>\r\n        </el-dropdown>\r\n      </el-col>\r\n    </el-row>\r\n  </div>\r\n</template>\r\n\r\n\r\n<script>\r\nexport default {\r\n  name: \"Navagation\",\r\n  props: {\r\n    user: Object,\r\n    loginStatus: Boolean,\r\n    role: String,\r\n  },\r\n  data() {\r\n    return {\r\n      activeIndex: \"1\",\r\n      activeIndex2: \"1\",\r\n      baseApi: this.$store.state.baseApi,\r\n      searchText: \"\",\r\n    };\r\n  },\r\n  methods: {\r\n    logout() {\r\n      localStorage.removeItem(\"user\");\r\n      this.$message.success(\"退出成功\");\r\n      window.location.href = '/';\r\n    },\r\n    handleSearch() {\r\n      if (this.searchText && this.searchText.trim()) {\r\n        this.$router.push({\r\n          path: \"/goodList\",\r\n          query: { searchText: this.searchText.trim() },\r\n        });\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n<style>\r\na {\r\n  text-decoration: none;\r\n}\r\n.navagation {\r\n  width: 100%;\r\n  height: 60px;\r\n  line-height: 60px;\r\n  background-color: white;\r\n  overflow: hidden;\r\n}\r\n.avatar {\r\n  width: 45px;\r\n  border-radius: 5px;\r\n  position: relative;\r\n  top: 10px;\r\n  right: 5px;\r\n}\r\n.menu-item {\r\n  padding-left: 30px;\r\n  padding-right: 30px;\r\n  font-size: 16px !important;\r\n  font-weight: 500;\r\n}\r\n.nav-search {\r\n  padding: 10px 10px;\r\n  line-height: normal;\r\n}\r\n</style>\r\n"]},"metadata":{},"sourceType":"module"}