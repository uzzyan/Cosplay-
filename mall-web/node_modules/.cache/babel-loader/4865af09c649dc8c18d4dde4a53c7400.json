{"ast":null,"code":"import \"core-js/modules/es.json.stringify.js\";\nimport \"core-js/modules/es.string.trim.js\";\nimport \"core-js/modules/es.regexp.exec.js\";\nimport \"core-js/modules/es.regexp.test.js\";\nimport API from \"@/utils/request\";\nimport addressBox from \"@/components/AddressBox\";\nexport default {\n  name: \"AddressManage\",\n  data: function data() {\n    return {\n      userId: 0,\n      addressData: [],\n      // 临时存储地址信息\n      address: {},\n      dialogFormVisible: false,\n      dialogTitle: \"新增地址\"\n    };\n  },\n  components: {\n    \"address-box\": addressBox\n  },\n  created: function created() {\n    this.loadAddress();\n  },\n  methods: {\n    addAddress: function addAddress() {\n      this.address = {};\n      this.dialogTitle = \"新增地址\";\n      this.dialogFormVisible = true;\n    },\n    editAddress: function editAddress(item) {\n      // 深拷贝\n      this.address = JSON.parse(JSON.stringify(item));\n      this.dialogTitle = \"编辑地址\";\n      this.dialogFormVisible = true;\n    },\n    deleteAddress: function deleteAddress(item) {\n      var _this = this;\n\n      this.$confirm(\"您确认删除该地址吗?\", \"提示\", {\n        confirmButtonText: \"确定\",\n        cancelButtonText: \"取消\",\n        type: \"warning\"\n      }).then(function () {\n        API.delete(\"api/address/\" + item.id).then(function (res) {\n          if (res.code === \"200\") {\n            _this.$message.success(\"删除地址成功\");\n\n            _this.loadAddress();\n          } else {\n            _this.$message.error(res.msg || \"删除失败\");\n          }\n        });\n      }).catch(function () {// 用户取消删除\n      });\n    },\n    saveAddress: function saveAddress() {\n      var _this2 = this;\n\n      // 表单验证\n      if (!this.address.linkUser || !this.address.linkUser.trim()) {\n        this.$message.warning(\"请输入收货人姓名\");\n        return;\n      }\n\n      if (!this.address.linkPhone || !this.address.linkPhone.trim()) {\n        this.$message.warning(\"请输入联系电话\");\n        return;\n      }\n\n      if (!/^\\d{11}$/.test(this.address.linkPhone)) {\n        this.$message.warning(\"联系电话必须为11位数字\");\n        return;\n      }\n\n      if (!this.address.linkAddress || !this.address.linkAddress.trim()) {\n        this.$message.warning(\"请输入收货地址\");\n        return;\n      }\n\n      this.address.userId = this.userId;\n      API.post(\"/api/address\", this.address).then(function (res) {\n        if (res.code === \"200\") {\n          _this2.$message.success(\"保存成功\");\n\n          _this2.loadAddress();\n\n          _this2.dialogFormVisible = false;\n        } else {\n          _this2.$message.error(res.msg || \"保存失败\");\n        }\n      });\n    },\n    loadAddress: function loadAddress() {\n      var _this3 = this;\n\n      API.get(\"/userid\").then(function (res) {\n        _this3.userId = res;\n        API.get(\"/api/address/\" + res).then(function (res) {\n          if (res.code === \"200\") {\n            _this3.addressData = res.data;\n          }\n        });\n      });\n    }\n  }\n};","map":{"version":3,"mappings":";;;;AA+GA,OAAOA,GAAP,MAAgB,iBAAhB;AACA,OAAOC,UAAP,MAAuB,yBAAvB;AAEA,eAAe;AACbC,MAAI,EAAE,eADO;AAEbC,MAFa,kBAEN;AACL,WAAO;AACLC,YAAM,EAAE,CADH;AAELC,iBAAW,EAAE,EAFR;AAGL;AACAC,aAAO,EAAE,EAJJ;AAKLC,uBAAiB,EAAE,KALd;AAMLC,iBAAW,EAAE;AANR,KAAP;AAQD,GAXY;AAYbC,YAAU,EAAE;AACV,mBAAeR;AADL,GAZC;AAebS,SAfa,qBAeH;AACR,SAAKC,WAAL;AACD,GAjBY;AAkBbC,SAAO,EAAE;AACPC,cADO,wBACM;AACX,WAAKP,OAAL,GAAe,EAAf;AACA,WAAKE,WAAL,GAAmB,MAAnB;AACA,WAAKD,iBAAL,GAAyB,IAAzB;AACD,KALM;AAMPO,eANO,uBAMKC,IANL,EAMW;AAChB;AACA,WAAKT,OAAL,GAAeU,IAAI,CAACC,KAAL,CAAWD,IAAI,CAACE,SAAL,CAAeH,IAAf,CAAX,CAAf;AACA,WAAKP,WAAL,GAAmB,MAAnB;AACA,WAAKD,iBAAL,GAAyB,IAAzB;AACD,KAXM;AAYPY,iBAZO,yBAYOJ,IAZP,EAYa;AAAA;;AAClB,WAAKK,QAAL,CAAc,YAAd,EAA4B,IAA5B,EAAkC;AAChCC,yBAAiB,EAAE,IADa;AAEhCC,wBAAgB,EAAE,IAFc;AAGhCC,YAAI,EAAE;AAH0B,OAAlC,EAIGC,IAJH,CAIQ,YAAM;AACZxB,WAAG,CAACyB,MAAJ,CAAW,iBAAiBV,IAAI,CAACW,EAAjC,EAAqCF,IAArC,CAA0C,UAACG,GAAD,EAAS;AACjD,cAAIA,GAAG,CAACC,IAAJ,KAAa,KAAjB