-button style=\"margin-left: 10px\" type=\"primary\" @click=\"load\">查询</el-button>\n    </div>\n\n    <el-table :data=\"tableData\" border stripe style=\"width: 100%\">\n      <el-table-column prop=\"id\" label=\"ID\" width=\"80\"></el-table-column>\n      <el-table-column prop=\"userId\" label=\"用户ID\" width=\"90\"></el-table-column>\n      <el-table-column prop=\"title\" label=\"标题\"></el-table-column>\n      <el-table-column prop=\"contact\" label=\"联系方式\" width=\"160\"></el-table-column>\n      <el-table-column label=\"定制意愿\" width=\"90\">\n        <template slot-scope=\"scope\">\n          <span>{{ scope.row.customIntent ? \"有\" : \"无\" }}</span>\n        </template>\n      </el-table-column>\n      <el-table-column prop=\"createTime\" label=\"时间\" width=\"170\"></el-table-column>\n      <el-table-column label=\"回复\" width=\"90\">\n        <template slot-scope=\"scope\">\n          <span>{{ scope.row.reply ? \"已回复\" : \"未回复\" }}</span>\n        </template>\n      </el-table-column>\n      <el-table-column label=\"操作\" width=\"200\">\n        <template slot-scope=\"scope\">\n          <el-button type=\"text\" @click=\"openDetail(scope.row.id)\">详情</el-button>\n          <el-button type=\"text\" @click=\"openReply(scope.row)\">回复</el-button>\n          <el-popconfirm title=\"确定删除？\" @confirm=\"del(scope.row.id)\">\n            <el-button type=\"text\" slot=\"reference\" style=\"color: #f56c6c\">删除</el-button>\n          </el-popconfirm>\n        </template>\n      </el-table-column>\n    </el-table>\n\n    <div style=\"padding: 15px 0; text-align: right\">\n      <el-pagination\n        background\n        layout=\"prev, pager, next\"\n        :current-page=\"pageNum\"\n        :page-size=\"pageSize\"\n        :total=\"total\"\n        @current-change=\"handlePageChange\"\n      ></el-pagination>\n    </div>\n\n    <el-dialog title=\"留言详情\" :visible.sync=\"detailVisible\" width=\"750px\">\n      <div v-if=\"detail\">\n        <div style=\"margin-bottom: 10px\"><b>ID：</b>{{ detail.id }}</div>\n        <div style=\"margin-bottom: 10px\"><b>用户ID：</b>{{ detail.userId }}</div>\n        <div style=\"margin-bottom: 10px\"><b>标题：</b>{{ detail.title }}</div>\n        <div style=\"margin-bottom: 10px\"><b>联系方式：</b>{{ detail.contact }}</div>\n        <div style=\"margin-bottom: 10px\"><b>定制意愿：</b>{{ detail.customIntent ? \"有\" : \"无\" }}</div>\n        <div style=\"margin-bottom: 10px\"><b>内容：</b></div>\n        <div style=\"white-space: pre-wrap\">{{ detail.content }}</div>\n        <div style=\"margin: 14px 0 10px\"><b>管理员回复：</b></div>\n        <div v-if=\"detail.reply\" style=\"white-space: pre-wrap\">{{ detail.reply }}</div>\n        <div v-else>暂无回复</div>\n      </div>\n      <span slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"detailVisible = false\">关闭</el-button>\n      </span>\n    </el-dialog>\n\n    <el-dialog title=\"回复留言\" :visible.sync=\"replyVisible\" width=\"650px\">\n      <el-input type=\"textarea\" :rows=\"6\" v-model.trim=\"replyForm.reply\" maxlength=\"2000\" show-word-limit></el-input>\n      <span slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"replyVisible = false\">取消</el-button>\n        <el-button type=\"primary\" @click=\"submitReply\">提交</el-button>\n      </span>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: \"ManageMessage\",\n  data() {\n    return {\n      tableData: [],\n      pageNum: 1,\n      pageSize: 10,\n      total: 0,\n      searchText: \"\",\n      customIntentFilter: null,\n      detailVisible: false,\n      detail: null,\n      replyVisible: false,\n      replyForm: {\n        id: null,\n        reply: \"\",\n      },\n    };\n  },\n  created() {\n    this.load();\n  },\n  methods: {\n    load() {\n      this.request\n        .get(\"/api/message/page\", {\n          params: {\n            pageNum: this.pageNum,\n            pageSize: this.pageSize,\n            customIntent: this.customIntentFilter,\n            searchText: this.searchText,\n          },\n        })\n        .then((res) => {\n          if (res.code === \"200\") {\n            this.tableData = res.data.records || [];\n            this.total = res.data.total || 0;\n          } else {\n            this.$message.error(res.msg || \"加载失败\");\n          }\n        });\n    },\n    handlePageChange(page) {\n      this.pageNum = page;\n      this.load();\n    },\n    openDetail(id) {\n      this.request.get(\"/api/message/\" + id).then((res) => {\n        if (res.code === \"200\") {\n          this.detail = res.data;\n          this.detailVisible = true;\n        } else {\n          this.$message.error(res.msg || \"加载失败\");\n        }\n      });\n    },\n    openReply(row) {\n      this.replyForm = { id: row.id, reply: row.reply || \"\" };\n      this.replyVisible = true;\n    },\n    submitReply() {\n      if (!this.replyForm.reply) {\n        this.$message.error(\"回复内容不能为空\");\n        return;\n      }\n      this.request.put(\"/api/message/reply\", this.replyForm).then((res) => {\n        if (res.code === \"200\") {\n          this.$message.success(\"回复成功\");\n          this.replyVisible = false;\n          this.load();\n        } else {\n          this.$message.error(res.msg || \"回复失败\");\n        }\n      });\n    },\n    del(id) {\n      this.request.delete(\"/api/message/\" + id).then((res) => {\n        if (res.code === \"200\") {\n          this.$message.success(\"删除成功\");\n          this.load();\n        } else {\n          this.$message.error(res.msg || \"删除失败\");\n        }\n      });\n    },\n  },\n};\n</script>\n\n<style scoped></style>\n"]},"metadata":{},"sourceType":"module"}