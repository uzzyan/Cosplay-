{"ast":null,"code":"import \"core-js/modules/es.json.stringify.js\";\nimport \"core-js/modules/es.array.slice.js\";\nimport { ref, onMounted } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { ElMessage } from 'element-plus';\nimport { useStore } from 'vuex';\nimport API from '@/utils/request';\nvar url = '/api/good/';\nexport default {\n  __name: 'Goods',\n  setup: function setup(__props, _ref) {\n    var __expose = _ref.expose;\n\n    __expose();\n\n    var store = useStore();\n    var router = useRouter();\n    var baseApi = store.state.baseApi;\n    var uploadRef = ref(null); // 定义upload组件的ref\n\n    var fileList = ref([]);\n    var options = ref([]);\n    var searchText = ref('');\n    var user = ref({});\n    var tableData = ref([]);\n    var pageNum = ref(1);\n    var pageSize = ref(5);\n    var entity = ref({});\n    var total = ref(0);\n    var dialogFormVisible = ref(false);\n\n    var handleSizeChange = function handleSizeChange(pageSizeVal) {\n      pageSize.value = pageSizeVal;\n      load();\n    };\n\n    var handleCurrentChange = function handleCurrentChange(pageNumVal) {\n      pageNum.value = pageNumVal;\n      load();\n    };\n\n    var handleRecommend = function handleRecommend(good) {\n      API.get(url + 'recommend', {\n        params: {\n          id: good.id,\n          isRecommend: good.recommend\n        }\n      }).then(function (res) {\n        if (res.code === '200') {\n          ElMessage.success('修改成功');\n        } else {\n          ElMessage.error(res.msg);\n        }\n      }).catch(function (err) {\n        console.error('修改推荐状态失败:', err);\n        ElMessage.error('修改失败，请重试');\n      });\n    };\n\n    var handleStatus = function handleStatus(good) {\n      API.put(url, {\n        id: good.id,\n        status: good.status\n      }).then(function (res) {\n        if (res.code === '200') {\n          ElMessage.success('修改成功');\n          load();\n        } else {\n          ElMessage.error(res.msg);\n        }\n      }).catch(function (err) {\n        console.error('修改状态失败:', err);\n        ElMessage.error('修改失败，请重试');\n      });\n    };\n\n    var load = function load() {\n      API.get(url + 'fullPage', {\n        params: {\n          pageNum: pageNum.value,\n          pageSize: pageSize.value,\n          searchText: searchText.value\n        }\n      }).then(function (res) {\n        tableData.value = res.data.records;\n        total.value = res.data.total;\n      }).catch(function (err) {\n        console.error('加载商品列表失败:', err);\n        ElMessage.error('加载失败，请重试');\n      });\n    };\n\n    var reset = function reset() {\n      searchText.value = '';\n      load();\n    };\n\n    var add = function add() {\n      router.push('goodInfo');\n    };\n\n    var edit = function edit(obj) {\n      entity.value = JSON.parse(JSON.stringify(obj));\n      router.push({\n        name: 'goodInfo',\n        query: {\n          good: JSON.stringify(entity.value)\n        }\n      });\n    };\n\n    var handleImgSuccess = function handleImgSuccess(res) {\n      entity.value.imgs = res.data;\n      API.post(url, entity.value).then(function (res2) {\n        if (res2.code === '200') {\n          ElMessage({\n            type: 'success',\n            message: '操作成功'\n          });\n        } else {\n          ElMessage({\n            type: 'error',\n            message: res2.msg\n          });\n        }\n\n        load();\n        dialogFormVisible.value = false;\n      }).catch(function (err) {\n        console.error('保存失败:', err);\n        ElMessage.error('保存失败，请重试');\n      });\n    };\n\n    var save = function save() {\n      if (fileList.value.length !== 0) {\n        // 使用uploadRef提交文件\n        if (uploadRef.value) {\n          uploadRef.value.submit();\n        } else {\n          ElMessage.error('上传组件未初始化');\n        }\n      } else {\n        API.post(url, entity.value).then(function (res2) {\n          if (res2.code === '200') {\n            ElMessage({\n              type: 'success',\n              message: '操作成功'\n            });\n          } else {\n            ElMessage({\n              type: 'error',\n              message: res2.msg\n            });\n          }\n\n          load();\n          dialogFormVisible.value = false;\n        }).catch(function (err) {\n          console.error('保存失败:', err);\n          ElMessage.error('保存失败，请重试');\n        });\n      }\n    };\n\n    var del = function del(id) {\n      API.delete(url + id).then(function (res) {\n        ElMessage({\n          type: 'success',\n          message: '操作成功'\n        });\n        load();\n      }).catch(function (err) {\n        console.error('删除失败:', err);\n        ElMessage.error('删除失败，请重试');\n      });\n    };\n\n    var handleChange = function handleChange(file, fileListVal) {\n      fileList.value = fileListVal.slice(-3);\n    };\n\n    onMounted(function () {\n      user.value = localStorage.getItem('user') ? JSON.parse(localStorage.getItem('user')) : {};\n      load();\n    });\n    var __returned__ = {\n      store: store,\n      router: router,\n      baseApi: baseApi,\n      uploadRef: uploadRef,\n      fileList: fileList,\n      options: options,\n      searchText: searchText,\n      user: user,\n      tableData: tableData,\n      pageNum: pageNum,\n      pageSize: pageSize,\n      entity: entity,\n      total: total,\n      dialogFormVisible: dialogFormVisible,\n      url: url,\n      handleSizeChange: handleSizeChange,\n      handleCurrentChange: handleCurrentChange,\n      handleRecommend: handleRecommend,\n      handleStatus: handleStatus,\n      load: load,\n      reset: reset,\n      add: add,\n      edit: edit,\n      handleImgSuccess: handleImgSuccess,\n      save: save,\n      del: del,\n      handleChange: handleChange,\n      ref: ref,\n      onMounted: onMounted,\n\n      get useRouter() {\n        return useRouter;\n      },\n\n      get ElMessage() {\n        return ElMessage;\n      },\n\n      get useStore() {\n        return useStore;\n      },\n\n      get API() {\n        return API;\n      }\n\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"mappings":";;AAoJA,SAASA,GAAT,EAAcC,SAAd,QAA+B,KAA/B;AACA,SAASC,SAAT,QAA0B,YAA1B;AACA,SAASC,SAAT,QAA0B,cAA1B;AACA,SAASC,QAAT,QAAyB,MAAzB;AACA,OAAOC,GAAP,MAAgB,iBAAhB;AAkBA,IAAMC,GAAG,GAAG,YAAZ;;;;;;;;AAhBA,QAAMC,KAAK,GAAGH,QAAQ,EAAtB;AACA,QAAMI,MAAM,GAAGN,SAAS,EAAxB;AAEA,QAAMO,OAAO,GAAGF,KAAK,CAACG,KAAN,CAAYD,OAA5B;AACA,QAAME,SAAS,GAAGX,GAAG,CAAC,IAAD,CAArB,EAA4B;;AAC5B,QAAMY,QAAQ,GAAGZ,GAAG,CAAC,EAAD,CAApB;AACA,QAAMa,OAAO,GAAGb,GAAG,CAAC,EAAD,CAAnB;AACA,QAAMc,UAAU,GAAGd,GAAG,CAAC,EAAD,CAAtB;AACA,QAAMe,IAAI,GAAGf,GAAG,CAAC,EAAD,CAAhB;AACA,QAAMgB,SAAS,GAAGhB,GAAG,CAAC,EAAD,CAArB;AACA,QAAMiB,OAAO,GAAGjB,GAAG,CAAC,CAAD,CAAnB;AACA,QAAMkB,QAAQ,GAAGlB,GAAG,CAAC,CAAD,CAApB;AACA,QAAMmB,MAAM,GAAGnB,GAAG,CAAC,EAAD,CAAlB;AACA,QAAMoB,KAAK,GAAGpB,GAAG,CAAC,CAAD,CAAjB;AACA,QAAMqB,iBAAiB,GAAGrB,GAAG,CAAC,KAAD,CAA7B;;AAIA,QAAMsB,gBAAgB,GAAG,SAAnBA,gBAAmB,CAACC,WAAD,EAAiB;AACxCL,cAAQ,CAACM,KAAT,GAAiBD,WAAjB;AACAE,UAAI;AACL,KAHD;;AAKA,QAAMC,mBAAmB,GAAG,SAAtBA,mBAAsB,CAACC,UAAD,EAAgB;AAC1CV,aAAO,CAACO,KAAR,GAAgBG,UAAhB;AACAF,UAAI;AACL,KAHD;;AAKA,QAAMG,eAAe,GAAG,SAAlBA,eAAkB,CAACC,IAAD,EAAU;AAChCxB,SAAG,CAACyB,GAAJ,CAAQxB,GAAG,GAAG,WAAd,EAA2B;AACzByB,cAAM,EAAE;AACNC,YAAE,EAAEH,IAAI,CAACG,EADH;AAENC,qBAAW,EAAEJ,IAAI,CAACK;AAFZ;AADiB,OAA3B,EAKGC,IALH,CAKQ,aAAG,EAAI;AACb,YAAIC,GAAG,CAACC,IAAJ,KAAa,KAAjB,EAAwB;AACtBlC,mBAAS,CAACmC,OAAV,CAAkB,MAAlB;AACD,SAFD,MAEO;AACLnC,mBAAS,CAACoC,KAAV,CAAgBH,GAAG,CAACI,GAApB;AACD;AACF,OAXD,EAWGC,KAXH,CAWS,aAAG,EAAI;AACdC,eAAO,CAACH,KAAR,CAAc,WAAd,EAA2BI,GAA3B;AACAxC,iBAAS,CAACoC,KAAV,CAAgB,UAAhB;AACD,OAdD;AAeD,KAhBD;;AAkBA,QAAMK,YAAY,GAAG,SAAfA,YAAe,CAACf,IAAD,EAAU;AAC7BxB,SAAG,CAACwC,GAAJ,CAAQvC,GAAR,EAAa;AAAE0B,UAAE,EAAEH,IAAI,CAACG,EAAX;AAAec,cAAM,EAAEjB,IAAI,CAACiB;AAA5B,OAAb,EAAmDX,IAAnD,CAAwD,aAAG,EAAI;AAC7D,YAAIC,GAA