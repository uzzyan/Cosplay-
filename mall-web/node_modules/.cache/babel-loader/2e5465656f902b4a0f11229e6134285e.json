{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\nexport default {\n  name: \"AfterSale\",\n\n  data() {\n    return {\n      form: {\n        orderNo: \"\",\n        type: \"\",\n        reason: \"\"\n      },\n      tableData: [],\n      pageNum: 1,\n      pageSize: 10,\n      total: 0,\n      detailVisible: false,\n      detail: null\n    };\n  },\n\n  created() {\n    this.form.orderNo = this.$route.query.orderNo || \"\";\n    this.load();\n  },\n\n  methods: {\n    resetForm() {\n      this.form = {\n        orderNo: this.$route.query.orderNo || \"\",\n        type: \"\",\n        reason: \"\"\n      };\n    },\n\n    submit() {\n      const orderNo = (this.form.orderNo || \"\").trim();\n      const type = (this.form.type || \"\").trim();\n      const reason = (this.form.reason || \"\").trim();\n\n      if (!orderNo) {\n        this.$message.error(\"订单编号不能为空\");\n        return;\n      }\n\n      if (!type) {\n        this.$message.error(\"申请类型不能为空\");\n        return;\n      }\n\n      if (!reason) {\n        this.$message.error(\"申请原因不能为空\");\n        return;\n      }\n\n      this.request.post(\"/api/afterSale\", {\n        orderNo,\n        type,\n        reason\n      }).then(res => {\n        if (res.code === \"200\") {\n          this.$message.success(\"提交成功\");\n          this.resetForm();\n          this.pageNum = 1;\n          this.load();\n        } else {\n          this.$message.error(res.msg || \"提交失败\");\n        }\n      });\n    },\n\n    load() {\n      this.request.get(\"/api/afterSale/mine/page\", {\n        params: {\n          pageNum: this.pageNum,\n          pageSize: this.pageSize\n        }\n      }).then(res => {\n        if (res.code === \"200\") {\n          this.tableData = res.data.records || [];\n          this.total = res.data.total || 0;\n        } else {\n          this.$message.error(res.msg || \"加载失败\");\n        }\n      });\n    },\n\n    handlePageChange(page) {\n      this.pageNum = page;\n      this.load();\n    },\n\n    openDetail(id) {\n      this.request.get(\"/api/afterSale/\" + id).then(res => {\n        if (res.code === \"200\") {\n          this.detail = res.data;\n          this.detailVisible = true;\n        } else {\n          this.$message.error(res.msg || \"加载失败\");\n        }\n      });\n    }\n\n  }\n};","map":{"version":3,"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAgFA;AACAA,mBADA;;AAEAC;AACA;AACAC;AACAC,mBADA;AAEAC,gBAFA;AAGAC;AAHA,OADA;AAMAC,mBANA;AAOAC,gBAPA;AAQAC,kBARA;AASAC,cATA;AAUAC,0BAVA;AAWAC;AAXA;AAaA,GAhBA;;AAiBAC;AACA;AACA;AACA,GApBA;;AAqBAC;AACAC;AACA;AAAAX;AAAAC;AAAAC;AAAA;AACA,KAHA;;AAIAU;AACA;AACA;AACA;;AACA;AACA;AACA;AACA;;AACA;AACA;AACA;AACA;;AACA;AACA;AACA;AACA;;AACA;AAAAZ;AAAAC;AAAAC;AAAA;AACA;AACA;AACA;AACA;AACA;AACA,SALA,MAKA;AACA;AACA;AACA,OATA;AAUA,KA9BA;;AA+BAW;AACA,mBACAC,GADA,CACA,0BADA,EACA;AACAC;AAAAX;AAAAC;AAAA;AADA,OADA,EAIAW,IAJA,CAIAC;AACA;AACA;AACA;AACA,SAHA,MAGA;AACA;AACA;AACA,OAXA;AAYA,KA5CA;;AA6CAC;AACA;AACA;AACA,KAhDA;;AAiDAC;AACA;AACA;AACA;AACA;AACA,SAHA,MAGA;AACA;AACA;AACA,OAPA;AAQA;;AA1DA;AArBA","names":["name","data","form","orderNo","type","reason","tableData","pageNum","pageSize","total","detailVisible","detail","created","methods","resetForm","submit","load","get","params","then","res","handlePageChange","openDetail"],"sourceRoot":"src/views/front","sources":["AfterSale.vue"],"sourcesContent":["<template>\n  <div style=\"width: 90%; max-width: 1200px; margin: 20px auto\">\n    <el-card>\n      <div slot=\"header\" style=\"display: flex; justify-content: space-between; align-items: center\">\n        <span>退款 / 售后申请</span>\n      </div>\n\n      <el-form label-width=\"90px\">\n        <el-form-item label=\"订单编号\">\n          <el-input v-model.trim=\"form.orderNo\" maxlength=\"64\"></el-input>\n        </el-form-item>\n        <el-form-item label=\"申请类型\">\n          <el-select v-model=\"form.type\" placeholder=\"请选择\" style=\"width: 200px\">\n            <el-option label=\"退款\" value=\"退款\"></el-option>\n            <el-option label=\"售后\" value=\"售后\"></el-option>\n          </el-select>\n        </el-form-item>\n        <el-form-item label=\"申请原因\">\n          <el-input type=\"textarea\" :rows=\"4\" v-model.trim=\"form.reason\" maxlength=\"2000\" show-word-limit></el-input>\n        </el-form-item>\n        <el-form-item>\n          <el-button type=\"success\" @click=\"submit\">提交申请</el-button>\n          <el-button @click=\"resetForm\">清空</el-button>\n        </el-form-item>\n      </el-form>\n    </el-card>\n\n    <el-card style=\"margin-top: 18px\">\n      <div slot=\"header\" style=\"display: flex; justify-content: space-between; align-items: center\">\n        <span>我的申请</span>\n      </div>\n\n      <el-table :data=\"tableData\" stripe style=\"width: 100%\">\n        <el-table-column prop=\"createTime\" label=\"申请时间\" width=\"170\"></el-table-column>\n        <el-table-column prop=\"orderNo\" label=\"订单编号\" width=\"200\"></el-table-column>\n        <el-table-column prop=\"type\" label=\"类型\" width=\"80\"></el-table-column>\n        <el-table-column prop=\"status\" label=\"状态\" width=\"100\">\n          <template slot-scope=\"scope\">\n            <el-tag v-if=\"scope.row.status === '待处理'\" type=\"warning\">待处理</el-tag>\n            <el-tag v-else-if=\"scope.row.status === '已同意'\" type=\"success\">已同意</el-tag>\n            <el-tag v-else type=\"info\">已拒绝</el-tag>\n          </template>\n        </el-table-column>\n        <el-table-column label=\"操作\" width=\"120\">\n          <template slot-scope=\"scope\">\n            <el-button type=\"text\" @click=\"openDetail(scope.row.id)\">详情</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n\n      <div style=\"padding: 15px 0; text-align: right\">\n        <el-pagination\n          background\n          layout=\"prev, pager, next\"\n          :current-page=\"pageNum\"\n          :page-size=\"pageSize\"\n          :total=\"total\"\n          @current-change=\"handlePageChange\"\n        ></el-pagination>\n      </div>\n    </el-card>\n\n    <el-dialog title=\"申请详情\" :visible.sync=\"detailVisible\" width=\"700px\">\n      <div v-if=\"detail\">\n        <div style=\"margin-bottom: 10px\"><b>订单编号：</b>{{ detail.orderNo }}</div>\n        <div style=\"margin-bottom: 10px\"><b>类型：</b>{{ detail.type }}</div>\n        <div style=\"margin-bottom: 10px\"><b>状态：</b>{{ detail.status }}</div>\n        <div style=\"margin-bottom: 10px\"><b>申请时间：</b>{{ detail.createTime }}</div>\n        <div style=\"margin-bottom: 10px\"><b>处理时间：</b>{{ detail.handleTime || '-' }}</div>\n        <div style=\"margin-bottom: 10px\"><b>原因：</b></div>\n        <div style=\"white-space: pre-wrap\">{{ detail.reason }}</div>\n      </div>\n      <span slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"detailVisible = false\">关闭</el-button>\n      </span>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: \"AfterSale\",\n  data() {\n    return {\n      form: {\n        orderNo: \"\",\n        type: \"\",\n        reason: \"\",\n      },\n      tableData: [],\n      pageNum: 1,\n      pageSize: 10,\n      total: 0,\n      detailVisible: false,\n      detail: null,\n    };\n  },\n  created() {\n    this.form.orderNo = this.$route.query.orderNo || \"\";\n    this.load();\n  },\n  methods: {\n    resetForm() {\n      this.form = { orderNo: this.$route.query.orderNo || \"\", type: \"\", reason: \"\" };\n    },\n    submit() {\n      const orderNo = (this.form.orderNo || \"\").trim();\n      const type = (this.form.type || \"\").trim();\n      const reason = (this.form.reason || \"\").trim();\n      if (!orderNo) {\n        this.$message.error(\"订单编号不能为空\");\n        return;\n      }\n      if (!type) {\n        this.$message.error(\"申请类型不能为空\");\n        return;\n      }\n      if (!reason) {\n        this.$message.error(\"申请原因不能为空\");\n        return;\n      }\n      this.request.post(\"/api/afterSale\", { orderNo, type, reason }).then((res) => {\n        if (res.code === \"200\") {\n          this.$message.success(\"提交成功\");\n          this.resetForm();\n          this.pageNum = 1;\n          this.load();\n        } else {\n          this.$message.error(res.msg || \"提交失败\");\n        }\n      });\n    },\n    load() {\n      this.request\n        .get(\"/api/afterSale/mine/page\", {\n          params: { pageNum: this.pageNum, pageSize: this.pageSize },\n        })\n        .then((res) => {\n          if (res.code === \"200\") {\n            this.tableData = res.data.records || [];\n            this.total = res.data.total || 0;\n          } else {\n            this.$message.error(res.msg || \"加载失败\");\n          }\n        });\n    },\n    handlePageChange(page) {\n      this.pageNum = page;\n      this.load();\n    },\n    openDetail(id) {\n      this.request.get(\"/api/afterSale/\" + id).then((res) => {\n        if (res.code === \"200\") {\n          this.detail = res.data;\n          this.detailVisible = true;\n        } else {\n          this.$message.error(res.msg || \"加载失败\");\n        }\n      });\n    },\n  },\n};\n</script>\n\n<style scoped></style>\n"]},"metadata":{},"sourceType":"module"}