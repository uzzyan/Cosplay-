{"ast":null,"code":"import \"core-js/modules/es.string.trim.js\";\nimport { ref } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { ElMessage } from 'element-plus';\nimport { useStore } from 'vuex';\nexport default {\n  __name: 'Navagation',\n  props: {\n    user: Object,\n    loginStatus: Boolean,\n    role: String\n  },\n  setup: function setup(__props, _ref) {\n    var __expose = _ref.expose;\n\n    __expose();\n\n    var store = useStore();\n    var router = useRouter();\n    var props = __props;\n    var baseApi = store.state.baseApi;\n    var searchText = ref('');\n\n    var logout = function logout() {\n      localStorage.removeItem('user');\n      ElMessage.success('退出成功');\n      router.push('/'); // 使用路由跳转\n    };\n\n    var handleSearch = function handleSearch() {\n      if (searchText.value && searchText.value.trim()) {\n        router.push({\n          path: '/goodList',\n          query: {\n            searchText: searchText.value.trim()\n          }\n        });\n      }\n    };\n\n    var __returned__ = {\n      store: store,\n      router: router,\n      props: props,\n      baseApi: baseApi,\n      searchText: searchText,\n      logout: logout,\n      handleSearch: handleSearch,\n      ref: ref,\n\n      get useRouter() {\n        return useRouter;\n      },\n\n      get ElMessage() {\n        return ElMessage;\n      },\n\n      get useStore() {\n        return useStore;\n      }\n\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"mappings":";AA6GA,SAASA,GAAT,QAAoB,KAApB;AACA,SAASC,SAAT,QAA0B,YAA1B;AACA,SAASC,SAAT,QAA0B,cAA1B;AACA,SAASC,QAAT,QAAyB,MAAzB;;;;;;;;;;;;;AAEA,QAAMC,KAAK,GAAGD,QAAQ,EAAtB;AACA,QAAME,MAAM,GAAGJ,SAAS,EAAxB;AAEA,QAAMK,KAAK,GAAGC,OAAd;AAMA,QAAMC,OAAO,GAAGJ,KAAK,CAACK,KAAN,CAAYD,OAA5B;AACA,QAAME,UAAU,GAAGV,GAAG,CAAC,EAAD,CAAtB;;AAEA,QAAMW,MAAM,GAAG,SAATA,MAAS,GAAM;AACnBC,kBAAY,CAACC,UAAb,CAAwB,MAAxB;AACAX,eAAS,CAACY,OAAV,CAAkB,MAAlB;AACAT,YAAM,CAACU,IAAP,CAAY,GAAZ,EAHmB,CAGF;AAClB,KAJD;;AAMA,QAAMC,YAAY,GAAG,SAAfA,YAAe,GAAM;AACzB,UAAIN,UAAU,CAACO,KAAX,IAAoBP,UAAU,CAACO,KAAX,CAAiBC,IAAjB,EAAxB,EAAiD;AAC/Cb,cAAM,CAACU,IAAP,CAAY;AACVI,cAAI,EAAE,WADI;AAEVC,eAAK,EAAE;AAAEV,sBAAU,EAAEA,UAAU,CAACO,KAAX,CAAiBC,IAAjB;AAAd;AAFG,SAAZ;AAID;AACF,KAPD","names":["ref","useRouter","ElMessage","useStore","store","router","props","__props","baseApi","state","searchText","logout","localStorage","removeItem","success","push","handleSearch","value","trim","path","query"],"sources":["C:/q_code4.12/cosplay_mall(qoder)/mall-web/src/components/Navagation.vue"],"sourcesContent":["\r\n<template>\r\n  <div class=\"navagation\">\r\n    <el-row>\r\n      <el-col :span=\"3\">\r\n        <div style=\"font-size: 20px; font-weight: bold; text-align: center\">\r\n          <a href=\"/\"><i class=\"iconfont icon-r-home\" style=\"font-size: 24px;\"></i> U次元 - Cosplay服装商城</a>\r\n        </div>\r\n      </el-col>\r\n      <el-col :span=\"13\">\r\n        <el-menu\r\n          :default-active=\"activeIndex\"\r\n          class=\"el-menu-demo\"\r\n          mode=\"horizontal\"\r\n          router\r\n        >\r\n          <el-menu-item index=\"/\" class=\"menu-item\">商城首页</el-menu-item>\r\n\r\n          <el-menu-item index=\"/goodList\" class=\"menu-item\"\r\n            >所有商品</el-menu-item\r\n          >\r\n          <el-menu-item index=\"/cart\" class=\"menu-item\"\r\n            >购物车</el-menu-item\r\n          >\r\n          <el-menu-item index=\"/orderlist\" class=\"menu-item\"\r\n            >我的订单</el-menu-item\r\n          >\r\n          <el-menu-item index=\"/addressManage\" class=\"menu-item\"\r\n            >地址管理</el-menu-item\r\n          >\r\n          <el-menu-item index=\"/message\" class=\"menu-item\" v-show=\"loginStatus\"\r\n            >在线留言</el-menu-item\r\n          >\r\n          <el-menu-item index=\"/afterSale\" class=\"menu-item\" v-show=\"loginStatus\"\r\n            >售后申请</el-menu-item\r\n          >\r\n          <el-menu-item\r\n            index=\"/manage\"\r\n            class=\"menu-item\"\r\n            v-show=\"role === 'admin'\"\r\n            >后台管理</el-menu-item\r\n          >\r\n        </el-menu>\r\n      </el-col>\r\n      <el-col :span=\"5\">\r\n        <!-- 搜索框 -->\r\n        <div class=\"nav-search\">\r\n          <el-input\r\n            v-model=\"searchText\"\r\n            placeholder=\"搜索商品\"\r\n            @keyup.enter=\"handleSearch\"\r\n            prefix-icon=\"el-icon-search\"\r\n            size=\"medium\"\r\n            clearable\r\n          >\r\n            <template #append>\r\n              <el-button\r\n                icon=\"Search\"\r\n                @click=\"handleSearch\"\r\n              ></el-button>\r\n            </template>\r\n          </el-input>\r\n        </div>\r\n      </el-col>\r\n      <el-col :span=\"3\">\r\n        <!--         右上角个人信息-->\r\n        <el-dropdown style=\"cursor: pointer; float: right; margin-right: 20px\">\r\n          <span class=\"el-dropdown-link\">\r\n            <div style=\"display: inline-block\">\r\n              <img\r\n                v-if=\"user.avatarUrl != null\"\r\n                :src=\"baseApi + user.avatarUrl\"\r\n                class=\"avatar\"\r\n              />\r\n              {{ user.nickname }}\r\n              <i\r\n                class=\"el-icon-arrow-down el-icon--right\"\r\n                style=\"margin-right: 5px\"\r\n              ></i>\r\n            </div>\r\n          </span>\r\n          <!--          下拉菜单-->\r\n          <template #dropdown>\r\n            <el-dropdown-menu style=\"text-align: center\">\r\n            <el-dropdown-item>\r\n              <!--              传给前端，登录后跳转页面的path为 \"/\"-->\r\n              <div\r\n                @click=\"$router.push({ path: '/login', query: { to: '/' } })\"\r\n                v-show=\"!loginStatus\"\r\n              >\r\n                登录\r\n              </div>\r\n            </el-dropdown-item>\r\n            <el-dropdown-item v-show=\"loginStatus\">\r\n              <div @click=\"$router.push('/person')\">个人信息</div>\r\n            </el-dropdown-item>\r\n            <el-dropdown-item v-show=\"loginStatus\">\r\n              <div @click=\"logout\">退出</div>\r\n            </el-dropdown-item>\r\n          </el-dropdown-menu>\r\n          </template>\r\n        </el-dropdown>\r\n      </el-col>\r\n    </el-row>\r\n  </div>\r\n</template>\r\n\r\n\r\n<script setup>\r\nimport { ref } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport { ElMessage } from 'element-plus'\r\nimport { useStore } from 'vuex'\r\n\r\nconst store = useStore()\r\nconst router = useRouter()\r\n\r\nconst props = defineProps({\r\n  user: Object,\r\n  loginStatus: Boolean,\r\n  role: String\r\n})\r\n\r\nconst baseApi = store.state.baseApi\r\nconst searchText = ref('')\r\n\r\nconst logout = () => {\r\n  localStorage.removeItem('user')\r\n  ElMessage.success('退出成功')\r\n  router.push('/') // 使用路由跳转\r\n}\r\n\r\nconst handleSearch = () => {\r\n  if (searchText.value && searchText.value.trim()) {\r\n    router.push({\r\n      path: '/goodList',\r\n      query: { searchText: searchText.value.trim() }\r\n    })\r\n  }\r\n}\r\n</script>\r\n<style>\r\na {\r\n  text-decoration: none;\r\n}\r\n.navagation {\r\n  width: 100%;\r\n  height: 60px;\r\n  line-height: 60px;\r\n  background-color: white;\r\n  overflow: hidden;\r\n}\r\n.avatar {\r\n  width: 45px;\r\n  border-radius: 5px;\r\n  position: relative;\r\n  top: 10px;\r\n  right: 5px;\r\n}\r\n.menu-item {\r\n  padding-left: 30px;\r\n  padding-right: 30px;\r\n  font-size: 16px !important;\r\n  font-weight: 500;\r\n}\r\n.nav-search {\r\n  padding: 10px 10px;\r\n  line-height: normal;\r\n}\r\n</style>\r\n"]},"metadata":{},"sourceType":"module"}