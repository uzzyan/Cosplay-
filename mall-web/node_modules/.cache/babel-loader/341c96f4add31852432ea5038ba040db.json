{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\nimport Aside from \"@/components/Aside\";\nimport Header from \"@/components/Header\";\nexport default {\n  data() {\n    return {\n      user: {},\n      isCollapse: false,\n      sideWidth: 250,\n      collapseIcon: \"el-icon-s-fold\",\n      collapseTitle: \"收缩\"\n    };\n  },\n\n  components: {\n    Aside,\n    Header\n  },\n  methods: {\n    handleCollapse() {\n      this.isCollapse = !this.isCollapse;\n\n      if (this.isCollapse) {\n        //点击收缩按钮\n        this.sideWidth = 64;\n        this.collapseIcon = \"el-icon-s-unfold\";\n        this.collapseTitle = \"展开\";\n      } else {\n        //点击展开按钮\n        this.sideWidth = 250;\n        this.collapseIcon = \"el-icon-s-fold\";\n        this.collapseTitle = \"收缩\";\n      }\n    },\n\n    getUser() {\n      let username = localStorage.getItem(\"user\") ? JSON.parse(localStorage.getItem(\"user\")).username : \"\";\n\n      if (username) {\n        // 从后台获取User数据\n        this.request.get(\"/userinfo/\" + username).then(res => {\n          // 重新赋值后台的最新User数据\n          this.user = res.data;\n        });\n      }\n    }\n\n  },\n\n  mounted() {},\n\n  created() {\n    this.getUser();\n  }\n\n};","map":{"version":3,"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAwDA;AACA;AAEA;AACAA;AACA;AACAC,cADA;AAEAC,uBAFA;AAGAC,oBAHA;AAIAC,oCAJA;AAKAC;AALA;AAOA,GATA;;AAWAC;AACAC,SADA;AAEAC;AAFA,GAXA;AAeAC;AACAC;AACA;;AACA;AACA;AACA;AACA;AACA;AACA,OALA,MAKA;AACA;AACA;AACA;AACA;AACA;AACA,KAdA;;AAeAC;AACA,oDACAC,iDADA,GAEA,EAFA;;AAGA;AACA;AACA;AACA;AACA;AACA,SAHA;AAIA;AACA;;AA1BA,GAfA;;AA2CAC,aAEA,CA7CA;;AA8CAC;AACA;AACA;;AAhDA","names":["data","user","isCollapse","sideWidth","collapseIcon","collapseTitle","components","Aside","Header","methods","handleCollapse","getUser","JSON","mounted","created"],"sourceRoot":"src/views/manage","sources":["Manage.vue"],"sourcesContent":["<!--\r\n * @Description: \r\n * @Author: gzc\r\n * @Date: 2024-03-21 15:27:05\r\n-->\r\n<template>\r\n  <div style=\"height: 100%\">\r\n    <el-container style=\"height: 100%\">\r\n      <!--      侧边栏-->\r\n      <el-aside\r\n        :width=\"sideWidth + 'px'\"\r\n        style=\"background: #f8f9fa; height: 100%\"\r\n      >\r\n        <Aside :is-collapse=\"isCollapse\"></Aside>\r\n      </el-aside>\r\n\r\n      <el-container>\r\n        <!--        导航栏-->\r\n        <el-header\r\n          style=\"border-bottom: 1px solid #e5e7eb; background: linear-gradient(90deg, #f0fdfa 0%, #fef2f2 100%);height: 80px;\"\r\n        >\r\n          <Header\r\n            :collapse-icon=\"collapseIcon\"\r\n            :collapse-title=\"collapseTitle\"\r\n            @collapse=\"handleCollapse\"\r\n            :user=\"user\"\r\n          ></Header>\r\n        </el-header>\r\n\r\n        <el-main :class=\"{bk: $route.path=='/manage/home'}\">\r\n          <router-view @refresh=\"getUser\" />\r\n        </el-main>\r\n      </el-container>\r\n    </el-container>\r\n  </div>\r\n</template>\r\n\r\n<style>\r\n.el-header {\r\n  background-color: #b3c0d1;\r\n  color: #333;\r\n  line-height: 80px;\r\n}\r\n\r\n.el-aside {\r\n  color: #333;\r\n}\r\n\r\n.bk {\r\n  width: 100%;\r\n  background: url(\"@/resource/img/01.png\") center center no-repeat;\r\n  background-size: 100% 100%;\r\n}\r\n</style>\r\n\r\n<script>\r\nimport Aside from \"@/components/Aside\";\r\nimport Header from \"@/components/Header\";\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      user: {},\r\n      isCollapse: false,\r\n      sideWidth: 250,\r\n      collapseIcon: \"el-icon-s-fold\",\r\n      collapseTitle: \"收缩\",\r\n    };\r\n  },\r\n\r\n  components: {\r\n    Aside,\r\n    Header,\r\n  },\r\n  methods: {\r\n    handleCollapse() {\r\n      this.isCollapse = !this.isCollapse;\r\n      if (this.isCollapse) {\r\n        //点击收缩按钮\r\n        this.sideWidth = 64;\r\n        this.collapseIcon = \"el-icon-s-unfold\";\r\n        this.collapseTitle = \"展开\";\r\n      } else {\r\n        //点击展开按钮\r\n        this.sideWidth = 250;\r\n        this.collapseIcon = \"el-icon-s-fold\";\r\n        this.collapseTitle = \"收缩\";\r\n      }\r\n    },\r\n    getUser() {\r\n      let username = localStorage.getItem(\"user\")\r\n        ? JSON.parse(localStorage.getItem(\"user\")).username\r\n        : \"\";\r\n      if (username) {\r\n        // 从后台获取User数据\r\n        this.request.get(\"/userinfo/\" + username).then((res) => {\r\n          // 重新赋值后台的最新User数据\r\n          this.user = res.data;\r\n        });\r\n      }\r\n    },\r\n  },\r\n  mounted() {\r\n    \r\n  },\r\n  created() {\r\n    this.getUser();\r\n  },\r\n};\r\n</script>\r\n"]},"metadata":{},"sourceType":"module"}