{"ast":null,"code":"import \"core-js/modules/es.number.constructor.js\";\nimport \"core-js/modules/es.array.map.js\";\nimport \"core-js/modules/es.json.stringify.js\";\nimport \"core-js/modules/es.number.to-fixed.js\";\nimport \"core-js/modules/es.object.to-string.js\";\nimport { ref, computed, onMounted } from 'vue';\nimport { useRoute, useRouter } from 'vue-router';\nimport { ElMessage } from 'element-plus';\nimport { useStore } from 'vuex';\nimport API from '@/utils/request';\nexport default {\n  __name: 'GoodView',\n  setup: function setup(__props, _ref) {\n    var __expose = _ref.expose;\n\n    __expose();\n\n    var store = useStore();\n    var route = useRoute();\n    var router = useRouter();\n    var baseApi = store.state.baseApi;\n    var good = ref({});\n    var goodId = ref(Number);\n    var price = ref(-1);\n    var isDiscount = ref(false);\n    var discount = ref('');\n    var standards = ref([]);\n    var checkedStandard = ref('');\n    var storeCount = ref(0);\n    var showStore = ref(false);\n    var count = ref(1);\n    var totalStore = ref(0);\n\n    var getPriceRange = function getPriceRange(standardsArr) {\n      var arr = standardsArr.map(function (item) {\n        return item.price;\n      }); //选择排序\n\n      for (var i = 0; i < arr.length; i++) {\n        var min = i;\n\n        for (var j = i + 1; j < arr.length; j++) {\n          if (arr[j] < arr[min]) {\n            min = j;\n          }\n        }\n\n        ;\n        var _ref2 = [arr[min], arr[i]];\n        arr[i] = _ref2[0];\n        arr[min] = _ref2[1];\n      }\n\n      if (arr[0] === arr[arr.length - 1]) {\n        return arr[0];\n      } else {\n        return arr[0] + '元 ~ ' + arr[arr.length - 1];\n      }\n    };\n\n    var change = function change(standard) {\n      showStore.value = true;\n      price.value = standard.price;\n      storeCount.value = standard.store;\n    };\n\n    var goToOrder = function goToOrder() {\n      if (isOffShelf.value) {\n        ElMessage.error('商品已下架');\n        return false;\n      }\n\n      if (isSoldOutAll.value) {\n        ElMessage.error('商品已售罄');\n        return false;\n      }\n\n      if (standards.value.length !== 0) {\n        if (checkedStandard.value === '') {\n          ElMessage.warning('请选择规格');\n          return false;\n        }\n\n        if (storeCount.value === 0) {\n          ElMessage.error('该规格已售罄');\n          return false;\n        }\n      }\n\n      router.push({\n        name: 'preOrder',\n        query: {\n          good: JSON.stringify(good.value),\n          realPrice: realPrice.value,\n          num: count.value,\n          standard: checkedStandard.value\n        }\n      });\n    };\n\n    var addToCart = function addToCart() {\n      //未登录，拦截\n      if (!localStorage.getItem('user')) {\n        router.push('/login');\n      }\n\n      if (isOffShelf.value) {\n        ElMessage.error('商品已下架');\n        return false;\n      }\n\n      if (isSoldOutAll.value) {\n        ElMessage.error('商品已售罄');\n        return false;\n      }\n\n      if (!checkedStandard.value) {\n        ElMessage.error('请选择规格');\n        return false;\n      }\n\n      if (storeCount.value === 0) {\n        ElMessage.error('该规格已售罄');\n        return false;\n      } // 从服务器获取当前用户的id，保证安全\n\n\n      API.get('/userid').then(function (res) {\n        var userId = res;\n        var cart = {\n          userId: userId,\n          goodId: goodId.value,\n          standard: checkedStandard.value,\n          count: count.value\n        };\n        API.post('/api/cart', cart).then(function (res) {\n          if (res.code === '200') {\n            ElMessage.success('成功添加购物车');\n          }\n        });\n      });\n    };\n\n    var isOffShelf = computed(function () {\n      return good.value && good.value.status === 0;\n    });\n    var isSoldOutAll = computed(function () {\n      return totalStore.value === 0 && standards.value.length > 0;\n    }); //折后价，小数点后2位\n\n    var realPrice = computed(function () {\n      if (good.value.discount < 1) {\n        //价格为范围，即不是数字，则返回一个范围\n        if (isNaN(price.value)) {\n          var down = price.value.substring(0, price.value.indexOf('元')) * good.value.discount;\n          var up = price.value.substring(price.value.lastIndexOf(' ')) * good.value.discount;\n          return down.toFixed(2) + '元 ~ ' + up.toFixed(2);\n        } else {\n          return (price.value * good.value.discount).toFixed(2);\n        }\n      }\n\n      return price.value;\n    });\n    onMounted(function () {\n      //初始化商品信息\n      goodId.value = route.params.goodId;\n      API.get('/api/good/' + goodId.value).then(function (res) {\n        if (res.code === '200') {\n          good.value = res.data;\n          var discountVal = good.value.discount;\n\n          if (discountVal < 1) {\n            isDiscount.value = true;\n            discount.value = discountVal * 10 + '折';\n          }\n        } else {\n          router.go(0);\n        }\n      }).catch(function (error) {\n        ElMessage.error(error.response.data);\n      }); //从服务器获取商品规格信息\n\n      API.get('/api/good/standard/' + goodId.value).then(function (res) {\n        if (res.code === '200') {\n          var standardsArr = JSON.parse(res.data);\n          standards.value = standardsArr;\n          totalStore.value = standardsArr.reduce(function (sum, item) {\n            return sum + (item.store || 0);\n          }, 0); //默认选择第一个标准\n\n          price.value = getPriceRange(standardsArr);\n        } else {\n          //没有规格\n          price.value = good.value.price;\n          storeCount.value = good.value.store;\n          showStore.value = true;\n        }\n      }).catch(function (error) {\n        ElMessage.error(error.response.data);\n      });\n    });\n    var __returned__ = {\n      store: store,\n      route: route,\n      router: router,\n      baseApi: baseApi,\n      good: good,\n      goodId: goodId,\n      price: price,\n      isDiscount: isDiscount,\n      discount: discount,\n      standards: standards,\n      checkedStandard: checkedStandard,\n      storeCount: storeCount,\n      showStore: showStore,\n      count: count,\n      totalStore: totalStore,\n      getPriceRange: getPriceRange,\n      change: change,\n      goToOrder: goToOrder,\n      addToCart: addToCart,\n      isOffShelf: isOffShelf,\n      isSoldOutAll: isSoldOutAll,\n      realPrice: realPrice,\n      ref: ref,\n      computed: computed,\n      onMounted: onMounted,\n\n      get useRoute() {\n        return useRoute;\n      },\n\n      get useRouter() {\n        return useRouter;\n      },\n\n      get ElMessage() {\n        return ElMessage;\n      },\n\n      get useStore() {\n        return useStore;\n      },\n\n      get API() {\n        return API;\n      }\n\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"mappings":";;;;;AAkIA,SAASA,GAAT,EAAcC,QAAd,EAAwBC,SAAxB,QAAyC,KAAzC;AACA,SAASC,QAAT,EAAmBC,SAAnB,QAAoC,YAApC;AACA,SAASC,SAAT,QAA0B,cAA1B;AACA,SAASC,QAAT,QAAyB,MAAzB;AACA,OAAOC,GAAP,MAAgB,iBAAhB;;;;;;;;AAEA,QAAMC,KAAK,GAAGF,QAAQ,EAAtB;AACA,QAAMG,KAAK,GAAGN,QAAQ,EAAtB;AACA,QAAMO,MAAM,GAAGN,SAAS,EAAxB;AAEA,QAAMO,OAAO,GAAGH,KAAK,CAACI,KAAN,CAAYD,OAA5B;AACA,QAAME,IAAI,GAAGb,GAAG,CAAC,EAAD,CAAhB;AACA,QAAMc,MAAM,GAAGd,GAAG,CAACe,MAAD,CAAlB;AACA,QAAMC,KAAK,GAAGhB,GAAG,CAAC,CAAC,CAAF,CAAjB;AACA,QAAMiB,UAAU,GAAGjB,GAAG,CAAC,KAAD,CAAtB;AACA,QAAMkB,QAAQ,GAAGlB,GAAG,CAAC,EAAD,CAApB;AACA,QAAMmB,SAAS,GAAGnB,GAAG,CAAC,EAAD,CAArB;AACA,QAAMoB,eAAe,GAAGpB,GAAG,CAAC,EAAD,CAA3B;AACA,QAAMqB,UAAU,GAAGrB,GAAG,CAAC,CAAD,CAAtB;AACA,QAAMsB,SAAS,GAAGtB,GAAG,CAAC,KAAD,CAArB;AACA,QAAMuB,KAAK,GAAGvB,GAAG,CAAC,CAAD,CAAjB;AACA,QAAMwB,UAAU,GAAGxB,GAAG,CAAC,CAAD,CAAtB;;AAEA,QAAMyB,aAAa,GAAG,SAAhBA,aAAgB,CAACC,YAAD,EAAkB;AACtC,UAAIC,GAAG,GAAGD,YAAY,CAACE,GAAb,CAAiB,UAACC,IAAD,EAAU;AACnC,eAAOA,IAAI,CAACb,KAAZ;AACD,OAFS,CAAV,CADsC,CAItC;;AACA,WAAK,IAAIc,CAAC,GAAG,CAAb,EAAgBA,CAAC