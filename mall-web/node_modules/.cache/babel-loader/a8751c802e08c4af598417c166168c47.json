else {\n          _this.$message.error(res.msg || \"提交失败\");\n        }\n      });\n    },\n    load: function load() {\n      var _this2 = this;\n\n      this.request.get(\"/api/message/mine/page\", {\n        params: {\n          pageNum: this.pageNum,\n          pageSize: this.pageSize\n        }\n      }).then(function (res) {\n        if (res.code === \"200\") {\n          _this2.tableData = res.data.records || [];\n          _this2.total = res.data.total || 0;\n        } else {\n          _this2.$message.error(res.msg || \"加载失败\");\n        }\n      });\n    },\n    handlePageChange: function handlePageChange(page) {\n      this.pageNum = page;\n      this.load();\n    },\n    openDetail: function openDetail(id) {\n      var _this3 = this;\n\n      this.request.get(\"/api/message/\" + id).then(function (res) {\n        if (res.code === \"200\") {\n          _this3.detail = res.data;\n          _this3.detailVisible = true;\n        } else {\n          _this3.$message.error(res.msg || \"加载失败\");\n        }\n      });\n    }\n  }\n};","map":{"version":3,"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAyFA;AACAA,iBADA;AAEAC,MAFA,kBAEA;AACA;AACAC;AACAC,iBADA;AAEAC,mBAFA;AAGAC,mBAHA;AAIAC;AAJA,OADA;AAOAC,mBAPA;AAQAC,gBARA;AASAC,kBATA;AAUAC,cAVA;AAWAC,0BAXA;AAYAC;AAZA;AAcA,GAjBA;AAkBAC,SAlBA,qBAkBA;AACA;AACA,GApBA;AAqBAC;AACAC,aADA,uBACA;AACA;AAAAZ;AAAAC;AAAAC;AAAAC;AAAA;AACA,KAHA;AAIAU,UAJA,oBAIA;AAAA;;AACA;AACA;AACA;;AACA;AACA;AACA;AACA;;AACA;AACA;AACA;AACA;;AACA;AACA;AACA;AACA;;AACA;AACA;AACA;AACA;;AACA;AACA;AACA;;AACA;;AACA;;AACA;AACA,SALA,MAKA;AACA;AACA;AACA,OATA;AAUA,KAlCA;AAmCAC,QAnCA,kBAmCA;AAAA;;AACA,mBACAC,GADA,CACA,wBADA,EACA;AACAC;AAAAX;AAAAC;AAAA;AADA,OADA,EAIAW,IAJA,CAIA;AACA;AACA;AACA;AACA,SAHA,MAGA;AACA;AACA;AACA,OAXA;AAYA,KAhDA;AAiDAC,oBAjDA,4BAiDAC,IAjDA,EAiDA;AACA;AACA;AACA,KApDA;AAqDAC,cArDA,sBAqDAC,EArDA,EAqDA;AAAA;;AACA;AACA;AACA;AACA;AACA,SAHA,MAGA;AACA;AACA;AACA,OAPA;AAQA;AA9DA;AArBA","names":["name","data","form","title","content","contact","customIntent","tableData","pageNum","pageSize","total","detailVisible","detail","created","methods","resetForm","submit","load","get","params","then","handlePageChange","page","openDetail","id"],"sourceRoot":"src/views/front","sources":["Message.vue"],"sourcesContent":["<template>\n  <div style=\"width: 90%; max-width: 1200px; margin: 20px auto\">\n    <el-card>\n      <div slot=\"header\" style=\"display: flex; justify-content: space-between; align-items: center\">\n        <span>在线留言</span>\n      </div>\n\n      <el-form label-width=\"90px\">\n        <el-form-item label=\"标题\">\n          <el-input v-model.trim=\"form.title\" maxlength=\"200\" show-word-limit></el-input>\n        </el-form-item>\n        <el-form-item label=\"联系方式\">\n          <el-input v-model.trim=\"form.contact\" maxlength=\"50\"></el-input>\n        </el-form-item>\n        <el-form-item label=\"定制意愿\">\n          <el-switch v-model=\"form.customIntent\" active-text=\"有\" inactive-text=\"无\"></el-switch>\n        </el-form-item>\n        <el-form-item label=\"内容\">\n          <el-input\n            type=\"textarea\"\n            :rows=\"5\"\n            v-model.trim=\"form.content\"\n            maxlength=\"2000\"\n            show-word-limit\n          ></el-input>\n        </el-form-item>\n        <el-form-item>\n          <el-button type=\"success\" @click=\"submit\">提交留言</el-button>\n          <el-button @click=\"resetForm\">清空</el-button>\n        </el-form-item>\n      </el-form>\n    </el-card>\n\n    <el-card style=\"margin-top: 18px\">\n      <div slot=\"header\" style=\"display: flex; justify-content: space-between; align-items: center\">\n        <span>我的留言</span>\n      </div>\n\n      <el-table :data=\"tableData\" stripe style=\"width: 100%\">\n        <el-table-column prop=\"createTime\" label=\"时间\" width=\"170\"></el-table-column>\n        <el-table-column prop=\"title\" label=\"标题\"></el-table-column>\n        <el-table-column label=\"定制意愿\" width=\"90\">\n          <template slot-scope=\"scope\">\n            <span>{{ scope.row.customIntent ? \"有\" : \"无\" }}</span>\n          </template>\n        </el-table-column>\n        <el-table-column label=\"回复\" width=\"90\">\n          <template slot-scope=\"scope\">\n            <span>{{ scope.row.reply ? \"已回复\" : \"未回复\" }}</span>\n          </template>\n        </el-table-column>\n        <el-table-column label=\"操作\" width=\"120\">\n          <template slot-scope=\"scope\">\n            <el-button type=\"text\" @click=\"openDetail(scope.row.id)\">查看</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n\n      <div style=\"padding: 15px 0; text-align: right\">\n        <el-pagination\n          background\n          layout=\"prev, pager, next\"\n          :current-page=\"pageNum\"\n          :page-size=\"pageSize\"\n          :total=\"total\"\n          @current-change=\"handlePageChange\"\n        ></el-pagination>\n      </div>\n    </el-card>\n\n    <el-dialog title=\"留言详情\" :visible.sync=\"detailVisible\" width=\"700px\">\n      <div v-if=\"detail\">\n        <div style=\"margin-bottom: 10px\"><b>标题：</b>{{ detail.title }}</div>\n        <div style=\"margin-bottom: 10px\"><b>联系方式：</b>{{ detail.contact }}</div>\n        <div style=\"margin-bottom: 10px\"><b>定制意愿：</b>{{ detail.customIntent ? \"有\" : \"无\" }}</div>\n        <div style=\"margin-bottom: 10px\"><b>内容：</b></div>\n        <div style=\"white-space: pre-wrap\">{{ detail.content }}</div>\n        <div style=\"margin: 14px 0 10px\"><b>管理员回复：</b></div>\n        <div v-if=\"detail.reply\" style=\"white-space: pre-wrap\">{{ detail.reply }}</div>\n        <div v-else>暂无回复</div>\n      </div>\n      <span slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"detailVisible = false\">关闭</el-button>\n      </span>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: \"Message\",\n  data() {\n    return {\n      form: {\n        title: \"\",\n        content: \"\",\n        contact: \"\",\n        customIntent: false,\n      },\n      tableData: [],\n      pageNum: 1,\n      pageSize: 10,\n      total: 0,\n      detailVisible: false,\n      detail: null,\n    };\n  },\n  created() {\n    this.load();\n  },\n  methods: {\n    resetForm() {\n      this.form = { title: \"\", content: \"\", contact: \"\", customIntent: false };\n    },\n    submit() {\n      const title = (this.form.title || \"\").trim();\n      const content = (this.form.content || \"\").trim();\n      const contact = (this.form.contact || \"\").trim();\n      if (!title) {\n        this.$message.error(\"标题不能为空\");\n        return;\n      }\n      if (!content) {\n        this.$message.error(\"内容不能为空\");\n        return;\n      }\n      if (!contact) {\n        this.$message.error(\"联系方式不能为空\");\n        return;\n      }\n      if (!/^[0-9\\-+() ]{7,20}$/.test(contact)) {\n        this.$message.error(\"联系方式格式不正确\");\n        return;\n      }\n      this.request.post(\"/api/message\", this.form).then((res) => {\n        if (res.code === \"200\") {\n          this.$message.success(\"提交成功\");\n          this.resetForm();\n          this.pageNum = 1;\n          this.load();\n        } else {\n          this.$message.error(res.msg || \"提交失败\");\n        }\n      });\n    },\n    load() {\n      this.request\n        .get(\"/api/message/mine/page\", {\n          params: { pageNum: this.pageNum, pageSize: this.pageSize },\n        })\n        .then((res) => {\n          if (res.code === \"200\") {\n            this.tableData = res.data.records || [];\n            this.total = res.data.total || 0;\n          } else {\n            this.$message.error(res.msg || \"加载失败\");\n          }\n        });\n    },\n    handlePageChange(page) {\n      this.pageNum = page;\n      this.load();\n    },\n    openDetail(id) {\n      this.request.get(\"/api/message/\" + id).then((res) => {\n        if (res.code === \"200\") {\n          this.detail = res.data;\n          this.detailVisible = true;\n        } else {\n          this.$message.error(res.msg || \"加载失败\");\n        }\n      });\n    },\n  },\n};\n</script>\n\n<style scoped></style>\n"]},"metadata":{},"sourceType":"module"}