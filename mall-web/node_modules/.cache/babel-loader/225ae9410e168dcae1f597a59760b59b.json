2px solid #e8e8e8;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);\n  display: inline-block;\n  vertical-align: top;\n  cursor: pointer;\n}\n\n.address-card.selected {\n  border: 3px solid #409EFF;\n  box-shadow: 0 4px 12px rgba(64, 158, 255, 0.3);\n}\n\n.card-header {\n  display: flex;\n  align-items: center;\n  margin-bottom: 15px;\n  padding-bottom: 12px;\n  border-bottom: 2px solid #f0f0f0;\n}\n\n.user-name {\n  font-size: 18px;\n  font-weight: 600;\n  color: #303133;\n}\n\n.card-body {\n  margin-bottom: 15px;\n}\n\n.info-row {\n  display: flex;\n  align-items: flex-start;\n  margin-bottom: 10px;\n  padding: 5px 0;\n}\n\n.info-row i {\n  font-size: 16px;\n  margin-right: 10px;\n  margin-top: 2px;\n  flex-shrink: 0;\n}\n\n.info-text {\n  font-size: 14px;\n  color: #606266;\n  line-height: 1.6;\n  word-break: break-all;\n}\n\n.card-footer {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding-top: 12px;\n  border-top: 1px solid #f0f0f0;\n}\n\n.action-btn {\n  font-size: 14px;\n  font-weight: 500;\n  padding: 5px 15px;\n  transition: all 0.3s ease;\n}\n\n.edit-btn {\n  color: #409EFF;\n}\n\n.edit-btn:hover {\n  color: #66b1ff;\n  background-color: #ecf5ff;\n}\n\n.delete-btn {\n  color: #F56C6C;\n}\n\n.delete-btn:hover {\n  color: #f78989;\n  background-color: #fef0f0;\n}\n</style>"]},"metadata":{},"sourceType":"module"}