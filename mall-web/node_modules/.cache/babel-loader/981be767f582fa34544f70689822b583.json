{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\nimport md5 from \"js-md5\";\nexport default {\n  name: \"Login\",\n\n  data() {\n    return {\n      user: {},\n      passwordRule: /^(?=.*[A-Za-z])(?=.*\\d)(?=.*[!@#$%^&*()_+\\-=\\[\\]{}|;:,.<>?])[A-Za-z\\d!@#$%^&*()_+\\-=\\[\\]{}|;:,.<>?]{6,12}$/\n    };\n  },\n\n  methods: {\n    onSubmit() {\n      const username = (this.user.username || \"\").trim();\n      const password = (this.user.password || \"\").trim();\n      const confirmPassword = (this.user.confirmPassword || \"\").trim();\n      const phone = (this.user.phone || \"\").trim();\n\n      if (!username || !password || !confirmPassword) {\n        this.$message.error(\"用户名或密码不能为空\");\n        return false;\n      }\n\n      if (!this.passwordRule.test(password)) {\n        this.$message.error(\"密码必须为6-12位，且同时包含字母、数字和特殊符号\");\n        return false;\n      }\n\n      if (!phone) {\n        this.$message.error(\"联系方式不能为空\");\n        return false;\n      }\n\n      if (!/^[0-9\\-+() ]{7,20}$/.test(phone)) {\n        this.$message.error(\"联系方式格式不正确\");\n        return false;\n      }\n\n      if (this.user.password !== this.user.confirmPassword) {\n        this.$message.error(\"两次密码不一致\");\n        return false;\n      }\n\n      let form = {};\n      Object.assign(form, this.user);\n      form.password = md5(this.user.password);\n      this.request.post(\"/register\", form).then(res => {\n        if (res.code === \"200\") {\n          this.$message.success(\"注册成功\");\n          this.$router.push(\"/login\");\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    }\n\n  },\n\n  mounted() {}\n\n};","map":{"version":3,"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA6DA;AAGA;AACAA,eADA;;AAEAC;AACA;AACAC,cADA;AAEAC;AAFA;AAIA,GAPA;;AAQAC;AACAC;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AACA;AACA;AACA;AACA;;AACA;AACA;AACA;AACA;;AACA;AACA;AACA;AACA;;AACA;AACA;AACA;AACA;;AACA;AACAC;AACAC;AACA;AACA;AACA;AACA;AACA,SAHA,MAGA;AACA;AACA;AACA,OAPA;AAQA;;AAtCA,GARA;;AAgDAC,aAEA;;AAlDA","names":["name","data","user","passwordRule","methods","onSubmit","Object","form","mounted"],"sourceRoot":"src/views","sources":["Register.vue"],"sourcesContent":["<!--\r\n * @Description: \r\n * @Author: gzc\r\n * @Date: 2024-03-21 15:27:05\r\n-->\r\n<template>\r\n    <div id=\"bk\" class=\"wrapper\">\r\n        <div class=\"login-box\">\r\n            <div class=\"title\">\r\n                <b>注 册</b>\r\n            </div>\r\n            <div style=\"margin-top: 30px\">\r\n                <el-form label-width=\"70px\">\r\n                    <el-form-item label=\"用户名\">\r\n                        <el-input\r\n                            v-model.trim=\"user.username\"\r\n                            aria-required=\"true\"\r\n                        ></el-input>\r\n                    </el-form-item>\r\n                    <el-form-item label=\"联系方式\" style=\"margin-top: 25px\">\r\n                        <el-input\r\n                            v-model.trim=\"user.phone\"\r\n                            aria-required=\"true\"\r\n                        ></el-input>\r\n                    </el-form-item>\r\n                    <el-form-item label=\"密码\" style=\"margin-top: 25px\">\r\n                        <el-input\r\n                            v-model.trim=\"user.password\"\r\n                            show-password\r\n                            aria-required=\"true\"\r\n                        ></el-input>\r\n                    </el-form-item>\r\n                    <el-form-item label=\"确认密码\" style=\"margin-top: 25px\">\r\n                        <el-input\r\n                            v-model.trim=\"user.confirmPassword\"\r\n                            show-password\r\n                            aria-required=\"true\"\r\n                        ></el-input>\r\n                    </el-form-item>\r\n                    <el-form-item style=\"text-align: center;\">\r\n                        <el-button\r\n                            type=\"success\"\r\n                            @click=\"onSubmit\"\r\n                            style=\"font-size: 22px\"\r\n                        >\r\n                             注册</el-button\r\n                        >\r\n                        <el-button\r\n                            @click=\"$router.push('/login')\"\r\n                            style=\"font-size: 22px\"\r\n                        >\r\n                             返回登录</el-button\r\n                        >\r\n                    </el-form-item>\r\n                </el-form>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nimport md5 from \"js-md5\";\r\n\r\n\r\nexport default {\r\n    name: \"Login\",\r\n    data() {\r\n        return {\r\n            user: {},\r\n            passwordRule: /^(?=.*[A-Za-z])(?=.*\\d)(?=.*[!@#$%^&*()_+\\-=\\[\\]{}|;:,.<>?])[A-Za-z\\d!@#$%^&*()_+\\-=\\[\\]{}|;:,.<>?]{6,12}$/,\r\n        };\r\n    },\r\n    methods: {\r\n        onSubmit() {\r\n            const username = (this.user.username || \"\").trim();\r\n            const password = (this.user.password || \"\").trim();\r\n            const confirmPassword = (this.user.confirmPassword || \"\").trim();\r\n            const phone = (this.user.phone || \"\").trim();\r\n\r\n            if (!username || !password || !confirmPassword) {\r\n                this.$message.error(\"用户名或密码不能为空\");\r\n                return false;\r\n            }\r\n            if (!this.passwordRule.test(password)) {\r\n                this.$message.error(\"密码必须为6-12位，且同时包含字母、数字和特殊符号\");\r\n                return false;\r\n            }\r\n            if (!phone) {\r\n                this.$message.error(\"联系方式不能为空\");\r\n                return false;\r\n            }\r\n            if (!/^[0-9\\-+() ]{7,20}$/.test(phone)) {\r\n                this.$message.error(\"联系方式格式不正确\");\r\n                return false;\r\n            }\r\n            if (this.user.password !== this.user.confirmPassword) {\r\n                this.$message.error(\"两次密码不一致\");\r\n                return false;\r\n            }\r\n            let form = {};\r\n            Object.assign(form, this.user);\r\n            form.password = md5(this.user.password);\r\n            this.request.post(\"/register\", form).then((res) => {\r\n                if (res.code === \"200\") {\r\n                    this.$message.success(\"注册成功\");\r\n                    this.$router.push(\"/login\");\r\n                } else {\r\n                    this.$message.error(res.msg);\r\n                }\r\n            });\r\n        },\r\n    },\r\n    mounted() {\r\n        \r\n    }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.wrapper {\r\n    height: 100vh;\r\n    /* background-image: linear-gradient(to top right,#42b983,#B3C0D1); */\r\n    background-color: #006400;\r\n    overflow: auto;\r\n}\r\n.login-box {\r\n    margin: 220px auto;\r\n    padding: 40px;\r\n    width: 450px;\r\n    height: 310px;\r\n    background-color: #ffffff;\r\n    border-radius: 10px;\r\n}\r\n.title {\r\n    text-align: center;\r\n    margin-top: 10px;\r\n    font-size: 25px;\r\n    color: #006400;\r\n}\r\n\r\n#bk {\r\n    position: fixed;\r\n    top: 0;\r\n    left: 0;\r\n    width: 100%;\r\n    overflow-y: auto;\r\n    height: 100%;\r\n    background: url(\"../resource/01.png\") center top / cover no-repeat;\r\n}\r\n</style>\r\n"]},"metadata":{},"sourceType":"module"}