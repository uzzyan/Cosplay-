{"ast":null,"code":"import \"core-js/modules/es.array.filter.js\";\nimport \"core-js/modules/es.object.to-string.js\";\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\nimport CartItem from \"@/components/CartItem\";\nexport default {\n  name: \"Cart\",\n  data: function data() {\n    return {\n      userId: 0,\n      carts: []\n    };\n  },\n  components: {\n    'cart-item': CartItem\n  },\n  created: function created() {\n    var _this = this;\n\n    this.request.get(\"/userid\").then(function (res) {\n      _this.userId = res;\n\n      _this.request.get(\"/api/cart/userid/\" + _this.userId).then(function (res) {\n        if (res.code === '200') {\n          _this.carts = res.data; // createTime 已经是格式化后的字符串，无需再次转换\n        }\n      });\n    });\n  },\n  methods: {\n    delItem: function delItem(id) {\n      this.carts = this.carts.filter(function (item) {\n        return item.id != id;\n      });\n    }\n  }\n};","map":{"version":3,"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAqCA;AACA;AACAA,cADA;AACAC,MADA,kBACA;AACA;AACAC,eADA;AAEAC;AAFA;AAIA,GANA;AAOAC;AACA;AADA,GAPA;AAUAC,SAVA,qBAUA;AAAA;;AACA;AACA;;AACA;AACA;AACA,iCADA,CAEA;AACA;AACA,OALA;AAMA,KARA;AAUA,GArBA;AAsBAC;AACAC,WADA,mBACAC,EADA,EACA;AACA;AAAA;AAAA;AACA;AAHA;AAtBA","names":["name","data","userId","carts","components","created","methods","delItem","id"],"sourceRoot":"src/views/front/good","sources":["Cart.vue"],"sourcesContent":["\r\n<template>\r\n<div class=\"cart-container\">\r\n  <div class=\"content-wrapper\">\r\n    <!-- 页面标题 -->\r\n    <div class=\"page-title-section\">\r\n      <div class=\"title-content\">\r\n        <i class=\"el-icon-shopping-cart-2 title-icon\"></i>\r\n        <h1 class=\"page-title\">我的购物车</h1>\r\n        <span class=\"cart-count\" v-if=\"carts.length > 0\">{{ carts.length }} 件商品</span>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 空状态 -->\r\n    <div v-if=\"carts.length === 0\" class=\"empty-box\">\r\n      <i class=\"el-icon-shopping-cart-full empty-icon\"></i>\r\n      <p class=\"empty-title\">购物车是空的哦</p>\r\n      <p class=\"empty-desc\">快去选购心仪的商品吧~</p>\r\n      <el-button type=\"primary\" size=\"medium\" @click=\"$router.push('/goodList')\" round>\r\n        去逛逛\r\n      </el-button>\r\n    </div>\r\n\r\n    <!-- 购物车列表 -->\r\n    <div v-else class=\"cart-list\">\r\n      <cart-item \r\n        v-for=\"cart in carts\" \r\n        :key=\"cart.id\"\r\n        :cart=\"cart\" \r\n        @delete=\"delItem\"\r\n      ></cart-item>\r\n    </div>\r\n  </div>\r\n</div>\r\n</template>\r\n\r\n<script>\r\nimport CartItem from \"@/components/CartItem\";\r\nexport default {\r\n  name: \"Cart\",  data(){\r\n    return{\r\n      userId: 0,\r\n      carts: [],\r\n    }\r\n  },\r\n  components:{\r\n    'cart-item': CartItem,\r\n  },\r\n  created() {\r\n    this.request.get(\"/userid\").then(res=> {\r\n      this.userId = res;\r\n      this.request.get(\"/api/cart/userid/\"+this.userId).then(res=>{\r\n        if(res.code==='200'){\r\n          this.carts = res.data;\r\n          // createTime 已经是格式化后的字符串，无需再次转换\r\n        }\r\n      })\r\n    })\r\n\r\n  },\r\n  methods:{\r\n    delItem(id){\r\n      this.carts = this.carts.filter(item => item.id != id)\r\n    }\r\n  },\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.cart-container {\r\n  padding: 30px 0;\r\n}\r\n\r\n.content-wrapper {\r\n  width: 90%;\r\n  max-width: 1400px;\r\n  margin: 0 auto;\r\n  background-color: white;\r\n  border-radius: 16px;\r\n  padding: 30px;\r\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\r\n}\r\n\r\n/* 页面标题 */\r\n.page-title-section {\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.title-content {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 15px;\r\n}\r\n\r\n.title-icon {\r\n  font-size: 36px;\r\n  color: #409EFF;\r\n}\r\n\r\n.page-title {\r\n  margin: 0;\r\n  font-size: 28px;\r\n  font-weight: 600;\r\n  color: #303133;\r\n}\r\n\r\n.cart-count {\r\n  background: #409EFF;\r\n  color: white;\r\n  padding: 6px 18px;\r\n  border-radius: 20px;\r\n  font-size: 14px;\r\n  font-weight: 500;\r\n  box-shadow: 0 2px 8px rgba(64, 158, 255, 0.3);\r\n}\r\n\r\n/* 购物车列表 */\r\n.cart-list {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 20px;\r\n}\r\n\r\n/* 空状态 */\r\n.empty-box {\r\n  text-align: center;\r\n  padding: 50px 40px;\r\n}\r\n\r\n.empty-icon {\r\n  font-size: 120px;\r\n  color: #dcdfe6;\r\n  margin-bottom: 20px;\r\n  display: block;\r\n}\r\n\r\n.empty-title {\r\n  font-size: 24px;\r\n  color: #606266;\r\n  margin: 15px 0 10px;\r\n  font-weight: 500;\r\n}\r\n\r\n.empty-desc {\r\n  font-size: 16px;\r\n  color: #909399;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n/* 响应式 */\r\n@media (max-width: 768px) {\r\n  .cart-container {\r\n    padding: 20px 10px;\r\n  }\r\n  \r\n  .title-content {\r\n    padding: 15px 20px;\r\n  }\r\n  \r\n  .page-title {\r\n    font-size: 22px;\r\n  }\r\n}\r\n</style>\r\n"]},"metadata":{},"sourceType":"module"}