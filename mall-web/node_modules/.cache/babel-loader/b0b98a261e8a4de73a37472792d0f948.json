{"ast":null,"code":"import \"core-js/modules/es.number.to-fixed.js\";\nimport \"core-js/modules/es.regexp.exec.js\";\nimport \"core-js/modules/es.string.replace.js\";\nexport default {\n  name: \"Pay\",\n  data: function data() {\n    return {\n      userId: 0,\n      money1: 0,\n      orderNo: '',\n      paymentDialogVisible: false,\n      selectedPayment: ''\n    };\n  },\n  created: function created() {\n    this.money = parseFloat(this.$route.query.money).toFixed(2);\n    this.orderNo = this.$route.query.orderNo;\n  },\n  methods: {\n    confirmPay: function confirmPay(paymentMethod) {\n      this.selectedPayment = paymentMethod;\n      this.paymentDialogVisible = true;\n    },\n    pay: function pay() {\n      var _this = this;\n\n      this.paymentDialogVisible = false;\n      this.request.post(\"/api/order/paid/\" + this.orderNo).then(function (res) {\n        if (res.code === '200') {\n          _this.$message.success(\"您成功支付 ¥\" + _this.money + \" 元\");\n\n          setTimeout(function () {\n            _this.$router.replace(\"/orderlist\");\n          }, 1000);\n        } else {\n          _this.$message.error(res.msg);\n        }\n      });\n    }\n  }\n};","map":{"version":3,"mappings":";;;AAuEA,eAAe;AACbA,MAAI,EAAE,KADO;AAEbC,MAFa,kBAEP;AACJ,WAAM;AACJC,YAAM,EAAE,CADJ;AAEJC,YAAM,EAAE,CAFJ;AAGJC,aAAO,EAAE,EAHL;AAIJC,0BAAoB,EAAE,KAJlB;AAKJC,qBAAe,EAAE;AALb,KAAN;AAOD,GAVY;AAWbC,SAXa,qBAWH;AACR,SAAKC,KAAL,GAAaC,UAAU,CAAC,KAAKC,MAAL,CAAYC,KAAZ,CAAkBH,KAAnB,CAAV,CAAoCI,OAApC,CAA4C,CAA5C,CAAb;AACA,SAAKR,OAAL,GAAe,KAAKM,MAAL,CAAYC,KAAZ,CAAkBP,OAAjC;AACD,GAdY;AAgBbS,SAAO,EAAC;AACNC,cADM,sBACKC,aADL,EACmB;AACvB,WAAKT,eAAL,GAAuBS,aAAvB;AACA,WAAKV,oBAAL,GAA4B,IAA5B;AACD,KAJK;AAKNW,OALM,iBAKD;AAAA;;AACH,WAAKX,oBAAL,GAA4B,KAA5B;AACA,WAAKY,OAAL,CAAaC,IAAb,CAAkB,qBAAmB,KAAKd,OAA1C,EAAmDe,IAAnD,CAAwD,aAAG,EAAE;AAC3D,YAAGC,GAAG,CAACC,IAAJ,KAAW,KAAd,EAAoB;AAClB,eAAI,CAACC,QAAL,CAAcC,OAAd,CAAsB,YAAY,KAAI,CAACf,KAAjB,GAAyB,IAA/C;;AACAgB,oBAAU,CAAC,YAAM;AACf,iBAAI,CAACC,OAAL,CAAaC,OAAb,CAAqB,YAArB;AACD,WAFS,EAEP,IAFO,CAAV;AAGD,SALD,MAKK;AACH,eAAI,CAACJ,QAAL,CAAcK,KAAd,CAAoBP,GAAG,CAACQ,GAAxB;AACF;AACD,OATD;AAWF;AAlBM;AAhBK,CAAf","names":["name","data","userId","money1","orderNo","paymentDialogVisible","selectedPayment","created","money","parseFloat","$route","query","toFixed","methods","confirmPay","paymentMethod","pay","request","post","then","res","code","$message","success","setTimeout","$router","replace","error","msg"],"sourceRoot":"","sources":["C:\\q_code4.12\\cosplay_mall(qoder)\\mall-web\\src\\views\\front\\order\\Pay.vue"],"sourcesContent":["\r\n<template>\r\n<div class=\"pay-container\">\r\n  <div class=\"content-wrapper\">\r\n    <!-- 页面标题 -->\r\n    <div class=\"page-header\">\r\n      <i class=\"el-icon-wallet header-icon\"></i>\r\n      <h2 class=\"page-title\">订单支付</h2>\r\n    </div>\r\n\r\n    <!-- 订单信息 -->\r\n    <div class=\"order-info\">\r\n      <div class=\"info-item\">\r\n        <span class=\"label\">订单号：</span>\r\n        <span class=\"value\">{{ orderNo }}</span>\r\n      </div>\r\n      <div class=\"info-item amount\">\r\n        <span class=\"label\">支付金额：</span>\r\n        <span class=\"amount-value\">\r\n          <span class=\"symbol\">¥</span>\r\n          <span class=\"number\">{{ money }}</span>\r\n        </span>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 支付方式 -->\r\n    <div class=\"payment-section\">\r\n      <div class=\"section-title\">\r\n        <i class=\"el-icon-bank-card\"></i>\r\n        选择支付方式\r\n      </div>\r\n      <div class=\"payment-methods\">\r\n        <div class=\"payment-item\" @click=\"confirmPay('微信支付')\">\r\n          <img src=\"../../../resource/img/微信支付.png\" alt=\"微信支付\" class=\"payment-icon\">\r\n          <span class=\"payment-name\">微信支付</span>\r\n        </div>\r\n        <div class=\"payment-item\" @click=\"confirmPay('支付宝')\">\r\n          <img src=\"../../../resource/img/支付宝.png\" alt=\"支付宝\" class=\"payment-icon\">\r\n          <span class=\"payment-name\">支付宝</span>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 提示信息 -->\r\n    <div class=\"tips\">\r\n      <i class=\"el-icon-info\"></i>\r\n      <span>请选择支付方式完成支付</span>\r\n    </div>\r\n\r\n    <!-- 支付确认对话框 -->\r\n    <el-dialog\r\n      title=\"确认支付\"\r\n      :visible.sync=\"paymentDialogVisible\"\r\n      width=\"400px\"\r\n      center\r\n    >\r\n      <div class=\"dialog-content\">\r\n        <i class=\"el-icon-warning-outline dialog-icon\"></i>\r\n        <p class=\"dialog-text\">确认使用<strong>{{ selectedPayment }}</strong>支付</p>\r\n        <p class=\"dialog-amount\">¥{{ money }}</p>\r\n      </div>\r\n      <span slot=\"footer\" class=\"dialog-footer\">\r\n        <el-button @click=\"paymentDialogVisible = false\">取消</el-button>\r\n        <el-button type=\"primary\" @click=\"pay\">确认支付</el-button>\r\n      </span>\r\n    </el-dialog>\r\n  </div>\r\n</div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"Pay\",\r\n  data(){\r\n    return{\r\n      userId: 0,\r\n      money1: 0,\r\n      orderNo: '',\r\n      paymentDialogVisible: false,\r\n      selectedPayment: '',\r\n    }\r\n  },\r\n  created() {\r\n    this.money = parseFloat(this.$route.query.money).toFixed(2);\r\n    this.orderNo = this.$route.query.orderNo;\r\n  },\r\n\r\n  methods:{\r\n    confirmPay(paymentMethod){\r\n      this.selectedPayment = paymentMethod;\r\n      this.paymentDialogVisible = true;\r\n    },\r\n    pay(){\r\n      this.paymentDialogVisible = false;\r\n      this.request.post(\"/api/order/paid/\"+this.orderNo).then(res=>{\r\n        if(res.code==='200'){\r\n          this.$message.success(\"您成功支付 ¥\" + this.money + \" 元\");\r\n          setTimeout(() => {\r\n            this.$router.replace(\"/orderlist\");\r\n          }, 1000);\r\n        }else{\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n\r\n    }\r\n  }\r\n\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.pay-container {\r\n  padding: 30px 0;\r\n}\r\n\r\n.content-wrapper {\r\n  width: 90%;\r\n  max-width: 600px;\r\n  margin: 0 auto;\r\n  background-color: white;\r\n  border-radius: 16px;\r\n  padding: 30px;\r\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\r\n}\r\n\r\n/* 页面标题 */\r\n.page-header {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 10px;\r\n  margin-bottom: 30px;\r\n  padding-bottom: 15px;\r\n  border-bottom: 2px solid #f0f0f0;\r\n}\r\n\r\n.header-icon {\r\n  font-size: 28px;\r\n  color: #67C23A;\r\n}\r\n\r\n.page-title {\r\n  margin: 0;\r\n  font-size: 24px;\r\n  font-weight: 600;\r\n  color: #303133;\r\n}\r\n\r\n/* 订单信息 */\r\n.order-info {\r\n  background: #f5f7fa;\r\n  border-radius: 12px;\r\n  padding: 25px;\r\n  margin-bottom: 25px;\r\n}\r\n\r\n.info-item {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  padding: 10px 0;\r\n}\r\n\r\n.info-item.amount {\r\n  margin-top: 12px;\r\n  padding-top: 15px;\r\n  border-top: 2px dashed #e0e0e0;\r\n}\r\n\r\n.label {\r\n  font-size: 15px;\r\n  color: #606266;\r\n  font-weight: 500;\r\n}\r\n\r\n.value {\r\n  font-size: 15px;\r\n  color: #303133;\r\n  font-family: monospace;\r\n  font-weight: 600;\r\n}\r\n\r\n.amount-value {\r\n  display: flex;\r\n  align-items: baseline;\r\n  color: #ff4d4f;\r\n}\r\n\r\n.amount-value .symbol {\r\n  font-size: 20px;\r\n  font-weight: 600;\r\n  margin-right: 4px;\r\n}\r\n\r\n.amount-value .number {\r\n  font-size: 30px;\r\n  font-weight: 700;\r\n}\r\n\r\n/* 支付方式 */\r\n.payment-section {\r\n  margin-bottom: 25px;\r\n}\r\n\r\n.section-title {\r\n  font-size: 16px;\r\n  font-weight: 600;\r\n  color: #303133;\r\n  margin-bottom: 20px;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.section-title i {\r\n  font-size: 18px;\r\n  color: #409EFF;\r\n}\r\n\r\n.payment-methods {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, 1fr);\r\n  gap: 15px;\r\n}\r\n\r\n.payment-item {\r\n  background: white;\r\n  border: 2px solid #e0e0e0;\r\n  border-radius: 12px;\r\n  padding: 25px 20px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 12px;\r\n  cursor: pointer;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.payment-item:hover {\r\n  border-color: #67C23A;\r\n  box-shadow: 0 4px 16px rgba(103, 194, 58, 0.2);\r\n  transform: translateY(-4px);\r\n}\r\n\r\n.payment-icon {\r\n  width: 50px;\r\n  height: 50px;\r\n  object-fit: contain;\r\n}\r\n\r\n.payment-name {\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n  color: #606266;\r\n}\r\n\r\n.payment-item:hover .payment-name {\r\n  color: #67C23A;\r\n}\r\n\r\n/* 提示信息 */\r\n.tips {\r\n  text-align: center;\r\n  color: #909399;\r\n  font-size: 14px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 8px;\r\n  padding: 15px;\r\n  background: #f0f9ff;\r\n  border-radius: 8px;\r\n}\r\n\r\n.tips i {\r\n  font-size: 16px;\r\n  color: #409EFF;\r\n}\r\n\r\n/* 确认对话框 */\r\n.dialog-content {\r\n  text-align: center;\r\n  padding: 20px;\r\n}\r\n\r\n.dialog-icon {\r\n  font-size: 60px;\r\n  color: #E6A23C;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.dialog-text {\r\n  font-size: 16px;\r\n  color: #606266;\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.dialog-text strong {\r\n  color: #409EFF;\r\n}\r\n\r\n.dialog-amount {\r\n  font-size: 32px;\r\n  color: #ff4d4f;\r\n  font-weight: 700;\r\n  margin: 10px 0;\r\n}\r\n\r\n/* 响应式 */\r\n@media (max-width: 768px) {\r\n  .content-wrapper {\r\n    width: 95%;\r\n    padding: 25px 20px;\r\n  }\r\n\r\n  .payment-methods {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .amount-value .number {\r\n    font-size: 24px;\r\n  }\r\n}\r\n</style>\r\n"]},"metadata":{},"sourceType":"module"}