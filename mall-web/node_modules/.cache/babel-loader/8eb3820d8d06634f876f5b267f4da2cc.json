ion (res) {\n        if (res.code === '200') {\n          ElMessage.success('回复成功');\n          replyVisible.value = false;\n          load();\n        } else {\n          ElMessage.error(res.msg || '回复失败');\n        }\n      });\n    };\n\n    var del = function del(id) {\n      request.delete('/api/message/' + id).then(function (res) {\n        if (res.code === '200') {\n          ElMessage.success('删除成功');\n          load();\n        } else {\n          ElMessage.error(res.msg || '删除失败');\n        }\n      });\n    };\n\n    onMounted(function () {\n      load();\n    });\n    var __returned__ = {\n      tableData: tableData,\n      pageNum: pageNum,\n      pageSize: pageSize,\n      total: total,\n      searchText: searchText,\n      customIntentFilter: customIntentFilter,\n      detailVisible: detailVisible,\n      detail: detail,\n      replyVisible: replyVisible,\n      replyForm: replyForm,\n      load: load,\n      handlePageChange: handlePageChange,\n      openDetail: openDetail,\n      openReply: openReply,\n      submitReply: submitReply,\n      del: del,\n      ref: ref,\n      onMounted: onMounted,\n\n      get ElMessage() {\n        return ElMessage;\n      },\n\n      get request() {\n        return request;\n      }\n\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"mappings":"AAyFA,SAASA,GAAT,EAAcC,SAAd,QAA+B,KAA/B;AACA,SAASC,SAAT,QAA0B,cAA1B;AACA,OAAOC,OAAP,MAAoB,iBAApB;;;;;;;;AAEA,QAAMC,SAAS,GAAGJ,GAAG,CAAC,EAAD,CAArB;AACA,QAAMK,OAAO,GAAGL,GAAG,CAAC,CAAD,CAAnB;AACA,QAAMM,QAAQ,GAAGN,GAAG,CAAC,EAAD,CAApB;AACA,QAAMO,KAAK,GAAGP,GAAG,CAAC,CAAD,CAAjB;AACA,QAAMQ,UAAU,GAAGR,GAAG,CAAC,EAAD,CAAtB;AACA,QAAMS,kBAAkB,GAAGT,GAAG,CAAC,IAAD,CAA9B;AACA,QAAMU,aAAa,GAAGV,GAAG,CAAC,KAAD,CAAzB;AACA,QAAMW,MAAM,GAAGX,GAAG,CAAC,IAAD,CAAlB;AACA,QAAMY,YAAY,GAAGZ,GAAG,CAAC,KAAD,CAAxB;AACA,QAAMa,SAAS,GAAGb,GAAG,CAAC;AACpBc,QAAE,EAAE,IADgB;AAEpBC