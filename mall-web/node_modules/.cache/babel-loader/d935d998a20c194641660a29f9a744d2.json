rue;\n      this.menuFlags.goodMenu = true;\n      this.menuFlags.carouselMenu = true;\n      this.menuFlags.orderMenu = true;\n      this.menuFlags.messageMenu = true;\n      this.menuFlags.afterSaleMenu = true;\n      this.menuFlags.incomeChartMenu = true;\n      this.menuFlags.incomeRankMenu = true;\n    }\n  }\n};","map":{"version":3,"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAsFA;AAGA;AACAA,eADA;AAEAC;AACAC;AADA,GAFA;AAKAC,MALA,kBAKA;AACA;AACAC,kBADA;AAEAC;AACAC,uBADA;AAEAC,uBAFA;AAGAC,yBAHA;AAIAC,uBAJA;AAKAC,2BALA;AAMAC,wBANA;AAOAC,2BAPA;AAQAC,0BARA;AASAC,4BATA;AAUAC,8BAVA;AAWAC;AAXA;AAFA;AAgBA,GAtBA;AAuBAC;AACAC;AACA;AACA,KAHA;AAIAC;AACA;AACA;AANA,GAvBA;AA+BAC,SA/BA,qBA+BA,CAEA,CAjCA;AAkCAC,SAlCA,qBAkCA;AAAA;;AACA;AACA;;AACA;AACA;;AACA;AACA;AACA;AACA;AACA,KATA,CAUA;;;AACAC;AACA;AACA;;AACA;AACA;AACA;AACA;AACA,KAPA;AAQA,GArDA;AAsDAC;AACAC,iBADA,2BACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AAbA;AAtDA","names":["name","props","isCollapse","data","role","menuFlags","userMenu","fileMenu","avatarMenu","goodMenu","carouselMenu","orderMenu","categoryMenu","messageMenu","afterSaleMenu","incomeChartMenu","incomeRankMenu","computed","fileGroup","incomeGroup","mounted","created","request","methods","setAdminMenus"],"sourceRoot":"src/components","sources":["Aside.vue"],"sourcesContent":["<template>\r\n  <el-menu :default-openeds=\"['file', 'report']\" style=\"height: 100%;\"\r\n           background-color=\"transparent\"\r\n           text-color =\"#333\"\r\n           :collapse-transition=\"false\"\r\n           :collapse=\"isCollapse\"\r\n           router\r\n           class=\"gradient-menu\"\r\n  >\r\n    <div style=\"height: 60px;margin-left: 30px; line-height: 60px\">\r\n      <!--<router-link to=\"/manage/home\">\r\n        <img src=\"../resource/logo.png\" style=\"width: 32px;position: relative; top: 7px;right: 6px;\">\r\n      </router-link>-->\r\n      <span slot=\"title\" style=\"color: #333;font-size: 20px;font-weight: 600;\" v-show=\"!isCollapse\">U次元 - Cosplay服装商城</span>\r\n    </div>\r\n    <!-- 用户管理 -->\r\n    <el-menu-item index=\"/manage/user\" v-if=\"menuFlags.userMenu\" class=\"el-item-menu\" style=\"font-size: 16px\">\r\n      <i class=\"el-icon-user\" style=\"font-size: 20px;color: #606266;\"></i>\r\n      <span slot=\"title\">用户管理</span>\r\n    </el-menu-item>\r\n\r\n    <!-- 分类管理 -->\r\n    <el-menu-item index=\"/manage/category\" v-if=\"menuFlags.categoryMenu\" class=\"el-item-menu\" style=\"font-size: 16px\">\r\n      <i class=\"el-icon-menu\" style=\"font-size: 20px;color: #606266;\"></i>\r\n      <span slot=\"title\">分类管理</span>\r\n    </el-menu-item>\r\n\r\n    <!-- 商品管理 -->\r\n    <el-menu-item index=\"/manage/good\" v-if=\"menuFlags.goodMenu\" class=\"el-item-menu\" style=\"font-size: 16px\">\r\n      <i class=\"el-icon-goods\" style=\"font-size: 20px;color: #606266;\"></i>\r\n      <span slot=\"title\">商品管理</span>\r\n    </el-menu-item>\r\n\r\n    <!-- 订单管理 -->\r\n    <el-menu-item index=\"/manage/order\" v-if=\"menuFlags.orderMenu\" class=\"el-item-menu\" style=\"font-size: 16px\">\r\n      <i class=\"el-icon-document\" style=\"font-size: 20px;color: #606266;\"></i>\r\n      <span slot=\"title\">订单管理</span>\r\n    </el-menu-item>\r\n\r\n    <!-- 轮播图管理 -->\r\n    <el-menu-item index=\"/manage/carousel\" v-if=\"menuFlags.carouselMenu\" class=\"el-item-menu\" style=\"font-size: 16px\">\r\n      <i class=\"el-icon-picture-outline\" style=\"font-size: 20px;color: #606266;\"></i>\r\n      <span slot=\"title\">轮播图管理</span>\r\n    </el-menu-item>\r\n\r\n    <!-- 留言管理 -->\r\n    <el-menu-item index=\"/manage/message\" v-if=\"menuFlags.messageMenu\" class=\"el-item-menu\" style=\"font-size: 16px\">\r\n      <i class=\"el-icon-chat-dot-round\" style=\"font-size: 20px;color: #606266;\"></i>\r\n      <span slot=\"title\">留言管理</span>\r\n    </el-menu-item>\r\n\r\n    <!-- 售后管理 -->\r\n    <el-menu-item index=\"/manage/afterSale\" v-if=\"menuFlags.afterSaleMenu\" class=\"el-item-menu\" style=\"font-size: 16px\">\r\n      <i class=\"el-icon-s-order\" style=\"font-size: 20px;color: #606266;\"></i>\r\n      <span slot=\"title\">售后管理</span>\r\n    </el-menu-item>\r\n\r\n    <!-- 文件管理 -->\r\n    <el-submenu v-if=\"fileGroup\" index=\"file\" class=\"el-item-menu\" style=\"font-size: 16px\">\r\n      <template slot=\"title\">\r\n        <i class=\"el-icon-folder-opened\" style=\"font-size: 20px;color: #606266;\"></i>\r\n        <span slot=\"title\">文件管理</span>\r\n      </template>\r\n      <el-menu-item index=\"/manage/file\" v-if=\"menuFlags.fileMenu\">文件管理</el-menu-item>\r\n      <el-menu-item index=\"/manage/avatar\" v-if=\"menuFlags.avatarMenu\">头像管理</el-menu-item>\r\n    </el-submenu>\r\n\r\n    <!-- 数据报表 -->\r\n    <el-submenu v-if=\"incomeGroup\" index=\"report\" class=\"el-item-menu\" style=\"font-size: 16px\">\r\n      <template slot=\"title\">\r\n        <i class=\"el-icon-data-analysis\" style=\"font-size: 20px;color: #606266;\"></i>\r\n        <span slot=\"title\">数据报表</span>\r\n      </template>\r\n      <el-menu-item index=\"/manage/incomeChart\" v-if=\"menuFlags.incomeChartMenu\">图表数据</el-menu-item>\r\n      <el-menu-item index=\"/manage/incomeRank\" v-if=\"menuFlags.incomeRankMenu\">收入数据</el-menu-item>\r\n    </el-submenu>\r\n\r\n    <!-- 前台 -->\r\n    <el-menu-item index=\"/\" class=\"el-item-menu\" style=\"font-size: 16px\">\r\n      <i class=\"el-icon-s-home\" style=\"font-size: 20px;color: #606266;\"></i>\r\n      <span slot=\"title\">前台首页</span>\r\n    </el-menu-item>\r\n  </el-menu>\r\n</template>\r\n\r\n<script>\r\nimport request from \"@/utils/request\";\r\n\r\n\r\nexport default {\r\n  name: \"Aside\",\r\n  props: {\r\n    isCollapse: Boolean,\r\n  },\r\n  data() {\r\n    return{\r\n      role : 'user',\r\n      menuFlags: {\r\n        userMenu: false,\r\n        fileMenu: false,\r\n        avatarMenu: false,\r\n        goodMenu: false,\r\n        carouselMenu: false,\r\n        orderMenu: false,\r\n        categoryMenu: false,\r\n        messageMenu: false,\r\n        afterSaleMenu: false,\r\n        incomeChartMenu: false,\r\n        incomeRankMenu: false,\r\n      }\r\n    }\r\n  },\r\n  computed: {\r\n    fileGroup: function (){\r\n      return this.menuFlags.fileMenu || this.menuFlags.avatarMenu\r\n    },\r\n    incomeGroup: function () {\r\n      return this.menuFlags.incomeChartMenu || this.menuFlags.incomeRankMenu\r\n    }\r\n  },\r\n  mounted() {\r\n\r\n  },\r\n  created() {\r\n    // 先从 localStorage 读取角色，立即显示菜单（避免闪烁）\r\n    let stored = localStorage.getItem(\"user\");\r\n    if (stored) {\r\n      let parsedUser = JSON.parse(stored);\r\n      if (parsedUser.role === 'admin') {\r\n        this.role = 'admin';\r\n        this.setAdminMenus();\r\n      }\r\n    }\r\n    // 再从后端确认角色\r\n    request.post(\"/role\").then(res=>{\r\n      if(res.code==='200'){\r\n        this.role = res.data;\r\n        if(this.role === 'admin'){\r\n          this.setAdminMenus();\r\n        }\r\n      }\r\n    })\r\n  },\r\n  methods: {\r\n    setAdminMenus() {\r\n      this.menuFlags.userMenu = true;\r\n      this.menuFlags.fileMenu = true;\r\n      this.menuFlags.avatarMenu = true;\r\n      this.menuFlags.categoryMenu = true;\r\n      this.menuFlags.goodMenu = true;\r\n      this.menuFlags.carouselMenu = true;\r\n      this.menuFlags.orderMenu = true;\r\n      this.menuFlags.messageMenu = true;\r\n      this.menuFlags.afterSaleMenu = true;\r\n      this.menuFlags.incomeChartMenu = true;\r\n      this.menuFlags.incomeRankMenu = true;\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.gradient-menu {\r\n  background: linear-gradient(180deg, #f5f3ff 0%, #f0f9ff 100%) !important;\r\n}\r\n\r\n/* 菜单项悬停效果 */\r\n.gradient-menu >>> .el-menu-item:hover {\r\n  background-color: rgba(64, 158, 255, 0.1) !important;\r\n}\r\n\r\n/* 子菜单标题悬停效果 */\r\n.gradient-menu >>> .el-submenu__title:hover {\r\n  background-color: rgba(64, 158, 255, 0.1) !important;\r\n}\r\n\r\n/* 激活状态的菜单项 */\r\n.gradient-menu >>> .el-menu-item.is-active {\r\n  background-color: rgba(64, 158, 255, 0.15) !important;\r\n  color: #409EFF !important;\r\n}\r\n\r\n/* 激活状态的菜单项图标 */\r\n.gradient-menu >>> .el-menu-item.is-active i {\r\n  color: #409EFF !important;\r\n}\r\n\r\n/* 子菜单项 */\r\n.gradient-menu >>> .el-menu {\r\n  background-color: transparent !important;\r\n}\r\n\r\n/* 子菜单项悬停 */\r\n.gradient-menu >>> .el-menu--inline .el-menu-item:hover {\r\n  background-color: rgba(64, 158, 255, 0.08) !important;\r\n}\r\n\r\n/* 展开的子菜单背景 */\r\n.gradient-menu >>> .el-menu--inline {\r\n  background-color: rgba(255, 255, 255, 0.3) !important;\r\n}\r\n</style>\r\n"]},"metadata":{},"sourceType":"module"}