earchText\"\r\n                @keyup.enter=\"load\"\r\n                style=\"width: 200px\"\r\n            >\r\n                <template #prefix>\r\n                    <i class=\"el-input__icon iconfont icon-r-find\"></i>\r\n                </template>\r\n            </el-input>\r\n            <el-button @click=\"reset\" type=\"warning\" style=\"margin: 10px\">\r\n                \r\n                重置\r\n            </el-button>\r\n            <el-button @click=\"load\" type=\"primary\" style=\"margin: 10px\">\r\n                \r\n                搜索\r\n            </el-button>\r\n            <el-button @click=\"exportOrders\" type=\"success\" style=\"margin: 10px\">\r\n                导出订单\r\n            </el-button>\r\n        </div>\r\n        <el-table :data=\"tableData\" border stripe style=\"width: 100%\">\r\n            <el-table-column prop=\"id\" label=\"ID\" width=\"50\" sortable>\r\n            </el-table-column>\r\n            <el-table-column\r\n                prop=\"orderNo\"\r\n                label=\"订单编号\"\r\n                width=\"200\"\r\n            ></el-table-column>\r\n            <el-table-column\r\n                prop=\"totalPrice\"\r\n                label=\"总价\"\r\n                width=\"100\"\r\n            ></el-table-column>\r\n            <el-table-column\r\n                prop=\"userId\"\r\n                label=\"下单人id\"\r\n                width=\"100\"\r\n            ></el-table-column>\r\n            <el-table-column\r\n                prop=\"linkUser\"\r\n                label=\"联系人\"\r\n                width=\"150\"\r\n            ></el-table-column>\r\n            <el-table-column\r\n                prop=\"linkPhone\"\r\n                label=\"联系电话\"\r\n            ></el-table-column>\r\n            <el-table-column\r\n                prop=\"linkAddress\"\r\n                label=\"送货地址\"\r\n                width=\"300\"\r\n            ></el-table-column>\r\n            <el-table-column prop=\"state\" label=\"状态\" width=\"100\">\r\n                <template slot-scope=\"scope\">\r\n                    <el-tag\r\n                        type=\"success\"\r\n                        v-if=\"scope.row.state === '已支付'\"\r\n                        >{{ scope.row.state }}</el-tag\r\n                    >\r\n                    <el-tag\r\n                        type=\"primary\"\r\n                        v-if=\"scope.row.state === '已发货'\"\r\n                        >{{ scope.row.state }}</el-tag\r\n                    >\r\n                    <el-tag type=\"info\" v-if=\"scope.row.state === '已收货'\">{{\r\n                        scope.row.state\r\n                    }}</el-tag>\r\n                </template>\r\n            </el-table-column>\r\n            <el-table-column\r\n                prop=\"createTime\"\r\n                label=\"下单时间\"\r\n            ></el-table-column>\r\n            <el-table-column fixed=\"right\" label=\"操作\" width=\"250\">\r\n                <template #default=\"scope\">\r\n                    <el-button\r\n                        type=\"primary\"\r\n                        @click=\"showDetail(scope.row)\"\r\n                    >\r\n                        详情\r\n                    </el-button>\r\n                    <el-popconfirm\r\n                        @confirm=\"delivery(scope.row)\"\r\n                        title=\"确定发货吗？\"\r\n                        v-if=\"scope.row.state === '已支付'\"\r\n                    >\r\n                        <template #reference>\r\n                            <el-button\r\n                                type=\"primary\"\r\n                                style=\"margin-left: 10px\"\r\n                            >\r\n                                发货\r\n                            </el-button>\r\n                        </template>\r\n                    </el-popconfirm>\r\n                </template>\r\n            </el-table-column>\r\n        </el-table>\r\n        <!--    分页-->\r\n        <div style=\"margin-top: 10px\">\r\n            <el-pagination\r\n                @size-change=\"handleSizeChange\"\r\n                @current-change=\"handleCurrentChange\"\r\n                :current-page=\"pageNum\"\r\n                :page-size=\"pageSize\"\r\n                :page-sizes=\"[3, 5, 8, 10]\"\r\n                layout=\"total, sizes, prev, pager, next, jumper\"\r\n                :total=\"total\"\r\n            >\r\n            </el-pagination>\r\n        </div>\r\n        <!--    详情弹窗-->\r\n        <el-dialog v-model=\"dialogFormVisible\">\r\n            <el-table :data=\"detail\" background-color=\"black\">\r\n                <el-table-column label=\"图片\" width=\"150\">\r\n                    <template #default=\"scope\">\r\n                        <img\r\n                            :src=\"baseApi + scope.row.img\"\r\n                            min-width=\"100\"\r\n                            height=\"100\"\r\n                        />\r\n                    </template>\r\n                </el-table-column>\r\n\r\n                <el-table-column prop=\"goodId\" label=\"商品id\"></el-table-column>\r\n                <el-table-column\r\n                    prop=\"goodName\"\r\n                    label=\"商品名称\"\r\n                ></el-table-column>\r\n                <el-table-column\r\n                    prop=\"standard\"\r\n                    label=\"商品规格\"\r\n                ></el-table-column>\r\n                <el-table-column prop=\"price\" label=\"单价\"></el-table-column>\r\n                <el-table-column prop=\"discount\" label=\"折扣\"></el-table-column>\r\n                <el-table-column label=\"实价\">\r\n                    <template #default=\"scope\">\r\n                        {{ scope.row.price * scope.row.discount }}\r\n                    </template>\r\n                </el-table-column>\r\n                <el-table-column prop=\"count\" label=\"数量\"></el-table-column>\r\n                <el-table-column label=\"总价\">\r\n                    <template #default=\"scope\">\r\n                        {{\r\n                            scope.row.price *\r\n                            scope.row.discount *\r\n                            scope.row.count\r\n                        }}\r\n                    </template>\r\n                </el-table-column>\r\n            </el-table>\r\n        </el-dialog>\r\n    </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, onMounted } from 'vue'\r\nimport { ElMessage } from 'element-plus'\r\nimport { useStore } from 'vuex'\r\nimport API from '@/utils/request'\r\n\r\nconst store = useStore()\r\n\r\nconst options = ref([])\r\nconst searchMode = ref('')\r\nconst searchText = ref('')\r\nconst user = ref({})\r\nconst tableData = ref([])\r\nconst pageNum = ref(1)\r\nconst pageSize = ref(8)\r\nconst entity = ref({})\r\nconst total = ref(0)\r\nconst dialogFormVisible = ref(false)\r\nconst detail = ref([])\r\nconst baseApi = store.state.baseApi\r\n\r\nconst url = '/api/order/'\r\n\r\nconst handleSizeChange = (pageSizeVal) => {\r\n  pageSize.value = pageSizeVal\r\n  load()\r\n}\r\n\r\nconst handleCurrentChange = (pageNumVal) => {\r\n  pageNum.value = pageNumVal\r\n  load()\r\n}\r\n\r\nconst reset = () => {\r\n  searchMode.value = ''\r\n  searchText.value = ''\r\n  load()\r\n}\r\n\r\nconst load = () => {\r\n  API.get(url + '/page', {\r\n    params: {\r\n      pageNum: pageNum.value,\r\n      pageSize: pageSize.value,\r\n      orderNo: searchText.value,\r\n      state: searchMode.value\r\n    }\r\n  })\r\n    .then((res) => {\r\n      tableData.value = res.data.records || []\r\n      total.value = res.data.total\r\n    })\r\n    .catch((e) => {\r\n      if (e.response.data == undefined) {\r\n        ElMessage({\r\n          showClose: true,\r\n          message: e,\r\n          type: 'error',\r\n          duration: 5000\r\n        })\r\n      } else {\r\n        ElMessage({\r\n          showClose: true,\r\n          message: e.response.data,\r\n          type: 'error',\r\n          duration: 5000\r\n        })\r\n      }\r\n    })\r\n}\r\n\r\nconst exportOrders = () => {\r\n  API({\r\n    url: url + 'export',\r\n    method: 'get',\r\n    params: {\r\n      orderNo: searchText.value,\r\n      state: searchMode.value\r\n    },\r\n    responseType: 'blob'\r\n  }).then((data) => {\r\n    const blob = new Blob([data], { type: 'text/csv;charset=utf-8;' })\r\n    const urlObject = window.URL.createObjectURL(blob)\r\n    const a = document.createElement('a')\r\n    const now = new Date()\r\n    const pad = (n) => (n < 10 ? '0' + n : '' + n)\r\n    const fileName =\r\n      'orders_' +\r\n      now.getFullYear() +\r\n      pad(now.getMonth() + 1) +\r\n      pad(now.getDate()) +\r\n      pad(now.getHours()) +\r\n      pad(now.getMinutes()) +\r\n      pad(now.getSeconds()) +\r\n      '.csv'\r\n    a.href = urlObject\r\n    a.download = fileName\r\n    document.body.appendChild(a)\r\n    a.click()\r\n    a.remove()\r\n    window.URL.revokeObjectURL(urlObject)\r\n  })\r\n}\r\n\r\nconst showDetail = (row) => {\r\n  API.get('/api/order/orderNo/' + row.orderNo).then((res) => {\r\n    if (res.code === '200') {\r\n      detail.value = []\r\n      detail.value.push(res.data)\r\n      dialogFormVisible.value = true\r\n    }\r\n  })\r\n}\r\n\r\n//发货\r\nconst delivery = (order) => {\r\n  API.post('/api/order/delivery/' + order.orderNo).then((res) => {\r\n    if (res.code === '200') {\r\n      ElMessage.success('成功发货')\r\n      order.state = '已发货'\r\n    }\r\n  })\r\n}\r\n\r\nonMounted(() => {\r\n  load()\r\n})\r\n</script>\r\n\r\n<style scoped>\r\n</style>\r\n"]},"metadata":{},"sourceType":"module"}