{"ast":null,"code":"import \"core-js/modules/es.json.stringify.js\";\nimport \"core-js/modules/es.array.slice.js\";\nimport { ref, onMounted } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { ElMessage } from 'element-plus';\nimport { useStore } from 'vuex';\nimport API from '@/utils/request';\nvar url = '/api/good/';\nexport default {\n  __name: 'Goods',\n  setup: function setup(__props, _ref) {\n    var __expose = _ref.expose;\n\n    __expose();\n\n    var store = useStore();\n    var router = useRouter();\n    var baseApi = store.state.baseApi;\n    var fileList = ref([]);\n    var options = ref([]);\n    var searchText = ref('');\n    var user = ref({});\n    var tableData = ref([]);\n    var pageNum = ref(1);\n    var pageSize = ref(5);\n    var entity = ref({});\n    var total = ref(0);\n    var dialogFormVisible = ref(false);\n\n    var handleSizeChange = function handleSizeChange(pageSizeVal) {\n      pageSize.value = pageSizeVal;\n      load();\n    };\n\n    var handleCurrentChange = function handleCurrentChange(pageNumVal) {\n      pageNum.value = pageNumVal;\n      load();\n    };\n\n    var handleRecommend = function handleRecommend(good) {\n      API.get(url + 'recommend', {\n        params: {\n          id: good.id,\n          isRecommend: good.recommend\n        }\n      }).then(function (res) {\n        if (res.code === '200') {\n          ElMessage.success('修改成功');\n        } else {\n          ElMessage.error(res.msg);\n        }\n      });\n    };\n\n    var handleStatus = function handleStatus(good) {\n      API.put(url, {\n        id: good.id,\n        status: good.status\n      }).then(function (res) {\n        if (res.code === '200') {\n          ElMessage.success('修改成功');\n          load();\n        } else {\n          ElMessage.error(res.msg);\n        }\n      });\n    };\n\n    var load = function load() {\n      API.get(url + 'fullPage', {\n        params: {\n          pageNum: pageNum.value,\n          pageSize: pageSize.value,\n          searchText: searchText.value\n        }\n      }).then(function (res) {\n        tableData.value = res.data.records;\n        total.value = res.data.total;\n      });\n    };\n\n    var reset = function reset() {\n      searchText.value = '';\n      load();\n    };\n\n    var add = function add() {\n      router.push('goodInfo');\n    };\n\n    var edit = function edit(obj) {\n      entity.value = JSON.parse(JSON.stringify(obj));\n      router.push({\n        name: 'goodInfo',\n        query: {\n          good: JSON.stringify(entity.value)\n        }\n      });\n    };\n\n    var handleImgSuccess = function handleImgSuccess(res) {\n      entity.value.imgs = res.data;\n      API.post(url, entity.value).then(function (res2) {\n        if (res2.code === '200') {\n          ElMessage({\n            type: 'success',\n            message: '操作成功'\n          });\n        } else {\n          ElMessage({\n            type: 'error',\n            message: res2.msg\n          });\n        }\n\n        load();\n        dialogFormVisible.value = false;\n      });\n    };\n\n    var save = function save() {\n      if (fileList.value.length !== 0) {// 注意：这里需要通过refs访问upload组件\n        // 在Composition API中需要使用ref来获取组件实例\n      } else {\n        API.post(url, entity.value).then(function (res2) {\n          if (res2.code === '200') {\n            ElMessage({\n              type: 'success',\n              message: '操作成功'\n            });\n          } else {\n            ElMessage({\n              type: 'error',\n              message: res2.msg\n            });\n          }\n\n          load();\n          dialogFormVisible.value = false;\n        });\n      }\n    };\n\n    var del = function del(id) {\n      API.delete(url + id).then(function (res) {\n        ElMessage({\n          type: 'success',\n          message: '操作成功'\n        });\n        load();\n      });\n    };\n\n    var handleChange = function handleChange(file, fileListVal) {\n      fileList.value = fileListVal.slice(-3);\n    };\n\n    onMounted(function () {\n      user.value = localStorage.getItem('user') ? JSON.parse(localStorage.getItem('user')) : {};\n      load();\n    });\n    var __returned__ = {\n      store: store,\n      router: router,\n      baseApi: baseApi,\n      fileList: fileList,\n      options: options,\n      searchText: searchText,\n      user: user,\n      tableData: tableData,\n      pageNum: pageNum,\n      pageSize: pageSize,\n      entity: entity,\n      total: total,\n      dialogFormVisible: dialogFormVisible,\n      url: url,\n      handleSizeChange: handleSizeChange,\n      handleCurrentChange: handleCurrentChange,\n      handleRecommend: handleRecommend,\n      handleStatus: handleStatus,\n      load: load,\n      reset: reset,\n      add: add,\n      edit: edit,\n      handleImgSuccess: handleImgSuccess,\n      save: save,\n      del: del,\n      handleChange: handleChange,\n      ref: ref,\n      onMounted: onMounted,\n\n      get useRouter() {\n        return useRouter;\n      },\n\n      get ElMessage() {\n        return ElMessage;\n      },\n\n      get useStore() {\n        return useStore;\n      },\n\n      get API() {\n        return API;\n      }\n\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"mappings":";;AAoJA,SAASA,GAAT,EAAcC,SAAd,QAA+B,KAA/B;AACA,SAASC,SAAT,QAA0B,YAA1B;AACA,SAASC,SAAT,QAA0B,cAA1B;AACA,SAASC,QAAT,QAAyB,MAAzB;AACA,OAAOC,GAAP,MAAgB,iBAAhB;AAiBA,IAAMC,GAAG,GAAG,YAAZ;;;;;;;;AAfA,QAAMC,KAAK,GAAGH,QAAQ,EAAtB;AACA,QAAMI,MAAM,GAAGN,SAAS,EAAxB;AAEA,QAAMO,OAAO,GAAGF,KAAK,CAACG,KAAN,CAAYD,OAA5B;AACA,QAAME,QAAQ,GAAGX,GAAG,CAAC,EAAD,CAApB;AACA,QAAMY,OAAO,GAAGZ,GAAG,CAAC,EAAD,CAAnB;AACA,QAAMa,UAAU,GAAGb,GAAG,CAAC,EAAD,CAAtB;AACA,QAAMc,IAAI,GAAGd,GAAG,CAAC,EAAD,CAAhB;AACA,QAAMe,SAAS,GAAGf,GAAG,CAAC,EAAD,CAArB;AACA,QAAMgB,OAAO,GAAGhB,GAAG,CAAC,CAAD,CAAnB;AACA,QAAMiB,QAAQ,GAAGjB,GAAG,CAAC,CA